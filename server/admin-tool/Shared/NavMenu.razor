@inject NavigationManager Navigation
@implements IDisposable

<nav class="main-nav" aria-label="주 메뉴">
    <div class="main-nav-desktop">
        @foreach (var item in NavItems)
        {
            if (item.Children is { Length: > 0 })
            {
                <div class="nav-group @(IsGroupActive(item) ? "active" : null)">
                    <button type="button"
                            class="nav-group-toggle @(IsGroupActive(item) ? "active" : null)"
                            aria-expanded="true">
                        @item.Label
                        <span class="material-symbols-outlined nav-group-caret">expand_more</span>
                    </button>
                    <div class="nav-group-menu">
                        @foreach (var child in item.Children)
                        {
                            <NavLink class="nav-link nav-group-link" href="@child.Href" Match="@child.Match">@child.Label</NavLink>
                        }
                    </div>
                </div>
            }
            else
            {
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match">@item.Label</NavLink>
            }
        }
    </div>
    <div class="main-nav-mobile">
        <label class="nav-select-label visually-hidden" for="main-nav-select">메뉴</label>
        <select id="main-nav-select"
                class="stitch-select nav-select"
                value="@CurrentSegment"
                @onchange="OnMobileNavChange">
            @foreach (var item in FlatNavOptions)
            {
                <option value="@item.Href">@item.Label</option>
            }
        </select>
    </div>
</nav>

@code {
    private sealed record NavChild(string Href, string Label, NavLinkMatch Match = NavLinkMatch.Prefix);

    private sealed record NavItem(
        string Href,
        string Label,
        NavLinkMatch Match = NavLinkMatch.Prefix,
        NavChild[] Children = null);

    private static readonly NavItem[] NavItems =
    {
        new("", "홈", NavLinkMatch.All),
        new("users", "유저"),
        new("servers", "서버"),
        new("items", "아이템"),
        new("marketplace", "거래소"),
        new("systemmail", "메일"),
        new("bulletin", "게시판"),
        new("broadcast", "방송"),
        new("patch", "패치", Children: new NavChild[]
        {
            new("table-patch", "테이블 패치"),
            new("script-patch", "스크립트 패치")
        }),
        new("cache", "캐시"),
        new("maintenance", "점검")
    };

    private static readonly NavChild[] FlatNavOptions = NavItems
        .SelectMany(item =>
            item.Children is { Length: > 0 }
                ? item.Children.Select(child => new NavChild(child.Href, $"{item.Label} / {child.Label}", child.Match))
                : new[] { new NavChild(item.Href, item.Label, item.Match) })
        .ToArray();

    private string CurrentSegment
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            return relative.Split('?', '/')[0];
        }
    }

    private bool IsGroupActive(NavItem item)
    {
        if (item.Children == null)
            return false;
        var segment = CurrentSegment;
        return item.Children.Any(child =>
            string.Equals(child.Href, segment, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMobileNavChange(ChangeEventArgs e)
    {
        var href = e.Value?.ToString() ?? string.Empty;
        Navigation.NavigateTo(string.IsNullOrEmpty(href) ? "/" : href);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
