@using AdminTool.Services
@using Http.Model

<div class="user-detail-mail">
    <div class="card-bg filter-toolbar user-detail-mail-filters">
        <div class="filter-toolbar-left">
            <button type="button" class="stitch-btn @(Filter == "all" ? "stitch-btn-primary" : "stitch-btn-neutral")"
                    @onclick='() => ChangeFilter("all")'>전체</button>
            <button type="button" class="stitch-btn @(Filter == "unread" ? "stitch-btn-primary" : "stitch-btn-neutral")"
                    @onclick='() => ChangeFilter("unread")'>미읽음</button>
            <button type="button" class="stitch-btn @(Filter == "system" ? "stitch-btn-primary" : "stitch-btn-neutral")"
                    @onclick='() => ChangeFilter("system")'>시스템</button>
        </div>
        <div class="filter-toolbar-right">
            @if (UnreadCount > 0)
            {
                <span class="stitch-badge active">미읽음 @UnreadCount</span>
            }
        </div>
    </div>

    <div class="card-bg stitch-form-card">
        <div class="stitch-form-card-header">
            <h2 class="dash-card-title">수신 메일</h2>
            <span class="stitch-badge">@TotalCount</span>
        </div>
        <div class="user-detail-card-content">
            @if (Mails.Any())
            {
                <div class="dash-table-wrap">
                    <table class="dash-table user-detail-mail-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>제목</th>
                                <th>발신자</th>
                                <th>수신일</th>
                                <th class="text-end">시스템메일</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mail in Mails)
                            {
                                var isExpanded = expandedMailId == mail.Id;
                                <tr class="@(mail.Read ? "" : "user-detail-mail-unread") @(isExpanded ? "expanded" : "")"
                                    @onclick="() => ToggleMail(mail.Id)">
                                    <td class="user-detail-mail-toggle">
                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            @(isExpanded ? "expand_less" : "expand_more")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!mail.Read)
                                        {
                                            <span class="user-detail-mail-dot" title="미읽음"></span>
                                        }
                                        @mail.Title
                                    </td>
                                    <td class="table-meta">
                                        @if (mail.Sender == 0)
                                        {
                                            @:시스템
                                        }
                                        else if (SenderNames.TryGetValue(mail.Sender, out var senderName))
                                        {
                                            <UserDetailLink UserId="mail.Sender" Name="@($"{senderName} (UID {mail.Sender})")" />
                                        }
                                        else
                                        {
                                            <UserDetailLink UserId="mail.Sender" Name="@($"UID {mail.Sender}")" />
                                        }
                                    </td>
                                    <td class="table-meta">@UserDetailDisplay.FormatDateTime(mail.CreatedDate)</td>
                                    <td class="table-meta text-end">@(mail.SystemMailId.HasValue ? mail.SystemMailId.Value.ToString() : "-")</td>
                                </tr>
                                @if (isExpanded)
                                {
                                    <tr class="user-detail-mail-preview-row">
                                        <td colspan="5">
                                            <div class="user-detail-mail-preview">@(mail.Contents ?? string.Empty)</div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">메일이 없습니다.</p>
            }
        </div>
    </div>

    @if (TotalPages > 1)
    {
        <div class="page-footer-bar">
            <div>
                @((Page - 1) * PageSize + 1) ~ @(Math.Min(Page * PageSize, TotalCount)) / @(TotalCount)건
            </div>
            <nav>
                <ul class="stitch-pagination">
                    <li>
                        <a class="stitch-page-btn @(Page <= 1 ? "disabled" : "")" href="#"
                           @onclick="() => ChangePage(Page - 1)" @onclick:preventDefault>
                            <span class="material-symbols-outlined" style="font-size:1.125rem;">chevron_left</span>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, Page - 2); i <= Math.Min(TotalPages, Page + 2); i++)
                    {
                        var pageNum = i;
                        <li>
                            <a class="stitch-page-btn @(Page == pageNum ? "active" : "")" href="#"
                               @onclick="() => ChangePage(pageNum)" @onclick:preventDefault>@pageNum</a>
                        </li>
                    }
                    <li>
                        <a class="stitch-page-btn @(Page >= TotalPages ? "disabled" : "")" href="#"
                           @onclick="() => ChangePage(Page + 1)" @onclick:preventDefault>
                            <span class="material-symbols-outlined" style="font-size:1.125rem;">chevron_right</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public UserDetailMailData Data { get; set; } = new();

    [Parameter, EditorRequired]
    public EventCallback<string> OnFilterChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<int> OnPageChanged { get; set; }

    private uint? expandedMailId;

    private List<Mail> Mails => Data.Mails;

    private Dictionary<uint, string> SenderNames => Data.SenderNames;

    private string Filter => Data.Filter;

    private int UnreadCount => Data.UnreadCount;

    private int TotalCount => Data.TotalCount;

    private int Page => Data.Page;

    private int PageSize => Data.PageSize;

    private int TotalPages => Data.TotalPages;

    private async Task ChangeFilter(string value)
    {
        if (Filter == value)
            return;

        expandedMailId = null;
        await OnFilterChanged.InvokeAsync(value);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages || page == Page)
            return;

        expandedMailId = null;
        await OnPageChanged.InvokeAsync(page);
    }

    private void ToggleMail(uint mailId)
    {
        expandedMailId = expandedMailId == mailId ? null : mailId;
    }
}
