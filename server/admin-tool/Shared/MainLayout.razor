@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@using AdminTool.Authentication
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Admin Tool</PageTitle>

<div class="app-container">
    <header class="app-header">
        <div class="header-top">
            <div class="header-top-container">
                <a class="logo" href="/">ADMIN TOOL</a>
                <div class="header-center">
                    <div class="header-search">
                        <span class="oi oi-magnifying-glass"></span>
                        <input type="text" class="search-input" placeholder="Search users..." 
                               @bind="globalSearchTerm" @bind:event="oninput" 
                               @onkeypress="HandleSearchKeyPress" />
                    </div>
                </div>
                <div class="header-actions">
                    <div class="section-selector">
                        <label for="section-select" class="section-label">Server:</label>
                        <select id="section-select" class="form-select form-select-sm section-select" 
                                @bind="selectedSection" @bind:after="OnSectionChanged">
                            @if (sections != null && sections.Any())
                            {
                                @foreach (var sectionName in sections)
                                {
                                    var serverName = GetServerName(sectionName);
                                    <option value="@sectionName">@serverName</option>
                                }
                            }
                        </select>
                    </div>
                    @if (isAuthenticated)
                    {
                        <button class="btn btn-outline-secondary" @onclick="HandleLogout">Logout</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="NavigateToLogin">Login</button>
                    }
                    <a href="https://github.com/boyism80/fb" target="_blank" rel="noopener noreferrer" class="header-link">Contact</a>
                </div>
            </div>
        </div>
        <div class="header-info">
            <div class="header-info-container">
                <div class="info-text">
                    <p>fb is a 2D MMORPG game server written in C++20. High-performance, microservices architecture with Lua scripting support.</p>
                    <p>Created by <a href="https://github.com/boyism80" target="_blank" rel="noopener noreferrer" class="info-link">boyism80</a>. <a href="https://github.com/boyism80/fb" target="_blank" rel="noopener noreferrer" class="info-link">View on GitHub</a></p>
                </div>
            </div>
        </div>
        <div class="header-nav">
            <div class="header-nav-container">
                <NavMenu />
            </div>
        </div>
    </header>

    <main class="app-main">
        <CascadingValue Value="selectedSection" Name="SelectedSection">
            <div class="content-wrapper">
                @Body
            </div>
        </CascadingValue>
    </main>
</div>

@code {
    private bool isAuthenticated = false;
    private string globalSearchTerm = string.Empty;
    private List<string>? sections;
    private string selectedSection = string.Empty;
    private Dictionary<string, string>? sectionToServerName;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationState();
        LoadSections();
        LoadSectionFromQuery();
    }

    private void LoadSections()
    {
        try
        {
            var rabbitMqSection = Configuration.GetSection("RabbitMQ");
            sections = rabbitMqSection.GetChildren()
                .Select(child => child.Key)
                .ToList();
            
            // Load section to server name mapping
            var sectionServersSection = Configuration.GetSection("SectionServers");
            sectionToServerName = sectionServersSection.GetChildren()
                .ToDictionary(child => child.Key, child => child.Value ?? child.Key);
        }
        catch (Exception ex)
        {
            // Log error but don't break the layout
            System.Diagnostics.Debug.WriteLine($"Error loading sections: {ex.Message}");
        }
    }

    private string GetServerName(string section)
    {
        if (sectionToServerName != null && sectionToServerName.TryGetValue(section, out var serverName))
        {
            return serverName;
        }
        return section;
    }

    private void LoadSectionFromQuery()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);
            
            if (queryParams.TryGetValue("section", out var sectionValue) && !string.IsNullOrEmpty(sectionValue))
            {
                if (sections != null && sections.Contains(sectionValue!))
                {
                    selectedSection = sectionValue!;
                    return;
                }
            }
            
            // If no valid section in query or sections not loaded yet, use first section as default
            if (sections != null && sections.Any() && string.IsNullOrEmpty(selectedSection))
            {
                selectedSection = sections.First();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading section from query: {ex.Message}");
        }
    }

    private void OnSectionChanged()
    {
        UpdateUrlWithSection();
        StateHasChanged();
    }

    private void UpdateUrlWithSection()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);
            
            queryParams["section"] = selectedSection;
            
            var queryDict = queryParams.ToDictionary(
                kvp => kvp.Key, 
                kvp => (string?)(kvp.Value.ToString() ?? string.Empty));
            var newQueryString = QueryHelpers.AddQueryString(
                uri.GetLeftPart(UriPartial.Path),
                queryDict);
            
            Navigation.NavigateTo(newQueryString, false);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error updating URL with section: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
            Navigation.LocationChanged += OnLocationChanged;
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await CheckAuthenticationState();
        StateHasChanged();
    }

    private async Task CheckAuthenticationState()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
    }

    private Task HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(globalSearchTerm))
        {
            Navigation.NavigateTo($"/users?search={Uri.EscapeDataString(globalSearchTerm)}");
        }
        return Task.CompletedTask;
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task HandleLogout()
    {
        if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
        {
            await customProvider.MarkUserAsLoggedOut();
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        LoadSectionFromQuery();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (AuthenticationStateProvider != null)
        {
            AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
