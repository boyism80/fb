@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@using AdminTool.Authentication
@using AdminTool.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject UserService UserService
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>FB ADMIN</PageTitle>

<div class="app-container">
    <header class="app-header">
        <div class="page-wrap">
            <div class="header-top">
                <a class="logo" href="/">FB ADMIN</a>
                <div class="header-search input-bg">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input type="text" class="search-input" placeholder="유저 검색..." @bind="globalSearchTerm"
                           @bind:event="oninput" @onkeypress="HandleSearchKeyPress" />
                </div>
                <div class="header-actions">
                    <ThemeSelector />
                    <WorldSelector Worlds="worlds"
                                   WorldNames="worldToServerName"
                                   SelectedWorld="selectedWorld"
                                   SelectedWorldChanged="HandleWorldSelectedAsync" />
                    @if (isAuthenticated)
                    {
                        <button class="btn-logout" @onclick="HandleLogout">로그아웃</button>
                    }
                    else
                    {
                        <button class="btn btn-neutral btn-sm" @onclick="NavigateToLogin">Login</button>
                    }
                </div>
            </div>
            <div class="header-nav">
                <NavMenu />
            </div>
        </div>
    </header>

    <main class="app-main">
        <CascadingValue Value="selectedWorld" Name="SelectedWorld">
            <div class="page-wrap content-wrapper">
                @Body
            </div>
        </CascadingValue>
    </main>
</div>

@code {
    private bool isAuthenticated = false;
    private string globalSearchTerm = string.Empty;
    private List<uint>? worlds;
    private uint? selectedWorld;
    private Dictionary<uint, string>? worldToServerName;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationState();
        LoadWorlds();
        LoadWorldFromQuery();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
            Navigation.LocationChanged += OnLocationChanged;
            await ThemeService.InitializeAsync(JS);
        }
    }

    private void LoadWorlds()
    {
        try
        {
            var worldServersSection = Configuration.GetSection("WorldServers");
            worlds = worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .Select(child => uint.Parse(child.Key))
                .ToList();

            worldToServerName = worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .ToDictionary(
                    child => uint.Parse(child.Key),
                    child => child.Value ?? child.Key);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading worlds: {ex.Message}");
        }
    }

    private string GetServerName(uint world)
    {
        if (worldToServerName != null && worldToServerName.TryGetValue(world, out var serverName))
        {
            return serverName;
        }
        return world.ToString();
    }

    private void LoadWorldFromQuery()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);

            if (queryParams.TryGetValue("world", out var worldValue) && !string.IsNullOrEmpty(worldValue))
            {
                if (uint.TryParse(worldValue, out var worldId) && worlds != null && worlds.Contains(worldId))
                {
                    selectedWorld = worldId;
                    return;
                }
            }

            if (worlds != null && worlds.Any() && !selectedWorld.HasValue)
            {
                selectedWorld = worlds.First();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading world from query: {ex.Message}");
        }
    }

    private Task HandleWorldSelectedAsync(uint? world)
    {
        selectedWorld = world;
        UpdateUrlWithWorld();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void UpdateUrlWithWorld()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);

            if (selectedWorld.HasValue)
            {
                queryParams["world"] = selectedWorld.Value.ToString();
            }

            var queryDict = queryParams.ToDictionary(
                kvp => kvp.Key,
                kvp => (string?)(kvp.Value.ToString() ?? string.Empty));
            var newQueryString = QueryHelpers.AddQueryString(
                uri.GetLeftPart(UriPartial.Path),
                queryDict);

            Navigation.NavigateTo(newQueryString, false);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error updating URL with world: {ex.Message}");
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await CheckAuthenticationState();
        StateHasChanged();
    }

    private async Task CheckAuthenticationState()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
    }

    private async Task HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(globalSearchTerm))
            await UserSearchNavigation.NavigateFromSearchAsync(Navigation, UserService, selectedWorld, globalSearchTerm);
    }

    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task HandleLogout()
    {
        if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
        {
            await customProvider.MarkUserAsLoggedOut();
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        LoadWorldFromQuery();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (AuthenticationStateProvider != null)
        {
            AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
