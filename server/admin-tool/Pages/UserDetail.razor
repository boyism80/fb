@page "/users/{UserId:int}"
@page "/users/{UserId:int}/{Tab}"
@using AdminTool.Services
@using AdminTool.Authentication
@using Fb.Model.EnumValue
@using Http.Model
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Response = fb.protocol._internal.response
@inject UserDetailService UserDetailService
@inject UserService UserService
@inject BanService BanService
@inject DbContext DbContext
@inject RabbitMqService RabbitMqService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SecurityService SecurityService
@inject LogService LogService
@inject NavigationManager Navigation
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>유저 상세 - FB ADMIN</PageTitle>

<HeadContent>
    <link href="css/user-detail.css" rel="stylesheet" asp-append-version="true" />
</HeadContent>

<UserDetailShell UserId="UserId"
                 Core="core"
                 ActiveTab="@activeTab"
                 IsLoading="isLoading"
                 ErrorMessage="@errorMessage"
                 SuccessMessage="@successMessage"
                 IsBanProcessing="isBanProcessing"
                 IsRoleProcessing="isRoleProcessing"
                 ChangeRoleButtonTitle="@changeRoleButtonTitle"
                 OnDismissError="DismissError"
                 OnDismissSuccess="DismissSuccess"
                 OnBan="ShowBanModal"
                 OnUnban="ShowUnbanModal"
                 OnChangeRole="ShowChangeRoleModal">
    @if (core != null && !isLoading)
    {
        @switch (activeTab)
        {
            case "overview":
                <UserDetailOverview Character="core.Character"
                                    UserDetail="core.UserDetail"
                                    IsOnline="core.IsOnline"
                                    InventoryCount="itemCounts.Inventory"
                                    StorageCount="itemCounts.Storage"
                                    StorageVaultCount="itemCounts.StorageVaults" />
                break;
            case "character":
                <UserDetailCharacter Character="core.Character" />
                break;
            case "items":
                @if (items != null)
                {
                    <UserDetailItemsTab Items="items" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            case "progress":
                @if (progress != null)
                {
                    <UserDetailProgress Progress="progress" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            case "social":
                @if (social != null)
                {
                    <UserDetailSocial Social="social" SpouseName="@spouseName" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            case "mail":
                @if (mailData != null)
                {
                    <UserDetailMail Data="mailData"
                                    OnFilterChanged="OnMailFilterChanged"
                                    OnPageChanged="OnMailPageChanged" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            case "matchmaking":
                @if (matchmaking != null)
                {
                    <UserDetailMatchmaking Data="matchmaking" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            case "settings":
                @if (optionsLoaded)
                {
                    <UserDetailSettings Character="core.Character"
                                        UserDetail="core.UserDetail"
                                        Option="options" />
                }
                else if (tabLoading)
                {
                    <TabLoading />
                }
                break;
            default:
                <div class="alert alert-warning">알 수 없는 탭입니다.</div>
                break;
        }
    }
</UserDetailShell>

@if (showBanModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">유저 밴: @core?.Character.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseBanModal"></button>
            </div>
            <div class="stitch-modal-body">
                <EditForm Model="@banModel" OnValidSubmit="@HandleBan">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="detailBanReason" class="form-label">사유</label>
                        <InputTextArea id="detailBanReason" class="form-control" rows="3" @bind-Value="banModel.Reason" />
                        <ValidationMessage For="@(() => banModel.Reason)" />
                    </div>
                    <div class="mb-3">
                        <label for="detailBanDays" class="form-label">밴 기간</label>
                        <InputSelect id="detailBanDays" class="form-select" @bind-Value="banModel.Days">
                            <option value="">영구</option>
                            <option value="7">7일</option>
                            <option value="15">15일</option>
                            <option value="30">30일</option>
                        </InputSelect>
                    </div>
                    <div class="stitch-modal-footer">
                        <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseBanModal">취소</button>
                        <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isBanProcessing">
                            @if (isBanProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            밴 처리
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showUnbanModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">밴 해제: @core?.Character.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseUnbanModal"></button>
            </div>
            <div class="stitch-modal-body">
                <p>이 유저의 밴을 해제하시겠습니까?</p>
                @if (core != null && !string.IsNullOrEmpty(core.UserDetail.BanReason))
                {
                    <p><strong>현재 밴 사유:</strong> @core.UserDetail.BanReason</p>
                }
                <div class="stitch-modal-footer">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseUnbanModal">취소</button>
                    <button type="button" class="stitch-btn stitch-btn-primary" @onclick="HandleUnban" disabled="@isBanProcessing">
                        @if (isBanProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        밴 해제
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showChangeRoleModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">역할 변경: @core?.Character.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseChangeRoleModal"></button>
            </div>
            <div class="stitch-modal-body">
                <EditForm Model="@roleModel" OnValidSubmit="@HandleChangeRole">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="detailCurrentRole" class="form-label">현재 역할</label>
                        <input type="text" class="form-control" id="detailCurrentRole"
                               value="@UserDetailDisplay.FormatRole(core?.Character.Role ?? Role.User)" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="detailNewRole" class="form-label">새 역할</label>
                        <InputSelect id="detailNewRole" class="form-select" @bind-Value="roleModel.NewRoleString">
                            @foreach (var role in GetAvailableRoles())
                            {
                                <option value="@((int)role)">@UserDetailDisplay.FormatRole(role)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => roleModel.NewRoleString)" />
                    </div>
                    @if (ShouldPromptForElevationSecret())
                    {
                        <div class="mb-3">
                            <label for="detailElevationSecret" class="form-label">승격 비밀키</label>
                            <InputText id="detailElevationSecret" type="password" class="form-control"
                                       @bind-Value="roleModel.SecretKey" />
                            <small class="text-muted">@GetElevationSecretMessage()</small>
                        </div>
                    }
                    <div class="stitch-modal-footer">
                        <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseChangeRoleModal">취소</button>
                        <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isRoleProcessing">
                            @if (isRoleProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            역할 변경
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private static readonly HashSet<string> ValidTabs = new(StringComparer.OrdinalIgnoreCase)
    {
        "overview", "character", "items", "progress", "social", "mail", "matchmaking", "settings"
    };

    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public string Tab { get; set; }

    private UserDetailCore core;
    private UserDetailItemsData items;
    private UserDetailProgressData progress;
    private UserDetailSocialData social;
    private UserDetailMailData mailData;
    private UserDetailMatchmakingData matchmaking;
    private int mailPage = 1;
    private const int MailPageSize = 20;
    private string mailFilter = "all";
    private Http.Model.Option options;
    private bool optionsLoaded;
    private string spouseName;
    private (int Inventory, int Storage, int StorageVaults) itemCounts;
    private string activeTab = "overview";
    private bool isLoading;
    private bool tabLoading;
    private bool isBanProcessing;
    private bool isRoleProcessing;
    private bool showBanModal;
    private bool showUnbanModal;
    private bool showChangeRoleModal;
    private BanModel banModel = new();
    private RoleModel roleModel = new();
    private Role currentUserRole = Role.User;
    private uint currentUserId;
    private uint? loginWorld;
    private string changeRoleButtonTitle = "Change user role";
    private string errorMessage;
    private string successMessage;
    private string loadedTabKey;
    private int? loadedUserId;
    private uint? loadedPageWorld;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserRole();
    }

    protected override async Task OnParametersSetAsync()
    {
        activeTab = NormalizeTab(Tab);
        if (!ValidTabs.Contains(activeTab))
        {
            Navigation.NavigateTo($"/users/{UserId}/overview", replace: true);
            return;
        }

        if (string.IsNullOrEmpty(Tab) && activeTab == "overview")
        {
            // /users/{id} without tab segment is valid
        }

        if (loadedUserId != UserId || loadedPageWorld != selectedWorld)
        {
            ResetPageState();
            loadedUserId = UserId;
            loadedPageWorld = selectedWorld;
        }

        await LoadPageAsync();
    }

    private void ResetPageState()
    {
        core = null;
        items = null;
        progress = null;
        social = null;
        mailData = null;
        matchmaking = null;
        options = null;
        optionsLoaded = false;
        spouseName = null;
        loadedTabKey = null;
        itemCounts = default;
        mailPage = 1;
        mailFilter = "all";
        errorMessage = null;
        successMessage = null;
        showBanModal = false;
        showUnbanModal = false;
        showChangeRoleModal = false;
        banModel = new BanModel();
        roleModel = new RoleModel();
        changeRoleButtonTitle = "Change user role";
    }

    private async Task LoadPageAsync()
    {
        if (!selectedWorld.HasValue)
        {
            errorMessage = "월드가 선택되지 않았습니다.";
            return;
        }

        isLoading = core == null;
        errorMessage = null;

        try
        {
            if (core == null)
            {
                core = await UserDetailService.LoadCoreAsync(selectedWorld.Value, (uint)UserId);
                if (core == null)
                    return;

                changeRoleButtonTitle = GetChangeRoleButtonTitle();
                await LoadItemCountsAsync(selectedWorld.Value);
            }

            var tabKey = GetTabKey();
            if (loadedTabKey == tabKey)
                return;

            tabLoading = true;
            await LoadTabDataAsync(selectedWorld.Value, activeTab);
            loadedTabKey = tabKey;
        }
        catch (Exception ex)
        {
            errorMessage = $"데이터를 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            tabLoading = false;
        }
    }

    private async Task LoadItemCountsAsync(uint world)
    {
        var itemData = await UserDetailService.LoadItemsAsync(world, (uint)UserId);
        itemCounts = (
            itemData.Inventory.Count,
            itemData.Storage.Count,
            itemData.Storage.Select(i => i.Stored).Distinct().Count());

        if (activeTab == "items")
            items = itemData;
    }

    private async Task LoadTabDataAsync(uint world, string tab)
    {
        switch (tab)
        {
            case "overview":
                if (items == null)
                    await LoadItemCountsAsync(world);
                break;
            case "items":
                items = await UserDetailService.LoadItemsAsync(world, (uint)UserId);
                itemCounts = (
                    items.Inventory.Count,
                    items.Storage.Count,
                    items.Storage.Select(i => i.Stored).Distinct().Count());
                break;
            case "progress":
                progress = await UserDetailService.LoadProgressAsync(world, (uint)UserId);
                break;
            case "social":
                social = await UserDetailService.LoadSocialAsync(world, (uint)UserId, core?.RealtimeState);
                if (social.Marriage?.SpouseId is uint spouseId)
                    spouseName = await UserDetailService.ResolveCharacterNameAsync(world, spouseId);
                break;
            case "mail":
                mailData = await UserDetailService.LoadMailPageAsync(
                    world,
                    (uint)UserId,
                    mailPage,
                    MailPageSize,
                    mailFilter);
                break;
            case "matchmaking":
                matchmaking = await UserDetailService.LoadMatchmakingAsync(world, (uint)UserId);
                break;
            case "settings":
                options = await UserDetailService.LoadOptionsAsync(world, (uint)UserId);
                optionsLoaded = true;
                break;
        }
    }

    private string GetTabKey()
    {
        if (activeTab == "mail")
            return $"{selectedWorld}:{UserId}:{activeTab}:{mailFilter}:{mailPage}";

        return $"{selectedWorld}:{UserId}:{activeTab}";
    }

    private async Task OnMailFilterChanged(string filter)
    {
        mailFilter = filter;
        mailPage = 1;
        await ReloadMailTabAsync();
    }

    private async Task OnMailPageChanged(int page)
    {
        mailPage = page;
        await ReloadMailTabAsync();
    }

    private async Task ReloadMailTabAsync()
    {
        if (!selectedWorld.HasValue || activeTab != "mail")
            return;

        tabLoading = true;
        errorMessage = null;

        try
        {
            mailData = await UserDetailService.LoadMailPageAsync(
                selectedWorld.Value,
                (uint)UserId,
                mailPage,
                MailPageSize,
                mailFilter);
            loadedTabKey = GetTabKey();
        }
        catch (Exception ex)
        {
            errorMessage = $"메일을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            tabLoading = false;
        }
    }

    private static string NormalizeTab(string tab)
    {
        if (string.IsNullOrWhiteSpace(tab))
            return "overview";

        return tab.Trim().ToLowerInvariant();
    }

    private void DismissError()
    {
        errorMessage = null;
    }

    private void DismissSuccess()
    {
        successMessage = null;
    }

    private void ShowBanModal()
    {
        banModel = new BanModel();
        showBanModal = true;
    }

    private void CloseBanModal()
    {
        showBanModal = false;
        banModel = new BanModel();
    }

    private void ShowUnbanModal()
    {
        showUnbanModal = true;
    }

    private void CloseUnbanModal()
    {
        showUnbanModal = false;
    }

    private void ShowChangeRoleModal()
    {
        if (core == null)
            return;

        roleModel = new RoleModel
        {
            NewRoleString = ((int)core.Character.Role).ToString(),
            SecretKey = string.Empty
        };
        showChangeRoleModal = true;
    }

    private void CloseChangeRoleModal()
    {
        showChangeRoleModal = false;
        roleModel = new RoleModel();
    }

    private async Task LoadCurrentUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return;

        var roleClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role);
        var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        var loginWorldClaim = authState.User.FindFirst(CustomAuthenticationStateProvider.LoginWorldClaimType);
        if (idClaim != null && uint.TryParse(idClaim.Value, out var uid))
        {
            currentUserId = uid;
        }
        if (roleClaim != null && Enum.TryParse<Role>(roleClaim.Value, out var role))
        {
            currentUserRole = role;
        }
        if (loginWorldClaim != null && uint.TryParse(loginWorldClaim.Value, out var world))
        {
            loginWorld = world;
        }
    }

    private bool IsSelfUser()
    {
        return core != null
            && core.Character.Id == currentUserId
            && loginWorld.HasValue
            && selectedWorld.HasValue
            && selectedWorld.Value == loginWorld.Value;
    }

    private bool CanModifyUser()
    {
        if (core == null)
            return false;

        return core.Character.Role < currentUserRole;
    }

    private bool RequiresElevationForTarget()
    {
        if (IsSelfUser())
            return false;

        return !CanModifyUser();
    }

    private bool SelectedRoleExceedsCurrent()
    {
        if (!int.TryParse(roleModel?.NewRoleString, out var newRoleInt) || !Enum.IsDefined(typeof(Role), newRoleInt))
            return false;

        var newRole = (Role)newRoleInt;
        return newRole > currentUserRole;
    }

    private bool ShouldPromptForElevationSecret()
    {
        if (core == null)
            return false;

        return RequiresElevationForTarget() || SelectedRoleExceedsCurrent();
    }

    private string GetElevationSecretMessage()
    {
        if (core == null)
            return string.Empty;

        if (RequiresElevationForTarget())
            return "Target user has an equal or higher role. Provide the elevation secret to proceed.";

        if (SelectedRoleExceedsCurrent())
            return "Assigning a role higher than your own requires the elevation secret.";

        return "Provide the elevation secret to continue.";
    }

    private string GetChangeRoleButtonTitle()
    {
        if (IsSelfUser())
            return "Modify your own role. The elevation secret is required only for promotions.";

        return RequiresElevationForTarget()
            ? "Requires elevation secret to modify this user."
            : "Change user role";
    }

    private static List<Role> GetAvailableRoles()
    {
        return Enum.GetValues<Role>().ToList();
    }

    private async Task HandleChangeRole()
    {
        if (core == null)
            return;

        var targetRole = core.Character.Role;
        var isSelf = IsSelfUser();

        if (!selectedWorld.HasValue)
        {
            errorMessage = "World is not selected.";
            CloseChangeRoleModal();
            return;
        }
        if (await UserService.IsOnline(selectedWorld.Value, core.Character.Name))
        {
            errorMessage = "Cannot change role while the user is online. Please try again after they log out.";
            CloseChangeRoleModal();
            return;
        }

        if (!int.TryParse(roleModel.NewRoleString, out var newRoleInt) || !Enum.IsDefined(typeof(Role), newRoleInt))
        {
            errorMessage = "Invalid role selected.";
            CloseChangeRoleModal();
            return;
        }

        var newRole = (Role)newRoleInt;

        var hasStandardPrivilege = (targetRole < currentUserRole || isSelf) && newRole <= currentUserRole;
        if (!hasStandardPrivilege)
        {
            var providedSecret = roleModel.SecretKey?.Trim();
            if (string.IsNullOrWhiteSpace(providedSecret))
            {
                errorMessage = "Elevation secret is required for this operation.";
                return;
            }

            if (!SecurityService.IsValidElevationSecret(providedSecret))
            {
                errorMessage = "Elevation secret is invalid.";
                return;
            }
        }

        isRoleProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var character = await DbContext.Character.Get(selectedWorld.Value, core.Character.Id);
            if (character == null)
            {
                errorMessage = "Character not found.";
                CloseChangeRoleModal();
                return;
            }

            var oldRole = character.Role;
            character.Role = newRole;
            character.UpdatedDate = DateTime.Now;
            DbContext.Character.Set(selectedWorld.Value, character);
            await DbContext.SaveChangesAsync();

            await LogService.WriteAsync("role_change", new
            {
                target_account_name = character.Name,
                target_uid = character.Id,
                old_role = oldRole.ToString(),
                new_role = newRole.ToString(),
                changer_uid = currentUserId,
                is_self = isSelf
            });

            if (isSelf)
            {
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    var authData = new AuthData
                    {
                        UserId = currentUserId,
                        UserName = character.Name,
                        Role = newRole.ToString(),
                        LoginWorld = loginWorld
                    };
                    await customProvider.MarkUserAsAuthenticated(authData);
                }
                currentUserRole = newRole;
            }

            successMessage = $"User {core.Character.Name}'s role has been changed to {UserDetailDisplay.FormatRole(newRole)} successfully.";
            CloseChangeRoleModal();
            await ReloadCoreAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error changing role: {ex.Message}";
        }
        finally
        {
            isRoleProcessing = false;
        }
    }

    private async Task ReloadCoreAsync()
    {
        if (!selectedWorld.HasValue)
            return;

        ResetPageState();
        loadedUserId = UserId;
        loadedPageWorld = selectedWorld;
        await LoadPageAsync();
    }

    private async Task HandleBan()
    {
        if (core == null || !selectedWorld.HasValue)
            return;

        isBanProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            uint? days = null;
            if (!string.IsNullOrWhiteSpace(banModel.Days) && uint.TryParse(banModel.Days, out var parsedDays))
                days = parsedDays;

            var result = await BanService.Ban(selectedWorld.Value, core.Character.Name, banModel.Reason, days);
            await DbContext.SaveChangesAsync();

            var response = new Response.Ban
            {
                Name = core.Character.Name,
                Reason = banModel.Reason,
                ExpireDate = result.ExpireDate?.ToString("yyyy-MM-dd HH:mm:ss"),
                Error = (uint)result.Error
            };
            await RabbitMqService.PublishAsync(response, "amq.direct", $"fb.{selectedWorld.Value}.ban");

            successMessage = $"User {core.Character.Name} has been banned successfully.";
            CloseBanModal();
            await ReloadCoreAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error banning user: {ex.Message}";
        }
        finally
        {
            isBanProcessing = false;
        }
    }

    private async Task HandleUnban()
    {
        if (core == null || !selectedWorld.HasValue)
            return;

        isBanProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await BanService.Unban(selectedWorld.Value, core.Character.Name);
            await DbContext.SaveChangesAsync();

            var response = new Response.Unban
            {
                Name = core.Character.Name,
                Error = (uint)result.Error
            };
            await RabbitMqService.PublishAsync(response, "amq.direct", $"fb.{selectedWorld.Value}.unban");

            successMessage = $"User {core.Character.Name} has been unbanned successfully.";
            CloseUnbanModal();
            await ReloadCoreAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error unbanning user: {ex.Message}";
        }
        finally
        {
            isBanProcessing = false;
        }
    }

    private class BanModel
    {
        [Required(ErrorMessage = "Ban reason is required")]
        public string Reason { get; set; } = string.Empty;

        public string Days { get; set; }
    }

    private class RoleModel
    {
        [Required(ErrorMessage = "Role is required")]
        public string NewRoleString { get; set; } = "0";

        public string SecretKey { get; set; } = string.Empty;
    }
}
