@page "/bulletin"
@using AdminTool.Authentication
@using Http.Service
@using Http.Model
@using Fb.Model
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DbContext DbContext
@inject BulletinService BulletinService
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>게시판 관리 - FB Admin</PageTitle>

<div class="bulletin-page">
    <div class="page-header">
        <h1>게시판 관리</h1>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="stitch-error-banner">
            <div class="stitch-error-banner-content">
                <span class="material-symbols-outlined">error</span>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss" @onclick="() => errorMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="stitch-success-banner">
            <div class="stitch-success-banner-content">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="stitch-success-text">@successMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss stitch-success-dismiss" @onclick="() => successMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    @if (sections != null && sections.Any())
    {
        <div class="bulletin-section-tabs">
            @foreach (var sectionItem in sections)
            {
                <button type="button"
                        class="bulletin-section-tab @(selectedBulletinSection == sectionItem.Key ? "active" : null)"
                        @onclick="() => SelectSection(sectionItem.Key)">
                    @sectionItem.Value.Name
                </button>
            }
        </div>
    }

    @if (selectedBulletinSection.HasValue)
    {
        <div class="bulletin-toolbar">
            <div class="bulletin-toolbar-left">
                <select class="stitch-select" @bind="searchField">
                    <option value="all">전체</option>
                    <option value="title">제목</option>
                    <option value="contents">내용</option>
                    <option value="author">작성자</option>
                </select>
                <input type="text" class="stitch-input bulletin-search-input"
                       placeholder="검색어 입력"
                       @bind="searchQuery" @bind:event="oninput" @onkeypress="HandleSearchKeyPress" />
                <button class="stitch-btn stitch-btn-surface" type="button" @onclick="SearchArticles" disabled="@isLoading">
                    <span class="material-symbols-outlined">search</span>
                    검색
                </button>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button class="stitch-btn stitch-btn-neutral" type="button" @onclick="ClearSearch" disabled="@isLoading">
                        초기화
                    </button>
                }
            </div>
            <div class="bulletin-toolbar-right">
                <button class="stitch-btn stitch-btn-danger"
                        @onclick="ShowBulkDeleteModal"
                        disabled="@(isProcessing || !selectedArticleIds.Any())">
                    <span class="material-symbols-outlined">delete</span>
                    선택 삭제@(selectedArticleIds.Any() ? $" ({selectedArticleIds.Count})" : "")
                </button>
                <button class="stitch-btn stitch-btn-surface" @onclick="ShowWriteModal" disabled="@isProcessing">
                    <span class="material-symbols-outlined">edit_document</span>
                    글쓰기
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="bulletin-loading">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">불러오는 중...</span>
                </div>
            </div>
        }
        else if (articles != null && articles.Any())
        {
            <div class="stitch-table-card">
                <table class="stitch-data-table bulletin-table">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox" @onchange="ToggleSelectAll" checked="@IsAllSelected" />
                            </th>
                            <th class="col-id">#</th>
                            <th>제목</th>
                            <th class="col-author">작성자</th>
                            <th class="col-date">작성일</th>
                            <th class="col-actions">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in articles)
                        {
                            <tr>
                                <td class="col-check">
                                    <input type="checkbox" checked="@selectedArticleIds.Contains(article.Id)"
                                           @onchange="() => ToggleArticleSelection(article.Id)" />
                                </td>
                                <td class="col-id">@article.Id</td>
                                <td class="col-title">
                                    <button type="button" class="bulletin-title-link"
                                            @onclick="() => ShowViewModal(article)">
                                        @article.Title
                                    </button>
                                </td>
                                <td class="col-author">@article.UserName</td>
                                <td class="col-date">@article.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="col-actions">
                                    <button type="button" class="bulletin-action-link"
                                            @onclick="() => ShowEditModal(article)" disabled="@isProcessing">
                                        수정
                                    </button>
                                    <button type="button" class="bulletin-action-link"
                                            @onclick="() => ShowDeleteModal(article)" disabled="@isProcessing">
                                        삭제
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (currentPage > 1 || (articles != null && articles.Count == pageSize))
            {
                <div class="bulletin-pagination">
                    <nav>
                        <ul class="stitch-pagination bulletin-pagination-group">
                            <li>
                                <a class="stitch-page-btn @(currentPage <= 1 ? "disabled" : "")" href="#"
                                   @onclick="() => ChangePage(currentPage - 1)" @onclick:preventDefault>
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </a>
                            </li>
                            <li>
                                <span class="stitch-page-btn active">@currentPage</span>
                            </li>
                            <li>
                                <a class="stitch-page-btn @(articles == null || articles.Count < pageSize ? "disabled" : "")" href="#"
                                   @onclick="() => ChangePage(currentPage + 1)" @onclick:preventDefault>
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else if (!isLoading)
        {
            <div class="bulletin-empty">
                @(string.IsNullOrWhiteSpace(searchQuery) ? "이 섹션에 게시글이 없습니다." : "검색 결과가 없습니다.")
            </div>
        }
    }
    else
    {
        <div class="bulletin-empty">섹션을 선택하세요.</div>
    }
</div>

<!-- Write Article Modal -->
@if (showWriteModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal stitch-modal-lg" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">글쓰기 - @GetSectionName(selectedBulletinSection!.Value)</h2>
                <button type="button" class="stitch-modal-close" @onclick="CloseWriteModal" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="stitch-modal-body">
                <EditForm Model="@writeModel" OnValidSubmit="@HandleWrite">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="writeTitle" class="form-label">제목</label>
                        <InputText id="writeTitle" class="form-control" @bind-Value="writeModel.Title" />
                        <ValidationMessage For="@(() => writeModel.Title)" />
                    </div>
                    <div class="mb-3">
                        <label for="writeContents" class="form-label">내용</label>
                        <InputTextArea id="writeContents" class="form-control" rows="10"
                                       @bind-Value="writeModel.Contents" />
                        <ValidationMessage For="@(() => writeModel.Contents)" />
                    </div>
                    <div class="stitch-modal-footer">
                        <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseWriteModal">취소</button>
                        <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            등록
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Edit Article Modal -->
@if (showEditModal && selectedArticle != null)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal stitch-modal-lg" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">글 수정 - @selectedArticle.Title</h2>
                <button type="button" class="stitch-modal-close" @onclick="CloseEditModal" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="stitch-modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@HandleEdit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="editTitle" class="form-label">제목</label>
                        <InputText id="editTitle" class="form-control" @bind-Value="editModel.Title" />
                        <ValidationMessage For="@(() => editModel.Title)" />
                    </div>
                    <div class="mb-3">
                        <label for="editContents" class="form-label">내용</label>
                        <InputTextArea id="editContents" class="form-control" rows="10"
                                       @bind-Value="editModel.Contents" />
                        <ValidationMessage For="@(() => editModel.Contents)" />
                    </div>
                    <div class="stitch-modal-footer">
                        <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseEditModal">취소</button>
                        <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            수정
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- View Article Modal -->
@if (showViewModal && selectedArticle != null)
{
    <div class="stitch-modal-backdrop bulletin-detail-backdrop" tabindex="-1">
        <div class="bulletin-detail-modal" @onclick:stopPropagation="true">
            <header class="bulletin-detail-header">
                <div class="bulletin-detail-heading">
                    <span class="bulletin-detail-label">게시글</span>
                    <h2 class="bulletin-detail-title">@selectedArticle.Title</h2>
                </div>
                <button type="button" class="stitch-modal-close" @onclick="CloseViewModal" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </header>
            <div class="bulletin-detail-meta">
                <div class="bulletin-detail-meta-item bulletin-detail-meta-author">
                    <span class="material-symbols-outlined" aria-hidden="true">person</span>
                    <span>@selectedArticle.UserName</span>
                </div>
                <div class="bulletin-detail-meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                    <span class="bulletin-detail-mono">@selectedArticle.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                </div>
                <div class="bulletin-detail-meta-item">
                    <span class="material-symbols-outlined" aria-hidden="true">tag</span>
                    <span class="bulletin-detail-mono">#@selectedArticle.Id</span>
                </div>
            </div>
            <div class="bulletin-detail-divider"></div>
            <div class="bulletin-detail-body">
                <article class="bulletin-detail-content">
                    @((MarkupString)(selectedArticle.Contents?.Replace("\n", "<br />") ?? ""))
                </article>
            </div>
            <footer class="bulletin-detail-footer">
                <button type="button" class="bulletin-detail-delete-link" @onclick="OpenDeleteFromView" disabled="@isProcessing">삭제</button>
                <div class="bulletin-detail-footer-actions">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="OpenEditFromView" disabled="@isProcessing">수정</button>
                    <button type="button" class="stitch-btn stitch-btn-surface" @onclick="CloseViewModal">닫기</button>
                </div>
            </footer>
        </div>
    </div>
}

<!-- Delete Article Modal -->
@if (showDeleteModal && selectedArticle != null)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">글 삭제</h2>
                <button type="button" class="stitch-modal-close" @onclick="CloseDeleteModal" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="stitch-modal-body">
                <p>이 게시글을 삭제하시겠습니까?</p>
                <div class="card-bg" style="padding:0.75rem 1rem;">
                    <strong>제목:</strong> @selectedArticle.Title<br />
                    <strong>작성자:</strong> @selectedArticle.UserName<br />
                    <strong>ID:</strong> @selectedArticle.Id
                </div>
                <div class="stitch-modal-footer">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseDeleteModal">취소</button>
                    <button type="button" class="stitch-btn stitch-btn-primary" @onclick="HandleDelete" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        삭제
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bulk Delete Modal -->
@if (showBulkDeleteModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">선택 삭제</h2>
                <button type="button" class="stitch-modal-close" @onclick="CloseBulkDeleteModal" aria-label="닫기">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="stitch-modal-body">
                <p>선택한 @(selectedArticleIds.Count)개의 게시글을 삭제하시겠습니까?</p>
                <div class="stitch-modal-footer">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseBulkDeleteModal">취소</button>
                    <button type="button" class="stitch-btn stitch-btn-primary" @onclick="HandleBulkDelete" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        @(selectedArticleIds.Count)개 삭제
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    private Dictionary<uint, Fb.Model.Bulletin> sections;
    private uint? selectedBulletinSection;
    private List<Http.Model.Bulletin> articles;
    private int currentPage = 1;
    private const int pageSize = 20;
    private int totalPages = 1;
    private bool isLoading = false;
    private bool isProcessing = false;
    private string errorMessage;
    private string successMessage;
    private string searchQuery = string.Empty;
    private string searchField = "all";

    private bool showWriteModal = false;
    private bool showEditModal = false;
    private bool showViewModal = false;
    private bool showDeleteModal = false;
    private bool showBulkDeleteModal = false;
    private Http.Model.Bulletin selectedArticle;
    private WriteModel writeModel = new();
    private EditModel editModel = new();
    private HashSet<uint> selectedArticleIds = new();
    private uint currentUserId = 0;
    private ushort? currentPosition = null;
    private string lastSearchQuery = null;
    private uint? lastSelectedSection = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserId();
        await LoadSections();
    }

    private async Task LoadCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (idClaim != null && uint.TryParse(idClaim.Value, out var uid))
            {
                currentUserId = uid;
            }
        }
    }

    private async Task LoadSections()
    {
        try
        {
            sections = Table.Bulletin?.ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
            if (sections != null && sections.Any() && !selectedBulletinSection.HasValue)
            {
                selectedBulletinSection = sections.Keys.First();
                await LoadArticles();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading sections: {ex.Message}";
        }
    }

    private async Task SelectSection(uint section)
    {
        selectedBulletinSection = section;
        currentPage = 1;
        searchQuery = string.Empty;
        searchField = "all";
        selectedArticleIds.Clear();
        currentPosition = null;
        lastSearchQuery = null;
        lastSelectedSection = null;
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        if (!selectedBulletinSection.HasValue)
            return;

        // Reset position if section or search query changed
        if (lastSelectedSection != selectedBulletinSection.Value || lastSearchQuery != searchQuery)
        {
            currentPosition = null;
            lastSelectedSection = selectedBulletinSection.Value;
            lastSearchQuery = searchQuery;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            ushort position;

            if (currentPage == 1)
            {
                // First page starts at 0xFFFF (65535)
                position = 0xFFFF;
            }
            else if (articles != null && articles.Any())
            {
                // Calculate position from current articles' last article ID
                // This works for going to next page (last article ID - 1)
                // For going back to previous page, we need to reload previous page
                // by loading pages sequentially from the beginning
                var lastArticleId = articles.Last().Id;
                position = (ushort)(lastArticleId > 0 ? lastArticleId - 1 : 0);
            }
            else
            {
                // No articles or first load: start from beginning
                position = 0xFFFF;
            }

            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            articles = await BulletinService.GetArticleListAsync(
                selectedWorld.Value,
                selectedBulletinSection.Value,
                position,
                string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery,
                searchField);

            // Store position for next page calculation (last article ID - 1)
            if (articles != null && articles.Any())
            {
                var lastArticleId = articles.Last().Id;
                currentPosition = (ushort)(lastArticleId > 0 ? lastArticleId - 1 : 0);
            }
            else
            {
                currentPosition = 0;
            }

            // Estimate total pages (assuming 20 items per page from stored procedure)
            // For cursor-based pagination, we can't know total pages accurately
            // So we'll show "next" button if we got a full page
            totalPages = articles != null && articles.Count == pageSize ? currentPage + 1 : currentPage;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading articles: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSearchPlaceholder() => searchField switch
    {
        "title" => "제목 검색...",
        "contents" => "내용 검색...",
        "author" => "작성자명 검색...",
        _ => "제목, 내용, 작성자 검색..."
    };

    private async Task SearchArticles()
    {
        currentPage = 1;
        selectedArticleIds.Clear();
        currentPosition = null;
        lastSearchQuery = null;
        await LoadArticles();
    }

    private async Task ClearSearch()
    {
        searchQuery = string.Empty;
        searchField = "all";
        currentPage = 1;
        selectedArticleIds.Clear();
        currentPosition = null;
        lastSearchQuery = null;
        await LoadArticles();
    }

    private async Task HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchArticles();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            selectedArticleIds.Clear();
            await LoadArticles();
        }
    }

    private string GetSectionName(uint sectionId)
    {
        if (sections != null && sections.TryGetValue(sectionId, out var section))
        {
            return section.Name;
        }
        return $"Section {sectionId}";
    }

    private void ToggleArticleSelection(uint articleId)
    {
        if (selectedArticleIds.Contains(articleId))
            selectedArticleIds.Remove(articleId);
        else
            selectedArticleIds.Add(articleId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (articles == null)
            return;

        var isChecked = (bool)(e.Value ?? false);
        if (isChecked)
        {
            foreach (var article in articles)
            {
                selectedArticleIds.Add(article.Id);
            }
        }
        else
        {
            selectedArticleIds.Clear();
        }
    }

    private bool IsAllSelected => articles != null && articles.Any() && articles.All(a => selectedArticleIds.Contains(a.Id));

    private void ShowWriteModal()
    {
        writeModel = new WriteModel();
        showWriteModal = true;
    }

    private void CloseWriteModal()
    {
        showWriteModal = false;
        writeModel = new WriteModel();
    }

    private async Task HandleWrite()
    {
        if (!selectedBulletinSection.HasValue || currentUserId == 0)
        {
            errorMessage = "Invalid section or user ID.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            var success = await BulletinService.Write(
                selectedWorld.Value,
                selectedBulletinSection.Value,
                currentUserId,
                writeModel.Title,
                writeModel.Contents);

            if (success)
            {
                successMessage = "Article has been written successfully.";
                CloseWriteModal();
                await LoadArticles();
            }
            else
            {
                errorMessage = "Failed to write article.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error writing article: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ShowEditModal(Http.Model.Bulletin article)
    {
        if (!selectedBulletinSection.HasValue)
            return;

        isProcessing = true;
        errorMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            // Get full article data including contents
            var (fullArticle, _) = await BulletinService.GetArticleAsync(selectedWorld.Value, selectedBulletinSection.Value, article.Id);

            if (fullArticle == null)
            {
                errorMessage = "Article not found.";
                return;
            }

            selectedArticle = fullArticle;
            editModel = new EditModel
            {
                Title = fullArticle.Title,
                Contents = fullArticle.Contents ?? string.Empty,
                IgnoreOwner = true
            };
            showEditModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading article: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedArticle = null;
        editModel = new EditModel();
    }

    private async Task HandleEdit()
    {
        if (selectedArticle == null || !selectedBulletinSection.HasValue || currentUserId == 0)
        {
            errorMessage = "Invalid article or user ID.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            var result = await BulletinService.Update(
                selectedWorld.Value,
                selectedBulletinSection.Value,
                selectedArticle.Id,
                currentUserId,
                editModel.Title,
                editModel.Contents,
                true);

            if (result == 1)
            {
                successMessage = "Article has been updated successfully.";
                CloseEditModal();
                await LoadArticles();
            }
            else
            {
                errorMessage = $"Failed to update article. Result code: {result}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating article: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ShowViewModal(Http.Model.Bulletin article)
    {
        if (!selectedBulletinSection.HasValue)
            return;

        isProcessing = true;
        errorMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            // Get full article data including contents
            var (fullArticle, _) = await BulletinService.GetArticleAsync(selectedWorld.Value, selectedBulletinSection.Value, article.Id);

            if (fullArticle == null)
            {
                errorMessage = "Article not found.";
                return;
            }

            selectedArticle = fullArticle;
            showViewModal = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading article: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        selectedArticle = null;
    }

    private async Task OpenEditFromView()
    {
        if (selectedArticle == null)
            return;

        var article = selectedArticle;
        showViewModal = false;
        await ShowEditModal(article);
    }

    private void OpenDeleteFromView()
    {
        if (selectedArticle == null)
            return;

        showViewModal = false;
        showDeleteModal = true;
    }

    private void ShowDeleteModal(Http.Model.Bulletin article)
    {
        selectedArticle = article;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedArticle = null;
    }

    private async Task HandleDelete()
    {
        if (selectedArticle == null || !selectedBulletinSection.HasValue || currentUserId == 0)
        {
            errorMessage = "Invalid article or user ID.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            var result = await BulletinService.Delete(
                selectedWorld.Value,
                selectedBulletinSection.Value,
                selectedArticle.Id,
                currentUserId,
                true);

            if (result == 1)
            {
                successMessage = "Article has been deleted successfully.";
                CloseDeleteModal();
                await LoadArticles();
            }
            else
            {
                errorMessage = $"Failed to delete article. Result code: {result}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting article: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowBulkDeleteModal()
    {
        showBulkDeleteModal = true;
    }

    private void CloseBulkDeleteModal()
    {
        showBulkDeleteModal = false;
    }

    private async Task HandleBulkDelete()
    {
        if (!selectedArticleIds.Any() || !selectedBulletinSection.HasValue || currentUserId == 0)
        {
            errorMessage = "No articles selected or invalid section/user ID.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            var ids = selectedArticleIds.ToList();
            var result = await BulletinService.DeleteBatch(
                selectedWorld.Value,
                selectedBulletinSection.Value,
                ids,
                currentUserId,
                true);

            if (result > 0)
            {
                successMessage = $"{result} article(s) have been deleted successfully.";
                CloseBulkDeleteModal();
                selectedArticleIds.Clear();
                await LoadArticles();
            }
            else if (result == -4)
            {
                errorMessage = "Error occurred while deleting articles.";
            }
            else
            {
                errorMessage = $"Failed to delete articles. Result code: {result}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting articles: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class WriteModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(64, ErrorMessage = "Title must be 64 characters or less")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Contents is required")]
        [StringLength(1000, ErrorMessage = "Contents must be 1000 characters or less")]
        public string Contents { get; set; } = string.Empty;
    }

    private class EditModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(64, ErrorMessage = "Title must be 64 characters or less")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Contents is required")]
        [StringLength(1000, ErrorMessage = "Contents must be 1000 characters or less")]
        public string Contents { get; set; } = string.Empty;

        public bool IgnoreOwner { get; set; } = false;
    }
}
