@page "/servers"
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@inject ServerStateService ServerStateService
@inject CacheService CacheService
@attribute [Authorize(Roles = "Admin,Operator")]

<PageTitle>Server Status - Admin Tool</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Server Status</h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-12">
            <button class="btn btn-primary" @onclick="LoadServers" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Loading...</span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
        </div>
    </div>

    @if (servers != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Running Servers (@servers.Count)</h5>
            </div>
            <div class="card-body">
                @if (servers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>IP</th>
                                    <th>Port</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var server in servers)
                                {
                                    <tr>
                                        <td>@server.Service</td>
                                        <td>@server.Id</td>
                                        <td>@server.Name</td>
                                        <td>@server.IP</td>
                                        <td>@server.Port</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No servers are currently running.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">User Session Management</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Clear all user sessions from Redis. This operation is only allowed when no servers are running.
                </p>
                <button class="btn btn-danger" @onclick="ClearSessions" disabled="@(isProcessing || servers.Any())">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Clear User Sessions</span>
                    }
                </button>
                @if (servers.Any())
                {
                    <p class="text-warning mt-2 mb-0">
                        <small>Cannot clear sessions while servers are running. Please stop all servers first.</small>
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<ServerStateService.ServerInfo>? servers;
    private bool isLoading = false;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadServers();
    }

    private async Task LoadServers()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            servers = await ServerStateService.GetRunningServers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading servers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearSessions()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var cleared = await CacheService.ClearUserSessions();
            if (cleared)
            {
                successMessage = "User sessions have been cleared successfully.";
                await LoadServers(); // Refresh server list
            }
            else
            {
                errorMessage = "Cannot clear sessions while servers are running. Please stop all servers first.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error clearing sessions: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}

