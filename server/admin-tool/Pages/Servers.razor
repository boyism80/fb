@page "/servers"
@using Fb.Model.EnumValue
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Response = fb.protocol._internal.response
@inject ServerStateService ServerStateService
@inject CacheService CacheService
@inject RabbitMqService RabbitMqService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>Server Status - Admin Tool</PageTitle>

<div>
    <div class="page-header mb-4">
        <h1>Server Status</h1>
        <p class="text-muted">Monitor and manage game servers</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="mb-4">
        <button class="btn btn-primary" @onclick="LoadServers" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Loading...</span>
            }
            else
            {
                <span class="oi oi-reload me-2" aria-hidden="true"></span>
                <span>Refresh</span>
            }
        </button>
    </div>

    @if (servers != null)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Running Servers (@servers.Count)</h5>
            </div>
            <div class="card-body">
                @if (servers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>IP</th>
                                    <th>Port</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var server in servers)
                                {
                                    <tr>
                                        <td>@server.Service</td>
                                        <td>@server.Id</td>
                                        <td>@server.Name</td>
                                        <td>@server.IP</td>
                                        <td>@server.Port</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No servers are currently running.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Server Controls</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    Send RabbitMQ notifications through <code>fb.system</code> to broadcast save or initiate shutdown across
                    all game servers.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-warning"
                            disabled="@(isSaveProcessing || !canSaveServers)"
                            @onclick="RequestServerSave">
                        @if (isSaveProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Broadcasting Save...</span>
                        }
                        else
                        {
                            <span>Force Save All Servers</span>
                        }
                    </button>
                    <button class="btn btn-danger"
                            disabled="@(isShutdownProcessing || !canShutdownServers)"
                            @onclick="RequestServerShutdown">
                        @if (isShutdownProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Sending Shutdown...</span>
                        }
                        else
                        {
                            <span>Shutdown All Servers</span>
                        }
                    </button>
                </div>
                @if (!canSaveServers || !canShutdownServers)
                {
                    <p class="text-muted mt-2 mb-0">
                        <small>
                            Saving requires at least Admin role. Shutdown is limited to Superadmin or higher accounts.
                        </small>
                    </p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">User Session Management</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Clear all user sessions from Redis. This operation is only allowed when no servers are running.
                </p>
                <button class="btn btn-danger" @onclick="ClearSessions" disabled="@(isSessionProcessing || servers.Any())">
                    @if (isSessionProcessing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Clear User Sessions</span>
                    }
                </button>
                @if (servers.Any())
                {
                    <p class="text-warning mt-2 mb-0">
                        <small>Cannot clear sessions while servers are running. Please stop all servers first.</small>
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }
    private List<ServerStateService.ServerInfo>? servers;
    private bool isLoading = false;
    private bool isSessionProcessing = false;
    private bool isSaveProcessing = false;
    private bool isShutdownProcessing = false;
    private bool canSaveServers = false;
    private bool canShutdownServers = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await InitializePermissions();
        await LoadServers();
    }

    private async Task InitializePermissions()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        canSaveServers = user.IsInRole(nameof(Role.Admin)) ||
                         user.IsInRole(nameof(Role.Superadmin)) ||
                         user.IsInRole(nameof(Role.Owner));

        canShutdownServers = user.IsInRole(nameof(Role.Superadmin)) ||
                             user.IsInRole(nameof(Role.Owner));
    }

    private async Task LoadServers()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            servers = await ServerStateService.GetRunningServers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading servers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearSessions()
    {
        isSessionProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            var cleared = await CacheService.ClearUserSessions(selectedWorld.Value);
            if (cleared)
            {
                successMessage = "User sessions have been cleared successfully.";
                await LoadServers(); // Refresh server list
            }
            else
            {
                errorMessage = "Cannot clear sessions while servers are running. Please stop all servers first.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error clearing sessions: {ex.Message}";
        }
        finally
        {
            isSessionProcessing = false;
        }
    }

    private Task RequestServerSave()
    {
        if (!canSaveServers)
        {
            errorMessage = "You do not have permission to force saves.";
            successMessage = null;
            return Task.CompletedTask;
        }

        isSaveProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return Task.CompletedTask;
            }
            var packet = new Response.BroadcastSave();
            RabbitMqService.Publish(packet, "amq.direct", $"fb.{selectedWorld.Value}.system");
            successMessage = "Save instruction broadcasted to all game servers.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to broadcast save: {ex.Message}";
        }
        finally
        {
            isSaveProcessing = false;
        }

        return Task.CompletedTask;
    }

    private Task RequestServerShutdown()
    {
        if (!canShutdownServers)
        {
            errorMessage = "You do not have permission to shutdown servers.";
            successMessage = null;
            return Task.CompletedTask;
        }

        isShutdownProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return Task.CompletedTask;
            }
            var packet = new Response.Shutdown();
            // Shutdown uses fb.global (no world prefix - all servers receive)
            RabbitMqService.Publish(packet, "amq.direct", "fb.global");
            successMessage = "Shutdown instruction sent to all game servers.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send shutdown instruction: {ex.Message}";
        }
        finally
        {
            isShutdownProcessing = false;
        }

        return Task.CompletedTask;
    }

}

