@page "/servers"
@using Fb.Model.EnumValue
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Response = fb.protocol._internal.response
@inject ServerStateService ServerStateService
@inject CacheService CacheService
@inject RabbitMqService RabbitMqService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>서버 상태 - FB ADMIN</PageTitle>

<div class="servers-page">
    <div class="page-header">
        <h1>서버 상태</h1>
        <p>실시간 서버 하트비트 모니터링</p>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="stitch-error-banner">
            <div class="stitch-error-banner-content">
                <span class="material-symbols-outlined">error</span>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss" @onclick="() => errorMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="stitch-success-banner">
            <div class="stitch-success-banner-content">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="stitch-success-text">@successMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss stitch-success-dismiss" @onclick="() => successMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }
    <div class="card-bg filter-toolbar">
        <div class="filter-toolbar-left">
            <span class="dash-card-title" style="margin:0;">실행 중인 서버 @(filteredServers?.Count ?? 0)개</span>
            @if (!showAllWorlds && selectedWorld.HasValue)
            {
                <span class="servers-filter-scope">@GetWorldDisplayName(selectedWorld.Value)</span>
            }
            else if (showAllWorlds)
            {
                <span class="servers-filter-scope">전체 월드</span>
            }
            <label class="stitch-filter-check">
                <input type="checkbox" @bind="showAllWorlds" @bind:after="ApplyWorldFilter" />
                <span>전체 월드 표시</span>
            </label>
        </div>
        <div class="filter-toolbar-right">
            <button class="stitch-btn stitch-btn-primary" @onclick="LoadServers" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>불러오는 중...</span>
                }
                else
                {
                    <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;margin-right:0.25rem;">refresh</span>
                    <span>새로고침</span>
                }
            </button>
        </div>
    </div>
    @if (filteredServers != null)
    {
        <div style="margin-bottom:var(--section-gap);">
            <ServerStatusGroups Servers="filteredServers"
                                ShowKpi="true"
                                AllowExpand="true"
                                ShowWorld="showAllWorlds"
                                WorldNames="worldToServerName"
                                EmptyMessage="@GetEmptyMessage()" />
        </div>
        <div class="dash-row-2">
            <div class="card-bg dash-card dash-ops-panel">
                <h2 class="dash-card-title">서버 제어</h2>
                <p class="dash-ops-desc">RabbitMQ fb.system 채널을 통해 전체 게임 서버에 저장 또는 종료 명령을 전송합니다.</p>
                <div class="dash-btn-grid">
                    <button class="dash-ops-btn"
                            disabled="@(isSaveProcessing || !canSaveServers)"
                            @onclick="RequestServerSave">
                        @if (isSaveProcessing) { <span>저장 전송 중...</span> }
                        else { <span>전체 저장</span> }
                    </button>
                    <button class="dash-ops-btn"
                            disabled="@(isShutdownProcessing || !canShutdownServers)"
                            @onclick="RequestServerShutdown">
                        @if (isShutdownProcessing) { <span>종료 전송 중...</span> }
                        else { <span>서버 종료</span> }
                    </button>
                </div>
                @if (!canSaveServers || !canShutdownServers)
                {
                    <p class="dash-ops-hint">
                        저장은 Admin 이상, 종료는 Superadmin 이상 권한이 필요합니다.
                    </p>
                }
            </div>
            <div class="card-bg dash-card dash-ops-panel">
                <h2 class="dash-card-title">세션 관리</h2>
                <p class="dash-ops-desc">Redis에 저장된 유저 세션을 초기화합니다. 서버가 실행 중일 때는 사용할 수 없습니다.</p>
                <div class="dash-btn-grid dash-btn-grid-single">
                    <button class="dash-ops-btn" @onclick="ClearSessions" disabled="@(isSessionProcessing || filteredServers.Any())">
                        @if (isSessionProcessing) { <span>처리 중...</span> }
                        else { <span>세션 초기화</span> }
                    </button>
                </div>
                @if (filteredServers.Any())
                {
                    <p class="dash-ops-hint">
                        서버가 실행 중이면 세션을 초기화할 수 없습니다.
                    </p>
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    private List<ServerStateService.ServerInfo>? allServers;
    private List<ServerStateService.ServerInfo>? filteredServers;
    private Dictionary<uint, string>? worldToServerName;
    private bool showAllWorlds;
    private bool isLoading;
    private bool isSessionProcessing;
    private bool isSaveProcessing;
    private bool isShutdownProcessing;
    private bool canSaveServers;
    private bool canShutdownServers;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        LoadWorldNames();
        await InitializePermissions();
        await LoadServers();
    }

    protected override void OnParametersSet()
    {
        if (allServers != null)
            ApplyWorldFilter();
    }

    private void LoadWorldNames()
    {
        try
        {
            var worldServersSection = Configuration.GetSection("WorldServers");
            worldToServerName = worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .ToDictionary(
                    child => uint.Parse(child.Key),
                    child => child.Value ?? child.Key);
        }
        catch
        {
            worldToServerName = new Dictionary<uint, string>();
        }
    }

    private async Task InitializePermissions()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        canSaveServers = user.IsInRole(nameof(Role.Admin)) ||
                         user.IsInRole(nameof(Role.Superadmin)) ||
                         user.IsInRole(nameof(Role.Owner));
        canShutdownServers = user.IsInRole(nameof(Role.Superadmin)) ||
                             user.IsInRole(nameof(Role.Owner));
    }

    private async Task LoadServers()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            allServers = await ServerStateService.GetRunningServers();
            ApplyWorldFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"서버 목록을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyWorldFilter()
    {
        if (allServers == null)
        {
            filteredServers = null;
            return;
        }

        if (showAllWorlds)
        {
            filteredServers = allServers;
        }
        else if (selectedWorld.HasValue)
        {
            filteredServers = allServers
                .Where(server => server.World == selectedWorld.Value)
                .ToList();
        }
        else
        {
            filteredServers = new List<ServerStateService.ServerInfo>();
        }
    }

    private string GetWorldDisplayName(uint world)
    {
        if (worldToServerName != null && worldToServerName.TryGetValue(world, out var name))
            return name;

        return $"World {world}";
    }

    private string GetEmptyMessage()
    {
        if (!showAllWorlds && !selectedWorld.HasValue)
            return "월드를 선택하세요.";

        if (!showAllWorlds && selectedWorld.HasValue)
            return $"{GetWorldDisplayName(selectedWorld.Value)}에 실행 중인 서버가 없습니다.";

        return "현재 실행 중인 서버가 없습니다.";
    }

    private async Task ClearSessions()
    {
        isSessionProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "월드가 선택되지 않았습니다.";
                return;
            }
            var cleared = await CacheService.ClearUserSessions(selectedWorld.Value);
            if (cleared)
            {
                successMessage = "유저 세션이 초기화되었습니다.";
                await LoadServers();
            }
            else
            {
                errorMessage = "서버가 실행 중이면 세션을 초기화할 수 없습니다. 먼저 모든 서버를 종료하세요.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"세션 초기화 중 오류: {ex.Message}";
        }
        finally
        {
            isSessionProcessing = false;
        }
    }

    private async Task RequestServerSave()
    {
        if (!canSaveServers)
        {
            errorMessage = "강제 저장 권한이 없습니다.";
            successMessage = null;
            return;
        }
        isSaveProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "월드가 선택되지 않았습니다.";
                return;
            }
            var packet = new Response.BroadcastSave();
            await RabbitMqService.PublishAsync(packet, "amq.direct", $"fb.{selectedWorld.Value}.system");
            successMessage = "전체 게임 서버에 저장 명령을 전송했습니다.";
        }
        catch (Exception ex)
        {
            errorMessage = $"저장 명령 전송 실패: {ex.Message}";
        }
        finally
        {
            isSaveProcessing = false;
        }
    }

    private async Task RequestServerShutdown()
    {
        if (!canShutdownServers)
        {
            errorMessage = "서버 종료 권한이 없습니다.";
            successMessage = null;
            return;
        }
        isShutdownProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "월드가 선택되지 않았습니다.";
                return;
            }
            var packet = new Response.Shutdown();
            await RabbitMqService.PublishAsync(packet, "amq.direct", "fb.global");
            successMessage = "전체 게임 서버에 종료 명령을 전송했습니다.";
        }
        catch (Exception ex)
        {
            errorMessage = $"종료 명령 전송 실패: {ex.Message}";
        }
        finally
        {
            isShutdownProcessing = false;
        }
    }
}
