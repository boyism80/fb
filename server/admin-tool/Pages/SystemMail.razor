@page "/systemmail"
@using AdminTool.Services
@using AdminTool.Authentication
@using Http.Service
@using Http.Model
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject LogService LogService
@inject AdminActivityLogService ActivityLog
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>시스템 메일 - FB Admin</PageTitle>

<div class="system-mail-page">
    <div class="page-header">
        <h1>시스템 메일</h1>
        <p>전체 유저에게 시스템 메일 발송</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="stitch-error-banner">
            <div class="stitch-error-banner-content">
                <span class="material-symbols-outlined">error</span>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss" @onclick="() => errorMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="stitch-success-banner">
            <div class="stitch-success-banner-content">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="stitch-success-text">@successMessage</span>
            </div>
            <button type="button" class="stitch-banner-dismiss stitch-success-dismiss" @onclick="() => successMessage = null" aria-label="닫기">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <div class="system-mail-compose">
        <div class="system-mail-form-card">
            <EditForm Model="@mailModel" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <div class="system-mail-form-fields">
                    <div class="system-mail-field">
                        <label for="title" class="system-mail-label">제목</label>
                        <InputText id="title" class="form-control system-mail-input" @bind-Value="mailModel.Title"
                                   placeholder="제목 (예: {USER_NAME}님 안내)" />
                        <ValidationMessage For="@(() => mailModel.Title)" />
                    </div>
                    <div class="system-mail-field">
                        <label for="contents" class="system-mail-label">내용</label>
                        <InputTextArea id="contents" class="form-control system-mail-textarea" rows="6"
                                       @bind-Value="mailModel.Contents" placeholder="본문 내용을 입력하세요..." />
                        <ValidationMessage For="@(() => mailModel.Contents)" />
                    </div>
                    <div class="system-mail-field">
                        <div class="system-mail-expire-row">
                            <label for="reserveDate" class="system-mail-label">예약 발송 (선택)</label>
                            <span class="system-mail-hint">비워두면 즉시 발송 · 예약 시각 10초 전까지 수정·취소 가능</span>
                        </div>
                        <InputDate Type="InputDateType.DateTimeLocal" id="reserveDate" class="form-control system-mail-input" @bind-Value="reserveDateValue" />
                    </div>
                    <div class="system-mail-field">
                        <div class="system-mail-expire-row">
                            <label for="expireDate" class="system-mail-label">만료일 (선택)</label>
                            <span class="system-mail-hint">비워두면 만료 없음</span>
                        </div>
                        <InputDate id="expireDate" class="form-control system-mail-input" @bind-Value="expireDateValue" />
                    </div>
                    <div class="system-mail-field">
                        <label class="system-mail-label">
                            <InputCheckbox @bind-Value="includeNewCharacters" />
                            발송 이후 생성된 캐릭터도 받음
                        </label>
                    </div>
                </div>
                <div class="system-mail-actions">
                    <button type="button" class="system-mail-reset-btn" @onclick="ResetForm" disabled="@isProcessing">
                        @(editingMailId.HasValue ? "수정 취소" : "초기화")
                    </button>
                    <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <span class="material-symbols-outlined" style="font-size:1rem;">send</span>
                        @(editingMailId.HasValue ? $"M-{editingMailId} 수정 저장" : "전체 유저에게 발송")
                    </button>
                </div>
            </EditForm>
        </div>

        <aside class="system-mail-vars-card" aria-labelledby="system-mail-vars-title">
            <div class="system-mail-vars-header">
                <h2 id="system-mail-vars-title" class="system-mail-vars-title">시스템 변수</h2>
                <span class="system-mail-vars-count">@SystemMailTemplate.Variables.Count</span>
            </div>
            <p class="system-mail-vars-desc">제목·본문에 변수를 입력하면 유저별 메일 생성 시 치환됩니다.</p>
            <div class="system-mail-vars-scroll">
                <table class="system-mail-vars-table">
                    <thead>
                        <tr>
                            <th class="system-mail-vars-col-token">변수</th>
                            <th>설명</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variable in SystemMailTemplate.Variables)
                        {
                            <tr>
                                <td class="system-mail-vars-col-token">
                                    <code class="system-mail-var-token">{@variable.Token}</code>
                                </td>
                                <td>@variable.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </aside>
    </div>

    <section class="system-mail-history">
        <div class="system-mail-history-header">
            <h2 class="system-mail-history-title">예약·발송 중 메일</h2>
            <button type="button" class="system-mail-refresh-btn" @onclick="LoadStoredMails" aria-label="새로고침">
                <span class="material-symbols-outlined">refresh</span>
            </button>
        </div>
        @if (storedMails.Any())
        {
            <div class="system-mail-table-wrap">
                <table class="system-mail-table">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th>제목</th>
                            <th class="col-date">발송 시각</th>
                            <th class="col-date">만료일</th>
                            <th class="col-target">신규 캐릭터</th>
                            <th class="col-status">상태</th>
                            <th class="col-status">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mail in storedMails)
                        {
                            <tr>
                                <td>M-@mail.Id</td>
                                <td class="col-title">@mail.Title</td>
                                <td>@FormatLocal(mail.SendDate)</td>
                                <td>@(mail.ExpireDate.HasValue ? FormatLocal(mail.ExpireDate.Value) : "없음")</td>
                                <td>@(mail.IncludeNewCharacters ? "포함" : "제외")</td>
                                <td>
                                    @if (mail.ReserveDate > DateTime.UtcNow)
                                    {
                                        <span class="system-mail-status-badge">예약</span>
                                    }
                                    else
                                    {
                                        <span class="system-mail-status-badge">발송 중</span>
                                    }
                                </td>
                                <td>
                                    @if (Editable(mail))
                                    {
                                        <button type="button" class="system-mail-reset-btn" @onclick="() => BeginEdit(mail)" disabled="@isProcessing">수정</button>
                                        <button type="button" class="system-mail-reset-btn" @onclick="() => CancelReservation(mail)" disabled="@isProcessing">예약 취소</button>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="system-mail-table-wrap system-mail-empty">
                예약되었거나 발송 중인 메일이 없습니다.
            </div>
        }
    </section>

    <section class="system-mail-history">
        <div class="system-mail-history-header">
            <h2 class="system-mail-history-title">발송 이력</h2>
            <button type="button" class="system-mail-refresh-btn" @onclick="LoadHistory" aria-label="새로고침">
                <span class="material-symbols-outlined">refresh</span>
            </button>
        </div>
        @if (mailHistory.Any())
        {
            <div class="system-mail-table-wrap">
                <table class="system-mail-table">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th>제목</th>
                            <th class="col-target">수신인</th>
                            <th class="col-date">발송일</th>
                            <th class="col-status">상태</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in mailHistory)
                        {
                            <tr>
                                <td>@FormatMailId(entry.Detail)</td>
                                <td class="col-title">@entry.Summary</td>
                                <td>@(entry.Target ?? "전체")</td>
                                <td>@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (entry.Success)
                                    {
                                        <span class="system-mail-status-badge">완료</span>
                                    }
                                    else
                                    {
                                        <span class="system-mail-status-badge failed">실패</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="system-mail-history-meta">이 서버 세션 기준 · @(mailHistory.Count)건</p>
        }
        else
        {
            <div class="system-mail-table-wrap system-mail-empty">
                발송 이력이 없습니다. (이 서버 세션 기준)
            </div>
        }
    </section>
</div>

@code {

    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    private SystemMailModel mailModel = new();
    private string errorMessage;
    private string successMessage;
    private bool isProcessing = false;
    private uint currentUserId = 0;
    private string currentUserName = string.Empty;
    private DateTime? expireDateValue = null;
    private DateTime? reserveDateValue = null;
    private bool includeNewCharacters = false;
    private uint? editingMailId = null;
    private uint? loadedWorld = null;
    private List<Http.Model.SystemMail> storedMails = new();
    private List<AdminActivityEntry> mailHistory = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            var userNameClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name);

            if (userIdClaim != null && uint.TryParse(userIdClaim.Value, out var userId))
                currentUserId = userId;

            if (userNameClaim != null)
                currentUserName = userNameClaim.Value;
        }

        LoadHistory();
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (selectedWorld == loadedWorld)
            return;

        loadedWorld = selectedWorld;
        ResetForm();
        await LoadStoredMails();
    }

    private void LoadHistory()
    {
        mailHistory = ActivityLog.GetRecent("system_mail", 50).ToList();
    }

    private async Task LoadStoredMails()
    {
        if (!selectedWorld.HasValue)
        {
            storedMails = new();
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();
        storedMails = await dbContext.SystemMail.GetAll(selectedWorld.Value);
    }

    private static string FormatLocal(DateTime utc)
    {
        return DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private static bool Editable(Http.Model.SystemMail mail)
    {
        return mail.ReserveDate > DateTime.UtcNow + Http.Reepository.SystemMailRepository.EditLeadTime;
    }

    private void BeginEdit(Http.Model.SystemMail mail)
    {
        editingMailId = mail.Id;
        mailModel = new SystemMailModel { Title = mail.Title, Contents = mail.Contents };
        reserveDateValue = mail.ReserveDate.HasValue ? DateTime.SpecifyKind(mail.ReserveDate.Value, DateTimeKind.Utc).ToLocalTime() : null;
        expireDateValue = mail.ExpireDate.HasValue ? DateTime.SpecifyKind(mail.ExpireDate.Value, DateTimeKind.Utc).ToLocalTime() : null;
        includeNewCharacters = mail.IncludeNewCharacters;
        errorMessage = null;
        successMessage = null;
    }

    private async Task CancelReservation(Http.Model.SystemMail mail)
    {
        if (!selectedWorld.HasValue)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();
            if (await dbContext.SystemMail.Cancel(selectedWorld.Value, mail.Id) == false)
            {
                errorMessage = "예약 시각 10초 전까지만 취소할 수 있습니다.";
                return;
            }

            await LogService.WriteAsync("system_mail_cancel", new
            {
                action = "system_mail_cancel",
                source = "admin",
                actor = currentUserName,
                world = selectedWorld.Value,
                mail_id = mail.Id
            });

            ActivityLog.Add(new AdminActivityEntry
            {
                Category = "system_mail",
                Summary = $"예약 취소: {mail.Title}",
                Detail = $"#{mail.Id}",
                Actor = currentUserName,
                Target = "전체",
                Success = true
            });
            LoadHistory();

            if (editingMailId == mail.Id)
                ResetForm();
            successMessage = $"예약 발송이 취소되었습니다. (Mail ID: {mail.Id})";
        }
        catch (Exception ex)
        {
            errorMessage = $"예약 취소 중 오류: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await LoadStoredMails();
        }
    }

    private static string FormatMailId(string detail)
    {
        if (string.IsNullOrWhiteSpace(detail))
            return "—";
        if (detail.StartsWith('#'))
            return "M-" + detail.TrimStart('#');
        return detail;
    }

    private async Task HandleSubmit()
    {
        if (currentUserId == 0)
        {
            errorMessage = "User ID not found. Please log in again.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }

            var reserveUtc = reserveDateValue?.ToUniversalTime();
            var expireUtc = expireDateValue?.ToUniversalTime();
            if (reserveUtc.HasValue && reserveUtc <= DateTime.UtcNow + Http.Reepository.SystemMailRepository.EditLeadTime)
            {
                errorMessage = "예약 시각은 지금부터 10초 이후여야 합니다.";
                return;
            }

            if (expireUtc.HasValue && expireUtc <= (reserveUtc ?? DateTime.UtcNow))
            {
                errorMessage = "만료일은 발송 시각 이후여야 합니다.";
                return;
            }

            await using var scope = ScopeFactory.CreateAsyncScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();

            if (editingMailId.HasValue)
            {
                var mailId = editingMailId.Value;
                if (reserveUtc.HasValue == false)
                {
                    errorMessage = "예약 메일은 예약 시각을 비울 수 없습니다. 즉시 보내려면 예약을 취소하고 새로 작성하세요.";
                    return;
                }

                if (await dbContext.SystemMail.Edit(selectedWorld.Value, mailId, mailModel.Title, mailModel.Contents, reserveUtc.Value, expireUtc, includeNewCharacters) == false)
                {
                    errorMessage = "예약 시각 10초 전까지만 수정할 수 있습니다.";
                    return;
                }

                await LogService.WriteAsync("system_mail_edit", new
                {
                    action = "system_mail_edit",
                    source = "admin",
                    actor = currentUserName,
                    world = selectedWorld.Value,
                    mail_id = mailId,
                    reserve_date = reserveUtc.Value.ToString("yyyy-MM-dd HH:mm:ss"),
                    expire_date = expireUtc?.ToString("yyyy-MM-dd HH:mm:ss")
                });

                ActivityLog.Add(new AdminActivityEntry
                {
                    Category = "system_mail",
                    Summary = $"수정: {mailModel.Title.Trim()}",
                    Detail = $"#{mailId}",
                    Actor = currentUserName,
                    Target = "전체",
                    Success = true
                });
                LoadHistory();

                successMessage = $"예약 메일이 수정되었습니다. (Mail ID: {mailId})";
                ResetForm();
                await LoadStoredMails();
                return;
            }

            var systemMail = await dbContext.SystemMail.Write(
                selectedWorld.Value,
                currentUserId,
                mailModel.Title,
                mailModel.Contents,
                reserveUtc,
                expireUtc,
                includeNewCharacters);
            await dbContext.SaveChangesAsync();

            await LogService.WriteAsync("system_mail_create", new
            {
                action = "system_mail_create",
                source = "admin",
                actor = currentUserName,
                world = selectedWorld.Value,
                mail_id = systemMail.Id,
                sender_id = systemMail.Sender,
                reserve_date = systemMail.ReserveDate?.ToString("yyyy-MM-dd HH:mm:ss"),
                expire_date = systemMail.ExpireDate?.ToString("yyyy-MM-dd HH:mm:ss")
            });

            ActivityLog.Add(new AdminActivityEntry
            {
                Category = "system_mail",
                Summary = mailModel.Title.Trim(),
                Detail = $"#{systemMail.Id}",
                Actor = currentUserName,
                Target = "전체",
                Success = true
            });
            LoadHistory();

            successMessage = reserveUtc.HasValue
                ? $"시스템 메일이 예약되었습니다. (Mail ID: {systemMail.Id})"
                : $"시스템 메일이 발송되었습니다. (Mail ID: {systemMail.Id})";
            ResetForm();
            await LoadStoredMails();
        }
        catch (Exception ex)
        {
            ActivityLog.Add(new AdminActivityEntry
            {
                Category = "system_mail",
                Summary = mailModel.Title.Trim(),
                Detail = ex.Message,
                Actor = currentUserName,
                Target = "전체",
                Success = false
            });
            LoadHistory();
            errorMessage = $"시스템 메일 발송 중 오류: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ResetForm()
    {
        mailModel = new SystemMailModel();
        expireDateValue = null;
        reserveDateValue = null;
        includeNewCharacters = false;
        editingMailId = null;
    }

    private class SystemMailModel
    {
        [Required(ErrorMessage = "Title is required")]
        [StringLength(64, ErrorMessage = "Title must be 64 characters or less")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Contents is required")]
        [StringLength(256, ErrorMessage = "Contents must be 256 characters or less")]
        public string Contents { get; set; } = string.Empty;
    }

}
