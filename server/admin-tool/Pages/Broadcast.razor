@page "/broadcast"
@using Fb.Model.EnumValue
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations
@using Response = fb.protocol._internal.response
@inject RabbitMqService RabbitMqService
@inject LogService LogService
@inject IConfiguration Configuration
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>Broadcast - Admin Tool</PageTitle>

<div>
    <div class="page-header mb-4">
        <h1>Broadcast Message</h1>
        <p class="text-muted">
            Send a global broadcast message to every game server. Host is fixed to 0xFFFFFFFF so all servers receive
            it.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">New Broadcast</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@broadcastModel" OnValidSubmit="@HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="type" class="form-label">Message Type</label>
                            <InputSelect id="type" class="form-select" @bind-Value="broadcastModel.Type">
                                @foreach (var type in MessageTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => broadcastModel.Type)" />
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <InputTextArea id="message" class="form-control" rows="4"
                                           @bind-Value="broadcastModel.Message" />
                            <ValidationMessage For="@(() => broadcastModel.Message)" />
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox id="useBroadcast" class="form-check-input" @bind-Value="useBroadcast" />
                                <label class="form-check-label" for="useBroadcast">
                                    Broadcast to all worlds
                                </label>
                                <small class="form-text text-muted d-block">
                                    If checked, message will be sent to all worlds using Broadcast method. If unchecked, message will be sent only to the selected world.
                                </small>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm"
                                    disabled="@isProcessing">
                                Reset
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"
                                          aria-hidden="true"></span>
                                }
                                Send Broadcast
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const uint BroadcastHost = 0xFFFFFFFF;
    private BroadcastModel broadcastModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isProcessing;
    private bool useBroadcast = false;
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    private IEnumerable<MessageType> MessageTypes => Enum.GetValues<MessageType>();

    private async Task HandleSubmit()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var trimmedMessage = broadcastModel.Message?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(trimmedMessage))
            {
                errorMessage = "Message is required.";
            }
            else
            {
                var message = new Response.Broadcast
                {
                    Message = trimmedMessage,
                    Type = (byte)broadcastModel.Type,
                    Host = BroadcastHost,
                    Error = 0
                };

                if (useBroadcast)
                {
                    // Publish to all worlds
                    var worlds = GetWorlds();
                    foreach (var world in worlds)
                    {
                        await RabbitMqService.PublishAsync(message, "amq.direct", $"fb.{world}.global");
                    }
                }
                else
                {
                    // Publish to selected world only
                    if (!selectedWorld.HasValue)
                    {
                        errorMessage = "World is required when not using broadcast to all worlds.";
                        return;
                    }
                    await RabbitMqService.PublishAsync(message, "amq.direct", $"fb.{selectedWorld.Value}.global");
                }

                // Log broadcast event
                await LogService.WriteAsync("broadcast", new
                {
                    message_type = broadcastModel.Type.ToString(),
                    message = trimmedMessage,
                    message_length = trimmedMessage.Length,
                    world = useBroadcast ? "all" : selectedWorld?.ToString() ?? "unknown",
                    use_broadcast = useBroadcast
                });

                successMessage = useBroadcast
                    ? "Broadcast sent successfully to all worlds."
                    : $"Broadcast sent successfully to world: {selectedWorld?.ToString() ?? "unknown"}";

                // Clear only the message, keep the message type
                broadcastModel.Message = string.Empty;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send broadcast: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }

        await Task.CompletedTask;
    }

    private void ResetForm()
    {
        broadcastModel = new BroadcastModel();
    }

    private List<uint> GetWorlds()
    {
        try
        {
            var worldServersSection = Configuration.GetSection("WorldServers");
            return worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .Select(child => uint.Parse(child.Key))
                .ToList();
        }
        catch
        {
            return new List<uint>();
        }
    }

    private class BroadcastModel
    {
        [Required(ErrorMessage = "Message is required.")]
        [StringLength(256, ErrorMessage = "Message must be 256 characters or less.")]
        public string Message { get; set; } = string.Empty;

        [Required(ErrorMessage = "Message type is required.")]
        public MessageType Type { get; set; } = MessageType.Notify;
    }
}
