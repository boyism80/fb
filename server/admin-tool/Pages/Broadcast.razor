@page "/broadcast"
@using Fb.Model.EnumValue
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Response = fb.protocol._internal.response
@inject RabbitMqService RabbitMqService
@inject LogService LogService
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>Broadcast - Admin Tool</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Broadcast Message</h2>
            <p class="text-muted">
                Send a global broadcast message to every game server. Host is fixed to 0xFFFFFFFF so all servers receive
                it.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">New Broadcast</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@broadcastModel" OnValidSubmit="@HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="type" class="form-label">Message Type</label>
                            <InputSelect id="type" class="form-select" @bind-Value="broadcastModel.Type">
                                @foreach (var type in MessageTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => broadcastModel.Type)" />
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <InputTextArea id="message" class="form-control" rows="4"
                                           @bind-Value="broadcastModel.Message" />
                            <ValidationMessage For="@(() => broadcastModel.Message)" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="ResetForm"
                                    disabled="@isProcessing">
                                Reset
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"
                                          aria-hidden="true"></span>
                                }
                                Send Broadcast
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const uint BroadcastHost = 0xFFFFFFFF;
    private BroadcastModel broadcastModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isProcessing;

    private IEnumerable<MessageType> MessageTypes => Enum.GetValues<MessageType>();

    private async Task HandleSubmit()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var trimmedMessage = broadcastModel.Message?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(trimmedMessage))
            {
                errorMessage = "Message is required.";
            }
            else
            {
                var message = new Response.Broadcast
                    {
                        Message = trimmedMessage,
                        Type = (byte)broadcastModel.Type,
                        Host = BroadcastHost,
                        Error = 0
                    };

                RabbitMqService.Publish(message, "amq.direct", "fb.global");

                // Log broadcast event
                LogService.Write("broadcast", new
                {
                    message_type = broadcastModel.Type.ToString(),
                    message = trimmedMessage,
                    message_length = trimmedMessage.Length
                });

                successMessage = "Broadcast sent successfully.";
                ResetForm();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send broadcast: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }

        await Task.CompletedTask;
    }

    private void ResetForm()
    {
        broadcastModel = new BroadcastModel();
    }

    private class BroadcastModel
    {
        [Required(ErrorMessage = "Message is required.")]
        [StringLength(256, ErrorMessage = "Message must be 256 characters or less.")]
        public string Message { get; set; } = string.Empty;

        [Required(ErrorMessage = "Message type is required.")]
        public MessageType Type { get; set; } = MessageType.Notify;
    }
}
