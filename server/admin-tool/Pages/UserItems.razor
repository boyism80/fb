@page "/users/{userId:int}/items"
@using AdminTool.Services
@using Fb.Model
@using Fb.Model.EnumValue
@using Http.Model
@using Http.Service
@using Microsoft.AspNetCore.Authorization
@inject DbContext DbContext
@inject UserService UserService
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>유저 아이템 - FB ADMIN</PageTitle>

<div>
    <div class="page-breadcrumb">
        <a href="/users">유저</a> &gt; @(userDetail?.Name ?? "—") (UID: @UserId)
    </div>
    <div class="page-header">
        <div class="dash-card-title-row" style="justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;">
            <div>
                <h1>유저 아이템 관리</h1>
                <p class="dash-ops-desc" style="margin:0.25rem 0 0;">@(userDetail?.Name ?? "—") · UID @UserId</p>
            </div>
            @if (userDetail != null)
            {
                <div class="filter-toolbar-right" style="padding:0;">
                    <a href="@GetGrantItemsUrl()" class="stitch-btn stitch-btn-primary">아이템 지급</a>
                    <a href="/users" class="stitch-btn stitch-btn-neutral">유저 목록</a>
                </div>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">불러오는 중...</span>
            </div>
        </div>
    }
    else if (userDetail != null)
    {
        <div class="card-bg stitch-form-card mb-4">
            <div class="stitch-form-card-header">
                <h2 class="dash-card-title">장착 아이템</h2>
                <span class="stitch-badge">@equippedItems.Count 부위</span>
            </div>
            <div class="card-body">
                @if (equippedItems.Any())
                {
                    <div class="dash-table-wrap">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>부위</th>
                                    <th>모델 ID</th>
                                    <th>아이템명</th>
                                    <th>수량</th>
                                    <th>내구도</th>
                                    <th>커스텀명</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in equippedItems)
                                {
                                    <tr>
                                        <td>@GetPartsName(item.Parts)</td>
                                        <td class="table-meta">@item.Model</td>
                                        <td>@GetItemName(item.Model)</td>
                                        <td>@item.Count</td>
                                        <td>@(item.Durability?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrEmpty(item.CustomName) ? "-" : item.CustomName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">장착된 아이템이 없습니다.</p>
                }
            </div>
        </div>
        <div class="card-bg stitch-form-card mb-4">
            <div class="stitch-form-card-header">
                <h2 class="dash-card-title">인벤토리</h2>
                <span class="stitch-badge">@GetInventorySlotSummary()</span>
            </div>
            <div class="card-body">
                @if (inventoryItems.Any())
                {
                    <div class="dash-table-wrap">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>슬롯</th>
                                    <th>모델 ID</th>
                                    <th>아이템명</th>
                                    <th>수량</th>
                                    <th>내구도</th>
                                    <th>커스텀명</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in inventoryItems.OrderBy(i => i.Index))
                                {
                                    <tr>
                                        <td>@item.Index</td>
                                        <td class="table-meta">@item.Model</td>
                                        <td>@GetItemName(item.Model)</td>
                                        <td>@item.Count</td>
                                        <td>@(item.Durability?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrEmpty(item.CustomName) ? "-" : item.CustomName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">인벤토리 아이템이 없습니다.</p>
                }
            </div>
        </div>
        <div class="card-bg stitch-form-card mb-4">
            <div class="stitch-form-card-header">
                <h2 class="dash-card-title">창고</h2>
                <span class="stitch-badge">@GetStorageSlotSummary()</span>
            </div>
            <div class="card-body">
                @if (storedItems.Any())
                {
                    <div class="dash-table-wrap">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>창고</th>
                                    <th>슬롯</th>
                                    <th>모델 ID</th>
                                    <th>아이템명</th>
                                    <th>수량</th>
                                    <th>내구도</th>
                                    <th>커스텀명</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in storedItems.OrderBy(i => i.Stored).ThenBy(i => i.Index))
                                {
                                    <tr>
                                        <td>@item.Stored</td>
                                        <td>@item.Index</td>
                                        <td class="table-meta">@item.Model</td>
                                        <td>@GetItemName(item.Model)</td>
                                        <td>@item.Count</td>
                                        <td>@(item.Durability?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrEmpty(item.CustomName) ? "-" : item.CustomName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">창고 아이템이 없습니다.</p>
                }
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-warning">
            유저를 찾을 수 없습니다.
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }
    [Parameter]
    public int UserId { get; set; }
    private UserDetail? userDetail;
    private List<Http.Model.Item> equippedItems = new();
    private List<Http.Model.Item> inventoryItems = new();
    private List<Http.Model.Item> storedItems = new();
    private bool isLoading = false;
    private string? errorMessage;
    protected override async Task OnInitializedAsync()
    {
        await LoadUserItems();
    }

    private async Task LoadUserItems()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "월드가 선택되지 않았습니다.";
                isLoading = false;
                return;
            }
            var character = await DbContext.Character.Get(selectedWorld.Value, (uint)UserId);
            if (character == null)
            {
                errorMessage = "유저를 찾을 수 없습니다.";
                isLoading = false;
                return;
            }
            userDetail = await UserService.GetUserByName(selectedWorld.Value, character.Name);
            if (userDetail == null)
            {
                errorMessage = "유저를 찾을 수 없습니다.";
                isLoading = false;
                return;
            }
            var allItems = (await DbContext.Item.Get(selectedWorld.Value, (uint)UserId)).ToList();
            equippedItems = allItems.Where(i => i.Stored == -1 && i.Parts != 0).ToList();
            inventoryItems = allItems.Where(i => i.Stored == -1 && i.Parts == 0).ToList();
            storedItems = allItems.Where(i => i.Stored != -1).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"아이템 목록을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetGrantItemsUrl()
    {
        if (userDetail == null || string.IsNullOrWhiteSpace(userDetail.Name))
            return "/items";
        return $"/items?user={Uri.EscapeDataString(userDetail.Name)}";
    }

    private string GetInventorySlotSummary()
    {
        if (!inventoryItems.Any())
            return "0 슬롯";
        var maxIndex = inventoryItems.Max(i => i.Index);
        return $"{inventoryItems.Count}개 · 최대 슬롯 {maxIndex}";
    }

    private string GetStorageSlotSummary()
    {
        if (!storedItems.Any())
            return "0 슬롯";
        var vaultCount = storedItems.Select(i => i.Stored).Distinct().Count();
        return $"{storedItems.Count}개 · 창고 {vaultCount}개";
    }

    private string GetPartsName(short parts)
    {
        var equipmentParts = (EquipmentParts)parts;
        return equipmentParts switch
        {
            EquipmentParts.Weapon => "무기",
            EquipmentParts.Armor => "갑옷",
            EquipmentParts.Shield => "방패",
            EquipmentParts.Helmet => "투구",
            EquipmentParts.LeftHand => "반지 (좌)",
            EquipmentParts.RightHand => "반지 (우)",
            EquipmentParts.LeftAux => "보조 (좌)",
            EquipmentParts.RightAux => "보조 (우)",
            EquipmentParts.Unknown => "알 수 없음",
            _ => $"알 수 없음 ({parts})"
        };
    }

    private string GetItemName(uint modelId)
    {
        try
        {
            var item = Table.Item[modelId];
            return item?.Name ?? $"알 수 없음 (ID: {modelId})";
        }
        catch
        {
            return $"알 수 없음 (ID: {modelId})";
        }
    }
}
