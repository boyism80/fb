@page "/maintenance"
@using AdminTool.Authentication
@using Http.Model
@using Http.Service
@using Fb.Model.EnumValue
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject Http.Service.MaintenanceService MaintenanceService
@inject ILogger<Maintenance> Logger
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>점검 관리 - FB ADMIN</PageTitle>

<div>
    <div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;">
        <div>
            <h1>점검 관리</h1>
            <p>서버 점검 일정 등록 및 관리</p>
        </div>
        <a href="#maintenance-register" class="stitch-btn stitch-btn-primary">
            <span class="material-symbols-outlined" style="font-size:1rem;">add</span>
            점검 등록
        </a>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    <div class="card-bg filter-toolbar">
        <div class="toolbar mb-0">
            <div class="flex-grow-1">
                @if (currentMaintenanceInfo != null && currentMaintenanceInfo.IsActive)
                {
                    <div class="status-online"><span class="status-dot"></span>점검 진행 중</div>
                    <div class="text-muted mt-1" style="font-size: 0.8125rem;">
                        @currentMaintenanceInfo.Message
                        <span class="ms-2">종료: @FormatDateTime(currentMaintenanceInfo.EndTime)</span>
                    </div>
                }
                else
                {
                    <div style="font-size:0.875rem;color:var(--text-primary);">정상 운영 중</div>
                    <div class="text-muted mt-1" style="font-size:0.8125rem;">
                        Last Checked @lastCheckedAt.ToString("yyyy-MM-dd HH:mm:ss") KST
                    </div>
                }
            </div>
            <button class="stitch-btn stitch-btn-neutral" @onclick="RefreshStatus" disabled="@isLoading">
                <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;">refresh</span> 새로고침
            </button>
        </div>
    </div>
    <div class="card-bg stitch-form-card">
        <div class="stitch-form-card-header">
            <h2 class="dash-card-title">등록된 점검 일정</h2>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="stitch-loading">
                    <div class="spinner-border" role="status"></div>
                </div>
            }
            else if (schedules == null || !schedules.Any())
            {
                <p class="dash-empty">등록된 점검 일정이 없습니다.</p>
            }
            else
            {
                <div class="dash-table-wrap">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>시작</th>
                                <th>종료</th>
                                <th>내용</th>
                                <th>상태</th>
                                <th style="text-align:right;">작업</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in schedules)
                            {
                                <tr>
                                    <td class="table-meta">@FormatDateTime(schedule.StartTime)</td>
                                    <td class="table-meta">@FormatDateTime(schedule.EndTime)</td>
                                    <td>
                                        <strong>@schedule.Title</strong>
                                        <div class="table-meta">@(schedule.World == 0 ? "전체" : $"World {schedule.World}") · @GetRepeatTypeName(schedule.RepeatType)</div>
                                    </td>
                                    <td>
                                        @if (schedule.IsActive)
                                        {
                                            <span class="stitch-badge active">@GetScheduleStatusLabel(schedule)</span>
                                        }
                                        else
                                        {
                                            <span class="stitch-badge muted">취소됨</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        @if (schedule.IsActive)
                                        {
                                            <button class="text-link" @onclick="() => CancelSchedule(schedule)" disabled="@isProcessing">취소</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="card-bg stitch-form-card" id="maintenance-register">
        <div class="stitch-form-card-header">
            <h2 class="dash-card-title">점검 일정 등록</h2>
        </div>
        <div class="card-body">
            <EditForm Model="@scheduleModel" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div>
                        <label for="title" class="form-label">제목</label>
                        <InputText id="title" class="form-control" @bind-Value="scheduleModel.Title" />
                        <ValidationMessage For="@(() => scheduleModel.Title)" />
                    </div>
                    <div>
                        <label for="world" class="form-label">월드</label>
                        <InputSelect id="world" class="form-select" @bind-Value="scheduleModel.World">
                            <option value="0">전체 월드</option>
                            @if (selectedWorld.HasValue && selectedWorld.Value > 0)
                            {
                                <option value="@selectedWorld.Value">World @selectedWorld.Value</option>
                            }
                        </InputSelect>
                        <small class="form-text text-muted">0을 선택하면 모든 월드에 적용됩니다</small>
                    </div>
                    <div class="form-grid-full">
                        <label for="message" class="form-label">메시지</label>
                        <InputTextArea id="message" class="form-control" rows="3" @bind-Value="scheduleModel.Message" />
                        <ValidationMessage For="@(() => scheduleModel.Message)" />
                    </div>
                    <div>
                        <label for="startTime" class="form-label">시작 시간</label>
                        <InputText id="startTime" type="datetime-local" class="form-control" @bind-Value="startTimeString" />
                        <ValidationMessage For="@(() => scheduleModel.StartTime)" />
                        <small class="form-text text-muted">KST (UTC+9)</small>
                    </div>
                    <div>
                        <label for="endTime" class="form-label">종료 시간</label>
                        <InputText id="endTime" type="datetime-local" class="form-control" @bind-Value="endTimeString" />
                        <ValidationMessage For="@(() => scheduleModel.EndTime)" />
                        <small class="form-text text-muted">KST (UTC+9)</small>
                    </div>
                    <div class="form-grid-full">
                        <label for="repeatType" class="form-label">반복 유형</label>
                        <InputSelect id="repeatType" class="form-select" @bind-Value="scheduleModel.RepeatType">
                            <option value="@MaintenanceRepeatType.None">1회</option>
                            <option value="@MaintenanceRepeatType.Daily">매일</option>
                            <option value="@MaintenanceRepeatType.Weekly">매주</option>
                            <option value="@MaintenanceRepeatType.Monthly">매월</option>
                            <option value="@MaintenanceRepeatType.Yearly">매년</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="stitch-form-actions">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="ResetForm" disabled="@isProcessing">
                        초기화
                    </button>
                    <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        일정 등록
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }
    private MaintenanceScheduleModel scheduleModel = new();
    private List<MaintenanceSchedule>? schedules;
    private MaintenanceInfo? currentMaintenanceInfo;
    private string? errorMessage;
    private string? successMessage;
    private bool isProcessing;
    private bool isLoading;
    private DateTime lastCheckedAt = DateTime.Now;
    private string startTimeString
    {
        get => scheduleModel.StartTime.ToString("yyyy-MM-ddTHH:mm");
        set
        {
            if (DateTime.TryParse(value, out var dateTime))
            {
                scheduleModel.StartTime = dateTime;
            }
        }
    }

    private string endTimeString
    {
        get => scheduleModel.EndTime.ToString("yyyy-MM-ddTHH:mm");
        set
        {
            if (DateTime.TryParse(value, out var dateTime))
            {
                scheduleModel.EndTime = dateTime;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var world = selectedWorld ?? 0;
            schedules = await MaintenanceService.GetAllSchedules(world);
            currentMaintenanceInfo = await MaintenanceService.GetMaintenanceInfo(world);
            lastCheckedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load maintenance data");
            errorMessage = "점검 데이터를 불러오지 못했습니다.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var schedule = new MaintenanceSchedule
            {
                Id = Guid.NewGuid().ToString(),
                World = scheduleModel.World,
                Title = scheduleModel.Title,
                Message = scheduleModel.Message,
                StartTime = scheduleModel.StartTime,
                EndTime = scheduleModel.EndTime,
                RepeatType = scheduleModel.RepeatType,
                IsActive = true,
                CreatedAt = DateTime.Now
            };
            bool success;
            if (schedule.World == 0)
            {
                success = await MaintenanceService.ApplyToAllWorlds(schedule);
            }
            else
            {
                success = await MaintenanceService.CreateMaintenanceSchedule(schedule);
            }
            if (success)
            {
                successMessage = schedule.World == 0
                    ? "전체 월드에 점검 일정을 등록했습니다."
                    : $"World {schedule.World}에 점검 일정을 등록했습니다.";
                ResetForm();
                await LoadData();
            }
            else
            {
                errorMessage = "점검 일정 등록에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create maintenance schedule");
            errorMessage = $"점검 일정 등록 실패: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelSchedule(MaintenanceSchedule schedule)
    {
        if (!await ConfirmCancel(schedule))
            return;
        isProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var success = await MaintenanceService.CancelMaintenanceSchedule(schedule.World, schedule.Id);
            if (success)
            {
                successMessage = "점검 일정을 취소했습니다.";
                await LoadData();
            }
            else
            {
                errorMessage = "점검 일정 취소에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel maintenance schedule");
            errorMessage = $"점검 일정 취소 실패: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ConfirmCancel(MaintenanceSchedule schedule)
    {
        return await Task.FromResult(true);
    }

    private async Task RefreshStatus()
    {
        await LoadData();
    }

    private static string GetScheduleStatusLabel(MaintenanceSchedule schedule)
    {
        if (!schedule.IsActive)
            return "취소";
        var now = DateTime.Now;
        if (now >= schedule.StartTime && now <= schedule.EndTime)
            return "진행 중";
        if (now < schedule.StartTime)
            return "대기 중";
        return "완료";
    }

    private void ResetForm()
    {
        scheduleModel = new MaintenanceScheduleModel
        {
            World = selectedWorld ?? 0,
            StartTime = DateTime.Now,
            EndTime = DateTime.Now.AddHours(1),
            RepeatType = MaintenanceRepeatType.None
        };
    }

    private string FormatDateTime(DateTime dateTime)
    {
        return dateTime.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private string GetRepeatTypeName(MaintenanceRepeatType repeatType)
    {
        return repeatType switch
        {
            MaintenanceRepeatType.None => "1회",
            MaintenanceRepeatType.Daily => "매일",
            MaintenanceRepeatType.Weekly => "매주",
            MaintenanceRepeatType.Monthly => "매월",
            MaintenanceRepeatType.Yearly => "매년",
            _ => "알 수 없음"
        };
    }

    private class MaintenanceScheduleModel
    {
        [Required(ErrorMessage = "제목을 입력하세요.")]
        [StringLength(100, ErrorMessage = "제목은 100자 이하여야 합니다.")]
        public string Title { get; set; } = string.Empty;
        [Required(ErrorMessage = "메시지를 입력하세요.")]
        [StringLength(500, ErrorMessage = "메시지는 500자 이하여야 합니다.")]
        public string Message { get; set; } = string.Empty;
        public uint World { get; set; }
        [Required(ErrorMessage = "시작 시간을 입력하세요.")]
        public DateTime StartTime { get; set; } = DateTime.Now;
        [Required(ErrorMessage = "종료 시간을 입력하세요.")]
        public DateTime EndTime { get; set; } = DateTime.Now.AddHours(1);
        public MaintenanceRepeatType RepeatType { get; set; } = MaintenanceRepeatType.None;
    }
}
