@page "/items"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Operator")]

<PageTitle>Item Management - Admin Tool</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Item Management</h2>
            <p class="text-muted">Grant items to users (Feature not yet implemented)</p>
        </div>
    </div>

    <div class="alert alert-info" role="alert">
        <h5 class="alert-heading">Coming Soon</h5>
        <p class="mb-0">
            The item granting feature is currently under development. This page will allow administrators to grant items to users.
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Grant Item</h5>
        </div>
        <div class="card-body">
            <form>
                <div class="mb-3">
                    <label for="characterName" class="form-label">Character Name</label>
                    <input type="text" class="form-control" id="characterName" placeholder="Enter character name" disabled />
                    <small class="form-text text-muted">The character to receive the item</small>
                </div>
                <div class="mb-3">
                    <label for="itemId" class="form-label">Item ID</label>
                    <input type="number" class="form-control" id="itemId" placeholder="Enter item ID" disabled />
                    <small class="form-text text-muted">The ID of the item to grant</small>
                </div>
                <div class="mb-3">
                    <label for="itemCount" class="form-label">Count</label>
                    <input type="number" class="form-control" id="itemCount" placeholder="Enter item count" value="1" min="1" disabled />
                    <small class="form-text text-muted">The number of items to grant</small>
                </div>
                <button type="submit" class="btn btn-primary" disabled>
                    Grant Item
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    // Feature not yet implemented
}

