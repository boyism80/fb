@page "/items"
@using AdminTool.Services
@using Http.Service
@using Fb.Model
@using Fb.Model.EnumValue
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@attribute [AuthorizeRole(Role.Admin)]
@inject IServiceScopeFactory ScopeFactory
@inject AdminActivityLogService ActivityLog
@inject NavigationManager Navigation

<PageTitle>아이템 지급 - FB Admin</PageTitle>

<div class="items-page">
<div class="page-header">
    <h1>아이템 지급</h1>
    <p>아이템, 골드, 경험치를 유저에게 지급</p>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="stitch-error-banner">
        <div class="stitch-error-banner-content">
            <span class="material-symbols-outlined">error</span>
            <span>@errorMessage</span>
        </div>
        <button type="button" class="stitch-banner-dismiss" @onclick="() => errorMessage = null" aria-label="닫기">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="stitch-success-banner">
        <div class="stitch-success-banner-content">
            <span class="material-symbols-outlined">check_circle</span>
            <span class="stitch-success-text">@successMessage</span>
        </div>
        <button type="button" class="stitch-banner-dismiss stitch-success-dismiss" @onclick="() => successMessage = null" aria-label="닫기">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

<div class="items-target-tabs">
    <button type="button" class="items-target-tab @(model.IsGlobal ? "selected" : null)" @onclick="() => SetGrantMode(true)">
        <span class="material-symbols-outlined">group</span>
        전체 지급
    </button>
    <button type="button" class="items-target-tab @(!model.IsGlobal ? "selected" : null)" @onclick="() => SetGrantMode(false)">
        <span class="material-symbols-outlined">person</span>
        유저 지급
    </button>
</div>

<div class="items-form-card">
    <h2 class="items-form-title">지급 상세 정보</h2>
    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <div class="items-form-grid">
            @if (!model.IsGlobal)
            {
                <div class="items-field items-col-6">
                    <label for="userName" class="items-label">유저명</label>
                    <InputText id="userName" class="form-control items-input" @bind-Value="model.UserName" placeholder="유저 닉네임 입력" />
                    <ValidationMessage For="@(() => model.UserName)" />
                </div>
            }
            <div class="items-field @(model.IsGlobal ? "items-col-12" : "items-col-6")">
                <label for="title" class="items-label">제목</label>
                <InputText id="title" class="form-control items-input" @bind-Value="model.Title" placeholder="메일 제목 입력" />
                <ValidationMessage For="@(() => model.Title)" />
            </div>
            <div class="items-field items-col-12">
                <label for="message" class="items-label">메시지</label>
                <InputTextArea id="message" class="form-control items-textarea" rows="3" @bind-Value="model.Message" placeholder="유저에게 보낼 메시지" />
                <ValidationMessage For="@(() => model.Message)" />
            </div>
            @if (model.IsGlobal)
            {
                <div class="items-field items-col-4">
                    <label for="reserveDate" class="items-label">예약 지급 (선택)</label>
                    <InputDate Type="InputDateType.DateTimeLocal" id="reserveDate" class="form-control items-input" @bind-Value="model.ReserveDate" />
                    <span class="items-field-hint">비워두면 즉시 지급 · 예약 시각 10초 전까지 수정·취소 가능</span>
                </div>
                <div class="items-field items-col-8">
                    <label class="items-label">
                        <InputCheckbox @bind-Value="model.IncludeNewCharacters" />
                        지급 이후 생성된 캐릭터도 받음
                    </label>
                </div>
            }
            <div class="items-field items-col-4">
                <label for="expiredDate" class="items-label">만료일</label>
                <InputDate id="expiredDate" class="form-control items-input" @bind-Value="model.ExpiredDate" />
            </div>
            <div class="items-field items-col-8">
                <label class="items-label">아이템 검색</label>
                <div class="items-search-wrap">
                    <span class="material-symbols-outlined items-search-icon">search</span>
                    <input type="text" class="form-control items-input items-search-input"
                           @bind="itemSearchText"
                           @bind:event="oninput"
                           @bind:after="HandleItemSearchInput"
                           @onkeydown="HandleItemSearchKeyDown"
                           @onfocus="() => showItemSuggestions = !string.IsNullOrWhiteSpace(itemSearchText) && filteredItems.Any()"
                           @onblur="() => Task.Delay(200).ContinueWith(_ => InvokeAsync(() => { showItemSuggestions = false; StateHasChanged(); }))"
                           placeholder="아이템 ID 또는 이름 입력" />
                    @if (showItemSuggestions && filteredItems.Any())
                    {
                        <div class="items-suggestions">
                            @foreach (var item in filteredItems.Take(10))
                            {
                                <button type="button" class="items-suggestion-item" @onclick="() => SelectItem(item)">
                                    @item.Name (ID: @item.Id)
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (selectedItem != null)
                {
                    <span class="items-field-hint">
                        선택: @selectedItem.Name
                        @if (selectedItem.Capacity > 1)
                        {
                            <span>(묶음, 최대: @selectedItem.Capacity)</span>
                        }
                    </span>
                }
            </div>
            <div class="items-field items-col-4">
                <label class="items-label">수량</label>
                <InputNumber class="form-control items-input" @bind-Value="itemQuantity" min="1" max="@(selectedItem?.Capacity ?? 1)" disabled="@(!canEditQuantity)" />
            </div>
            <div class="items-field items-col-4">
                <label class="items-label">골드 지급</label>
                <InputNumber class="form-control items-input" @bind-Value="moneyValue" min="0" />
            </div>
            <div class="items-field items-col-4">
                <label class="items-label">경험치 지급</label>
                <InputNumber class="form-control items-input" @bind-Value="expValue" min="0" />
            </div>
            <div class="items-field items-col-12">
                <div class="items-add-actions">
                    <button type="button" class="items-add-btn" @onclick="AddItem" disabled="@(!canAddItem)">아이템 추가</button>
                    <button type="button" class="items-add-btn" @onclick="AddMoney" disabled="@(moneyValue == null || moneyValue <= 0)">골드 추가</button>
                    <button type="button" class="items-add-btn" @onclick="AddExp" disabled="@(expValue == null || expValue <= 0)">경험치 추가</button>
                </div>
            </div>
            <div class="items-field items-col-12">
                <label class="items-label">첨부 항목 (미리보기)</label>
                <span class="items-field-hint">아이템: @itemCount / 52 · 합계: @totalAttachmentCount / 54</span>
                @if (model.Attachments.Any())
                {
                    <div class="items-attachment-chips">
                        @foreach (var (attachment, index) in model.Attachments.Select((a, i) => (a, i)))
                        {
                            <div class="items-attachment-chip">
                                <span>@FormatAttachmentLabel(attachment)</span>
                                <button type="button" class="items-chip-remove" @onclick="() => RemoveAttachment(index)" aria-label="제거">
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="items-attachment-empty">추가된 항목이 없습니다.</div>
                }
            </div>
        </div>
        <div class="items-form-actions">
            <button type="button" class="items-reset-btn" @onclick="ResetForm" disabled="@isProcessing">
                @(editingBoxId.HasValue ? "수정 취소" : "초기화")
            </button>
            <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <span class="material-symbols-outlined" style="font-size:1rem;">send</span>
                @(editingBoxId.HasValue ? $"#{editingBoxId} 수정 저장" : "지급하기")
            </button>
        </div>
    </EditForm>
</div>

<section class="items-log-card">
    <div class="items-log-header">
        <h2 class="items-log-title">예약·지급 중 전체 지급</h2>
        <button type="button" class="items-log-refresh" @onclick="LoadStoredBoxes">
            <span class="material-symbols-outlined">refresh</span>
            <span>새로고침</span>
        </button>
    </div>
    @if (storedBoxes.Any())
    {
        <div class="items-log-table-wrap">
            <table class="items-log-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th class="col-detail">제목</th>
                        <th class="col-date">지급 시각</th>
                        <th class="col-date">만료일</th>
                        <th>신규 캐릭터</th>
                        <th class="col-status">상태</th>
                        <th class="col-status">작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var box in storedBoxes)
                    {
                        <tr>
                            <td>#@box.Id</td>
                            <td class="col-detail" title="@box.Title">@box.Title · 첨부 @(box.Attachments.Count)건</td>
                            <td>@FormatLocal(box.SendDate)</td>
                            <td>@(box.ExpiredDate.HasValue ? FormatLocal(box.ExpiredDate.Value) : "없음")</td>
                            <td>@(box.IncludeNewCharacters ? "포함" : "제외")</td>
                            <td>
                                <span class="items-status-badge">@(box.ReserveDate > DateTime.UtcNow ? "예약" : "지급 중")</span>
                            </td>
                            <td>
                                @if (Editable(box))
                                {
                                    <button type="button" class="items-add-btn" @onclick="() => BeginEdit(box)" disabled="@isProcessing">수정</button>
                                    <button type="button" class="items-add-btn" @onclick="() => CancelReservation(box)" disabled="@isProcessing">예약 취소</button>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="items-log-empty">예약되었거나 지급 중인 전체 지급이 없습니다.</div>
    }
</section>

<section class="items-log-card">
    <div class="items-log-header">
        <h2 class="items-log-title">아이템 지급 로그</h2>
        <button type="button" class="items-log-refresh" @onclick="LoadGrantHistory">
            <span class="material-symbols-outlined">refresh</span>
            <span>새로고침</span>
        </button>
    </div>
    @if (grantHistory.Any())
    {
        <div class="items-log-table-wrap">
            <table class="items-log-table">
                <thead>
                    <tr>
                        <th class="col-date">일시</th>
                        <th class="col-target">대상</th>
                        <th class="col-detail">내용</th>
                        <th class="col-status">상태</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in grantHistory)
                    {
                        <tr>
                            <td>@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@entry.Target</td>
                            <td class="col-detail" title="@entry.Detail">@entry.Detail</td>
                            <td>
                                @if (entry.Success)
                                {
                                    <span class="items-status-badge">성공</span>
                                }
                                else
                                {
                                    <span class="items-status-badge failed">실패</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="items-log-empty">지급 로그가 없습니다. (이 서버 세션 기준)</div>
    }
</section>
</div>

@code {

    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }

    private StoragePendingForm model = new();
    private string errorMessage;
    private string successMessage;
    private bool isProcessing;
    private List<AdminActivityEntry> grantHistory = new();

    private string itemSearchText = string.Empty;
    private bool showItemSuggestions = false;
    private Fb.Model.Item selectedItem = null;
    private int? itemQuantity = 1;
    private List<Fb.Model.Item> allItems = new();

    private long? moneyValue = null;
    private long? expValue = null;

    private uint? editingBoxId = null;
    private uint? loadedWorld = null;
    private List<Http.Model.SystemStorageBox> storedBoxes = new();

    protected override void OnInitialized()
    {
        allItems = Table.Item.Values.ToList();
        model.ExpiredDate = DateTime.Today.AddDays(30);
        ApplyQueryParameters();
        LoadGrantHistory();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (selectedWorld == loadedWorld)
            return;

        loadedWorld = selectedWorld;
        editingBoxId = null;
        await LoadStoredBoxes();
    }

    private async Task LoadStoredBoxes()
    {
        if (!selectedWorld.HasValue)
        {
            storedBoxes = new();
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();
        storedBoxes = await dbContext.SystemStorageBox.GetAll(selectedWorld.Value);
    }

    private static string FormatLocal(DateTime utc)
    {
        return DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private static bool Editable(Http.Model.SystemStorageBox box)
    {
        return box.ReserveDate > DateTime.UtcNow + Http.Reepository.SystemMailRepository.EditLeadTime;
    }

    private void BeginEdit(Http.Model.SystemStorageBox box)
    {
        ResetForm();
        editingBoxId = box.Id;
        model.IsGlobal = true;
        model.Title = box.Title;
        model.Message = box.Message;
        model.Attachments = box.Attachments.ToList();
        model.ReserveDate = box.ReserveDate.HasValue ? DateTime.SpecifyKind(box.ReserveDate.Value, DateTimeKind.Utc).ToLocalTime() : null;
        model.ExpiredDate = box.ExpiredDate.HasValue ? DateTime.SpecifyKind(box.ExpiredDate.Value, DateTimeKind.Utc).ToLocalTime() : null;
        model.IncludeNewCharacters = box.IncludeNewCharacters;
        errorMessage = null;
        successMessage = null;
    }

    private async Task CancelReservation(Http.Model.SystemStorageBox box)
    {
        if (!selectedWorld.HasValue)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();
            if (await dbContext.SystemStorageBox.Cancel(selectedWorld.Value, box.Id) == false)
            {
                errorMessage = "예약 시각 10초 전까지만 취소할 수 있습니다.";
                return;
            }

            ActivityLog.Add(new AdminActivityEntry
            {
                Category = "item_grant",
                Summary = "전체 지급 예약 취소",
                Detail = $"#{box.Id} · {box.Title}",
                Target = "전체",
                Success = true
            });
            LoadGrantHistory();

            if (editingBoxId == box.Id)
                ResetForm();
            successMessage = $"예약 지급이 취소되었습니다. (System Storage ID: #{box.Id})";
        }
        catch (Exception ex)
        {
            errorMessage = $"예약 취소 중 오류: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            await LoadStoredBoxes();
        }
    }

    private void ApplyQueryParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("user", out var userValues)
            && userValues.Count > 0
            && !string.IsNullOrWhiteSpace(userValues[0]))
        {
            model.IsGlobal = false;
            model.UserName = userValues[0];
        }
    }

    private void SetGrantMode(bool isGlobal)
    {
        model.IsGlobal = isGlobal;
        if (isGlobal)
        {
            model.UserName = null;
        }
        else
        {
            editingBoxId = null;
            model.ReserveDate = null;
            model.IncludeNewCharacters = false;
        }
    }

    private void LoadGrantHistory()
    {
        grantHistory = ActivityLog.GetRecent("item_grant", 50).ToList();
    }

    private IEnumerable<Fb.Model.Item> filteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(itemSearchText))
                return Enumerable.Empty<Fb.Model.Item>();

            var searchLower = itemSearchText.ToLowerInvariant();
            return allItems.Where(item =>
                    item.Name.ToLowerInvariant().Contains(searchLower))
                .OrderBy(item => item.Name)
                .Take(20);
        }
    }

    private bool canEditQuantity => selectedItem != null && selectedItem.Capacity > 1;

    private bool canAddItem => selectedItem != null &&
                               (!IsBundleItem(selectedItem) || !HasBundleItemInAttachments(selectedItem)) &&
                               itemCount < 52;

    private int itemCount => model.Attachments.Count(a => a.Header == Fb.Model.EnumValue.Dsl.Item);

    private int totalAttachmentCount => model.Attachments.Count;

    private static string FormatAttachmentLabel(Fb.Model.Dsl attachment)
    {
        if (attachment.Header == Fb.Model.EnumValue.Dsl.Item)
        {
            var itemId = (uint)attachment.Params[0];
            var count = (uint)attachment.Params[1];
            var item = Table.Item[itemId];
            return $"{item?.Name ?? $"ID:{itemId}"} x {count}";
        }

        if (attachment.Header == Fb.Model.EnumValue.Dsl.Money)
        {
            var value = (uint)attachment.Params[0];
            return $"골드 x {value:N0}";
        }

        if (attachment.Header == Fb.Model.EnumValue.Dsl.Exp)
        {
            var value = (uint)attachment.Params[0];
            return $"경험치 x {value:N0}";
        }

        return attachment.Header.ToString();
    }

    private void HandleItemSearchInput()
    {
        showItemSuggestions = !string.IsNullOrWhiteSpace(itemSearchText) && filteredItems.Any();
        if (string.IsNullOrWhiteSpace(itemSearchText))
            selectedItem = null;
    }

    private void HandleItemSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            showItemSuggestions = false;
        else if (!string.IsNullOrWhiteSpace(itemSearchText))
            showItemSuggestions = true;
    }

    private void SelectItem(Fb.Model.Item item)
    {
        selectedItem = item;
        itemSearchText = item.Name;
        showItemSuggestions = false;
        itemQuantity = 1;
    }

    private void AddItem()
    {
        if (selectedItem == null)
            return;

        if (IsBundleItem(selectedItem) && HasBundleItemInAttachments(selectedItem))
        {
            errorMessage = "Bundle items can only be added once.";
            return;
        }

        if (itemCount >= 52)
        {
            errorMessage = "Maximum 52 items allowed.";
            return;
        }

        var quantity = IsBundleItem(selectedItem) ? (uint)(itemQuantity ?? 1) : 1u;
        if (quantity < 1 || (IsBundleItem(selectedItem) && quantity > selectedItem.Capacity))
        {
            errorMessage = $"Quantity must be between 1 and {selectedItem.Capacity}.";
            return;
        }

        var dslItem = new Fb.Model.Dsl.Item
        {
            Id = selectedItem.Id,
            Count = quantity,
            Percent = 100.0
        };

        model.Attachments.Add(dslItem.ToDSL());
        ClearItemSelection();
        errorMessage = null;
    }

    private void AddMoney()
    {
        if (moneyValue == null || moneyValue <= 0)
            return;

        if (moneyValue > uint.MaxValue)
        {
            errorMessage = $"Money value must be between 1 and {uint.MaxValue}.";
            return;
        }

        if (totalAttachmentCount >= 54)
        {
            errorMessage = "Maximum 54 total attachments allowed (52 items + money + exp).";
            return;
        }

        var dslMoney = new Fb.Model.Dsl.Money
        {
            Value = (uint)moneyValue.Value
        };

        model.Attachments.Add(dslMoney.ToDSL());
        moneyValue = null;
        errorMessage = null;
    }

    private void AddExp()
    {
        if (expValue == null || expValue <= 0)
            return;

        if (expValue > uint.MaxValue)
        {
            errorMessage = $"Experience value must be between 1 and {uint.MaxValue}.";
            return;
        }

        if (totalAttachmentCount >= 54)
        {
            errorMessage = "Maximum 54 total attachments allowed (52 items + money + exp).";
            return;
        }

        var dslExp = new Fb.Model.Dsl.Exp
        {
            Value = (uint)expValue.Value
        };

        model.Attachments.Add(dslExp.ToDSL());
        expValue = null;
        errorMessage = null;
    }

    private void RemoveAttachment(int index)
    {
        if (index >= 0 && index < model.Attachments.Count)
            model.Attachments.RemoveAt(index);
    }

    private void ClearItemSelection()
    {
        selectedItem = null;
        itemSearchText = string.Empty;
        itemQuantity = 1;
        showItemSuggestions = false;
    }

    private bool IsBundleItem(Fb.Model.Item item) => item.Capacity > 1;

    private bool HasBundleItemInAttachments(Fb.Model.Item item)
    {
        return model.Attachments.Any(a =>
            a.Header == Fb.Model.EnumValue.Dsl.Item &&
            a.Params != null &&
            a.Params.Length > 0 &&
            (uint)a.Params[0] == item.Id);
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;

        if (!model.IsGlobal && string.IsNullOrWhiteSpace(model.UserName))
        {
            errorMessage = "User name is required for personal item grants.";
            return;
        }

        if (itemCount > 52)
        {
            errorMessage = "Maximum 52 items allowed.";
            return;
        }

        if (totalAttachmentCount > 54)
        {
            errorMessage = "Maximum 54 total attachments allowed (52 items + money + exp).";
            return;
        }

        if (model.Attachments == null || model.Attachments.Count == 0)
        {
            errorMessage = "At least one item, money, or experience must be granted.";
            return;
        }

        isProcessing = true;
        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }

            await using var scope = ScopeFactory.CreateAsyncScope();
            var storageService = scope.ServiceProvider.GetRequiredService<StorageService>();
            var dbContext = scope.ServiceProvider.GetRequiredService<DbContext>();
            if (model.IsGlobal)
            {
                var reserveUtc = model.ReserveDate?.ToUniversalTime();
                var expireUtc = model.ExpiredDate?.ToUniversalTime();
                if (reserveUtc.HasValue && reserveUtc <= DateTime.UtcNow + Http.Reepository.SystemMailRepository.EditLeadTime)
                {
                    errorMessage = "예약 시각은 지금부터 10초 이후여야 합니다.";
                    return;
                }

                if (expireUtc.HasValue && expireUtc <= (reserveUtc ?? DateTime.UtcNow))
                {
                    errorMessage = "만료일은 지급 시각 이후여야 합니다.";
                    return;
                }

                if (editingBoxId.HasValue)
                {
                    var boxId = editingBoxId.Value;
                    if (reserveUtc.HasValue == false)
                    {
                        errorMessage = "예약 지급은 예약 시각을 비울 수 없습니다. 즉시 지급하려면 예약을 취소하고 새로 지급하세요.";
                        return;
                    }

                    var edited = await dbContext.SystemStorageBox.Edit(selectedWorld.Value,
                        boxId,
                        model.Title.Trim(),
                        model.Message.Trim(),
                        model.Attachments,
                        reserveUtc.Value,
                        expireUtc,
                        model.IncludeNewCharacters);
                    if (edited == false)
                    {
                        errorMessage = "예약 시각 10초 전까지만 수정할 수 있습니다.";
                        return;
                    }

                    ActivityLog.Add(new AdminActivityEntry
                    {
                        Category = "item_grant",
                        Summary = "전체 지급 예약 수정",
                        Detail = $"#{boxId} · {model.Title} · 첨부 {model.Attachments.Count}건",
                        Target = "전체",
                        Success = true
                    });
                    LoadGrantHistory();

                    successMessage = $"예약 지급이 수정되었습니다. (System Storage ID: #{boxId})";
                }
                else
                {
                    var result = await storageService.CreateSystemStorageAsync(
                        selectedWorld.Value,
                        model.Title.Trim(),
                        model.Message.Trim(),
                        expireUtc,
                        model.Attachments,
                        externalRef: model.GrantRef,
                        reserveDate: reserveUtc,
                        includeNewCharacters: model.IncludeNewCharacters);

                    var detail = $"#{result.Id} · {model.Title} · 첨부 {model.Attachments.Count}건";
                    ActivityLog.Add(new AdminActivityEntry
                    {
                        Category = "item_grant",
                        Summary = reserveUtc.HasValue ? "전체 지급 예약" : "전체 지급",
                        Detail = detail,
                        Target = "전체",
                        Success = true
                    });
                    LoadGrantHistory();

                    successMessage = reserveUtc.HasValue
                        ? $"아이템 지급이 예약되었습니다. (System Storage ID: #{result.Id}, 전체 유저)"
                        : $"아이템 지급이 완료되었습니다. (System Storage ID: #{result.Id}, 전체 유저)";
                }

                await LoadStoredBoxes();
            }
            else
            {
                var userName = model.UserName?.Trim();
                var userId = await dbContext.Character.GetCharacterId(selectedWorld.Value, userName);
                if (userId.HasValue == false)
                {
                    errorMessage = $"Character '{userName}' not found.";
                    return;
                }

                var result = await storageService.CreateSystemStorageAsync(
                    selectedWorld.Value,
                    model.Title.Trim(),
                    model.Message.Trim(),
                    model.ExpiredDate?.ToUniversalTime(),
                    model.Attachments,
                    externalRef: model.GrantRef,
                    user: userId.Value);

                var detail = $"#{result.Id} · {model.Title} · 첨부 {model.Attachments.Count}건";
                ActivityLog.Add(new AdminActivityEntry
                {
                    Category = "item_grant",
                    Summary = "유저 지급",
                    Detail = detail,
                    Target = userName ?? "—",
                    Success = true
                });
                LoadGrantHistory();

                successMessage = $"아이템 지급이 완료되었습니다. (System Storage ID: #{result.Id}, 유저: {userName})";
            }

            ResetForm();
        }
        catch (Exception ex)
        {
            ActivityLog.Add(new AdminActivityEntry
            {
                Category = "item_grant",
                Summary = model.IsGlobal ? "전체 지급" : "유저 지급",
                Detail = ex.Message,
                Target = model.IsGlobal ? "전체" : (model.UserName ?? "—"),
                Success = false
            });
            LoadGrantHistory();
            errorMessage = editingBoxId.HasValue
                ? $"아이템 지급 중 오류: {ex.Message}"
                : $"지급 결과를 확인하지 못했습니다: {ex.Message}. 내용을 바꾸지 않고 다시 지급하면 한 번만 지급됩니다.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ResetForm()
    {
        model = new StoragePendingForm();
        model.ExpiredDate = DateTime.Today.AddDays(30);
        editingBoxId = null;
        ClearItemSelection();
        moneyValue = null;
        expValue = null;
    }

    private class StoragePendingForm
    {
        [Required]
        [StringLength(128, ErrorMessage = "Title must be 128 characters or less.")]
        public string Title { get; set; } = string.Empty;

        [Required]
        [StringLength(256, ErrorMessage = "Message must be 256 characters or less.")]
        public string Message { get; set; } = string.Empty;

        public bool IsGlobal { get; set; } = true;

        [StringLength(32, ErrorMessage = "User name must be 32 characters or less.")]
        public string UserName { get; set; }

        public Guid FormId { get; } = Guid.NewGuid();

        public string GrantRef
        {
            get
            {
                var content = Newtonsoft.Json.JsonConvert.SerializeObject(new
                {
                    IsGlobal,
                    UserName,
                    Title,
                    Message,
                    Attachments,
                    ExpiredDate,
                    ReserveDate,
                    IncludeNewCharacters
                });
                var hash = System.Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(content)));
                return $"admin:{FormId:N}:{hash[..16]}";
            }
        }

        public DateTime? ExpiredDate { get; set; }

        public DateTime? ReserveDate { get; set; }

        public bool IncludeNewCharacters { get; set; }

        public List<Fb.Model.Dsl> Attachments { get; set; } = new();
    }

}
