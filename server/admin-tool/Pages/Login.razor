@page "/login"
@layout LoginLayout
@using AdminTool.Services
@using AdminTool.Authentication
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>로그인 - FB ADMIN</PageTitle>

<div class="login-wrap">
    <div class="login-logo">FB ADMIN</div>
    <p class="login-subtitle">게임 서버 관리 콘솔</p>

    <div class="login-card card-bg">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-error" role="alert">
                @ErrorMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="server" class="form-label">서버 선택</label>
                <select id="server" class="form-select" @bind="selectedServerName" @bind:after="OnServerChanged">
                    @if (serverNames != null && serverNames.Any())
                    {
                        @foreach (var serverName in serverNames)
                        {
                            <option value="@serverName">@serverName</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-3">
                <label for="username" class="form-label">캐릭터명</label>
                <InputText id="username" class="form-control" @bind-Value="loginModel.Username"
                           placeholder="캐릭터명을 입력하세요" />
                <ValidationMessage For="@(() => loginModel.Username)" />
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">비밀번호</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password"
                           placeholder="비밀번호를 입력하세요" />
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>
            <button type="submit" class="btn-login" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                로그인
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? ErrorMessage;
    private bool isLoading = false;
    private List<string>? serverNames;
    private Dictionary<string, uint>? serverNameToWorld;
    private string selectedServerName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
        LoadServers();
    }

    private void LoadServers()
    {
        try
        {
            var worldServersSection = Configuration.GetSection("WorldServers");
            serverNameToWorld = worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .ToDictionary(
                    child => child.Value ?? child.Key,
                    child => uint.Parse(child.Key));
            serverNames = serverNameToWorld.Keys.ToList();

            if (serverNames != null && serverNames.Any())
            {
                selectedServerName = serverNames.First();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading servers: {ex.Message}");
        }
    }

    private void OnServerChanged()
    {
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        isLoading = true;

        try
        {
            if (string.IsNullOrEmpty(selectedServerName) || serverNameToWorld == null)
            {
                ErrorMessage = "서버가 선택되지 않았습니다.";
                return;
            }

            if (!serverNameToWorld.TryGetValue(selectedServerName, out var world))
            {
                ErrorMessage = "잘못된 서버 선택입니다.";
                return;
            }

            var result = await AuthService.Authenticate(world, loginModel.Username, loginModel.Password);
            if (result.Success && result.UserId.HasValue && result.Role.HasValue)
            {
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    var authData = new AuthData
                    {
                        UserId = result.UserId.Value,
                        UserName = result.UserName,
                        Role = result.Role.Value.ToString(),
                        LoginWorld = world
                    };
                    await customProvider.MarkUserAsAuthenticated(authData);
                }
                Navigation.NavigateTo("/");
            }
            else
            {
                ErrorMessage = result.Error ?? "로그인에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "캐릭터명을 입력하세요")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "비밀번호를 입력하세요")]
        public string Password { get; set; } = string.Empty;
    }
}
