@page "/login"
@using AdminTool.Services
@using AdminTool.Authentication
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Login - Admin Tool</PageTitle>

<div class="login-container">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-5 col-lg-4">
                <div class="text-center mb-4">
                    <h1 class="mb-2">Admin Tool</h1>
                    <p class="text-muted">Sign in to access the administration panel</p>
                </div>
                <div class="card">
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @ErrorMessage
                                <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
                            </div>
                        }

                        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label for="server" class="form-label">Server</label>
                                <select id="server" class="form-select" @bind="selectedServerName" @bind:after="OnServerChanged">
                                    @if (serverNames != null && serverNames.Any())
                                    {
                                        @foreach (var serverName in serverNames)
                                        {
                                            <option value="@serverName">@serverName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="username" class="form-label">Character Name</label>
                                <InputText id="username" class="form-control" @bind-Value="loginModel.Username"
                                           placeholder="Enter your character name" />
                                <ValidationMessage For="@(() => loginModel.Username)" />
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label">Password</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password"
                                           placeholder="Enter your password" />
                                <ValidationMessage For="@(() => loginModel.Password)" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                Sign In
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? ErrorMessage;
    private bool isLoading = false;
    private List<string>? serverNames;
    private Dictionary<string, uint>? serverNameToWorld;
    private string selectedServerName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
        LoadServers();
    }

    private void LoadServers()
    {
        try
        {
            var worldServersSection = Configuration.GetSection("WorldServers");
            serverNameToWorld = worldServersSection.GetChildren()
                .Where(child => uint.TryParse(child.Key, out _))
                .ToDictionary(
                    child => child.Value ?? child.Key,
                    child => uint.Parse(child.Key));
            serverNames = serverNameToWorld.Keys.ToList();

            if (serverNames != null && serverNames.Any())
            {
                selectedServerName = serverNames.First();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading servers: {ex.Message}");
        }
    }

    private void OnServerChanged()
    {
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        isLoading = true;

        try
        {
            if (string.IsNullOrEmpty(selectedServerName) || serverNameToWorld == null)
            {
                ErrorMessage = "Server is not selected.";
                return;
            }

            if (!serverNameToWorld.TryGetValue(selectedServerName, out var world))
            {
                ErrorMessage = "Invalid server selection.";
                return;
            }

            var result = await AuthService.Authenticate(world, loginModel.Username, loginModel.Password);
            if (result.Success && result.UserId.HasValue && result.Role.HasValue)
            {
                // Update authentication state
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    var authData = new AuthData
                    {
                        UserId = result.UserId.Value,
                        UserName = result.UserName,
                        Role = result.Role.Value.ToString(),
                        LoginWorld = world
                    };
                    await customProvider.MarkUserAsAuthenticated(authData);
                }
                Navigation.NavigateTo("/");
            }
            else
            {
                ErrorMessage = result.Error;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Character name is required")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }
}

