@page "/users"
@using AdminTool.Services
@using AdminTool.Authentication
@using Http.Service
@using Http.Model
@using Fb.Model.EnumValue
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using Response = fb.protocol._internal.response
@inject UserService UserService
@inject BanService BanService
@inject DbContext DbContext
@inject RabbitMqService RabbitMqService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SecurityService SecurityService
@inject LogService LogService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@attribute [AuthorizeRole(Role.Admin)]

<PageTitle>유저 관리 - FB ADMIN</PageTitle>

<div>
    <div class="page-header">
        <h1>유저 관리</h1>
        <p>계정 검색 및 관리</p>
    </div>

    <div class="card-bg filter-toolbar">
        <div class="filter-toolbar-left">
            <div class="stitch-search-wrap">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input type="text" id="searchInput" class="stitch-search"
                       placeholder="UID 또는 유저명 검색" @bind="searchTerm"
                       @bind:event="oninput" @onkeypress="HandleKeyPress" />
            </div>
            <select class="stitch-select" @bind="statusFilter">
                <option value="all">상태: 전체</option>
                <option value="online">온라인</option>
                <option value="offline">오프라인</option>
                <option value="banned">밴</option>
            </select>
            <select class="stitch-select" @bind="roleFilter">
                <option value="all">역할: 전체</option>
                <option value="user">일반 유저</option>
                <option value="staff">관리자</option>
            </select>
        </div>
        <div class="filter-toolbar-right">
            <button class="stitch-btn stitch-btn-neutral" type="button" @onclick="ClearSearch" disabled="@isLoading">
                초기화
            </button>
            <button class="stitch-btn stitch-btn-primary" type="button" @onclick="SearchUsers" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                검색
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">불러오는 중...</span>
            </div>
            <p class="text-muted mt-3">유저 목록을 불러오는 중...</p>
        </div>
    }
    else if (userList?.Users != null && FilteredUsers.Any())
    {
        <div class="card-bg data-table-card">
            <div class="dash-table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th style="width:3rem;">#</th>
                            <th>유저명</th>
                            <th>UID</th>
                            <th style="text-align:right;width:4rem;">레벨</th>
                            <th>역할</th>
                            <th>상태</th>
                            <th>최근접속</th>
                            <th style="text-align:right;">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int userIndex = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td class="table-meta">@userIndex</td>
                                <td style="@(user.IsBanned ? "opacity:0.5;" : "")">
                                    <a href="/users/@user.Id" class="user-name-link">@user.Name</a>
                                </td>
                                <td class="table-meta" style="@(user.IsBanned ? "opacity:0.5;" : "")">@user.Id</td>
                                <td style="text-align:right;">@user.Level</td>
                                <td class="table-meta">@FormatRole(user.Role)</td>
                                <td>
                                    <div class="table-status">
                                        @if (user.IsBanned)
                                        {
                                            <span class="table-status-dot banned"></span>
                                            <span>밴</span>
                                        }
                                        else if (user.IsOnline)
                                        {
                                            <span class="table-status-dot online"></span>
                                            <span>온라인</span>
                                        }
                                        else
                                        {
                                            <span class="table-status-dot offline"></span>
                                            <span>오프라인</span>
                                        }
                                    </div>
                                </td>
                                <td class="table-meta">@user.UpdatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/users/@user.Id" class="text-link">상세</a>
                                        <button class="text-link"
                                                title="@GetChangeRoleButtonTitle(user)"
                                                @onclick="() => ShowChangeRoleModal(user)"
                                                disabled="@isProcessing">역할</button>
                                        @if (user.IsBanned)
                                        {
                                            <button class="text-link" @onclick="() => ShowUnbanModal(user)"
                                                disabled="@isProcessing">밴 해제</button>
                                        }
                                        else
                                        {
                                            <button class="text-link" @onclick="() => ShowBanModal(user)"
                                                disabled="@isProcessing">밴</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            userIndex++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (userList.TotalPages > 1)
        {
            <div class="page-footer-bar">
                <div>
                    @((currentPage - 1) * pageSize + 1) ~ @(Math.Min(currentPage * pageSize, userList.TotalCount)) / @(userList.TotalCount)명
                </div>
                <nav>
                    <ul class="stitch-pagination">
                        <li>
                            <a class="stitch-page-btn @(currentPage <= 1 ? "disabled" : "")" href="#"
                               @onclick="() => ChangePage(currentPage - 1)" @onclick:preventDefault>
                                <span class="material-symbols-outlined" style="font-size:1.125rem;">chevron_left</span>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(userList.TotalPages, currentPage + 2); i++)
                        {
                            var pageNum = i;
                            <li>
                                <a class="stitch-page-btn @(currentPage == pageNum ? "active" : "")" href="#"
                                   @onclick="() => ChangePage(pageNum)" @onclick:preventDefault>@pageNum</a>
                            </li>
                        }
                        <li>
                            <a class="stitch-page-btn @(currentPage >= userList.TotalPages ? "disabled" : "")" href="#"
                               @onclick="() => ChangePage(currentPage + 1)" @onclick:preventDefault>
                                <span class="material-symbols-outlined" style="font-size:1.125rem;">chevron_right</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else if (!isLoading && userList?.Users != null && userList.Users.Any())
    {
        <div class="card-bg dash-card">
            <p class="dash-empty">필터 조건에 맞는 유저가 없습니다.</p>
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-info">
            유저를 찾을 수 없습니다.
        </div>
    }
</div>

<!-- Ban Modal -->
@if (showBanModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">유저 밴: @selectedUser?.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseBanModal"></button>
            </div>
            <div class="stitch-modal-body">
                    <EditForm Model="@banModel" OnValidSubmit="@HandleBan">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="banReason" class="form-label">사유</label>
                            <InputTextArea id="banReason" class="form-control" rows="3" @bind-Value="banModel.Reason" />
                            <ValidationMessage For="@(() => banModel.Reason)" />
                        </div>
                        <div class="mb-3">
                            <label for="banDays" class="form-label">밴 기간</label>
                            <InputSelect id="banDays" class="form-select" @bind-Value="banModel.Days">
                                <option value="">영구</option>
                                <option value="7">7일</option>
                                <option value="15">15일</option>
                                <option value="30">30일</option>
                            </InputSelect>
                        </div>
                        <div class="stitch-modal-footer">
                            <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseBanModal">취소</button>
                            <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                밴 처리
                            </button>
                        </div>
                    </EditForm>
            </div>
        </div>
    </div>
}

<!-- Unban Modal -->
@if (showUnbanModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">밴 해제: @selectedUser?.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseUnbanModal"></button>
            </div>
            <div class="stitch-modal-body">
                <p>이 유저의 밴을 해제하시겠습니까?</p>
                @if (selectedUser != null && !string.IsNullOrEmpty(selectedUser.BanReason))
                {
                    <p><strong>현재 밴 사유:</strong> @selectedUser.BanReason</p>
                }
                <div class="stitch-modal-footer">
                    <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseUnbanModal">취소</button>
                    <button type="button" class="stitch-btn stitch-btn-primary" @onclick="HandleUnban" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        밴 해제
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Change Role Modal -->
@if (showChangeRoleModal)
{
    <div class="stitch-modal-backdrop" tabindex="-1">
        <div class="stitch-modal" @onclick:stopPropagation="true">
            <div class="stitch-modal-header">
                <h2 class="stitch-modal-title">역할 변경: @selectedUser?.Name</h2>
                <button type="button" class="btn-close" @onclick="CloseChangeRoleModal"></button>
            </div>
            <div class="stitch-modal-body">
                <EditForm Model="@roleModel" OnValidSubmit="@HandleChangeRole">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="currentRole" class="form-label">현재 역할</label>
                        <input type="text" class="form-control" id="currentRole"
                            value="@((Role)(selectedUser?.Role ?? (byte)Role.User))" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="newRole" class="form-label">새 역할</label>
                        <InputSelect id="newRole" class="form-select" @bind-Value="roleModel.NewRoleString">
                            @foreach (var role in GetAvailableRoles())
                            {
                                <option value="@((int)role)">@role</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => roleModel.NewRoleString)" />
                    </div>
                    @if (ShouldPromptForElevationSecret())
                    {
                        <div class="mb-3">
                            <label for="elevationSecret" class="form-label">승격 비밀키</label>
                            <InputText id="elevationSecret" type="password" class="form-control"
                                       @bind-Value="roleModel.SecretKey" />
                            <small class="text-muted">@GetElevationSecretMessage()</small>
                        </div>
                    }
                    <div class="stitch-modal-footer">
                        <button type="button" class="stitch-btn stitch-btn-neutral" @onclick="CloseChangeRoleModal">취소</button>
                        <button type="submit" class="stitch-btn stitch-btn-primary" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            역할 변경
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "SelectedWorld")]
    private uint? selectedWorld { get; set; }
    private UserListResult? userList;
    private string searchTerm = string.Empty;
    private string statusFilter = "all";
    private string roleFilter = "all";
    private int currentPage = 1;
    private const int pageSize = 20;
    private bool isLoading = false;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;

    private bool showBanModal = false;
    private bool showUnbanModal = false;
    private bool showChangeRoleModal = false;
    private UserListItem? selectedUser;
    private BanModel banModel = new();
    private RoleModel roleModel = new();
    private Role currentUserRole = Role.User;
    private uint currentUserId = 0;
    private uint? loginWorld = null;
    private uint? _lastLoadedWorld = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserRole();
        SyncFromUrl();
    }

    protected override async Task OnParametersSetAsync()
    {
        SyncFromUrl();
        if (selectedWorld.HasValue && selectedWorld.Value != _lastLoadedWorld)
        {
            _lastLoadedWorld = selectedWorld.Value;
            await LoadUsers();
            UpdateUsersUrl();
        }
    }

    private async Task LoadCurrentUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var roleClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role);
            var idClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            var loginWorldClaim = authState.User.FindFirst(CustomAuthenticationStateProvider.LoginWorldClaimType);
            if (idClaim != null && uint.TryParse(idClaim.Value, out var uid))
            {
                currentUserId = uid;
            }
            if (roleClaim != null && Enum.TryParse<Role>(roleClaim.Value, out var role))
            {
                currentUserRole = role;
            }
            if (loginWorldClaim != null && uint.TryParse(loginWorldClaim.Value, out var world))
            {
                loginWorld = world;
            }
        }
    }

    /// <summary>
    /// True when the user is the logged-in user on the same world (avoids cross-world ID collision).
    /// </summary>
    private bool IsSelfUser(UserListItem user)
    {
        return user.Id == currentUserId
            && loginWorld.HasValue
            && selectedWorld.HasValue
            && selectedWorld.Value == loginWorld.Value;
    }

    private bool CanModifyUser(UserListItem user)
    {
        var userRole = (Role)user.Role;
        return userRole < currentUserRole;
    }

    private bool RequiresElevationForTarget(UserListItem user)
    {
        if (IsSelfUser(user))
            return false;

        return !CanModifyUser(user);
    }

    private bool SelectedRoleExceedsCurrent()
    {
        if (!int.TryParse(roleModel?.NewRoleString, out var newRoleInt) || !Enum.IsDefined(typeof(Role), newRoleInt))
            return false;

        var newRole = (Role)newRoleInt;
        return newRole > currentUserRole;
    }

    private bool ShouldPromptForElevationSecret()
    {
        if (selectedUser == null)
            return false;

        return RequiresElevationForTarget(selectedUser) || SelectedRoleExceedsCurrent();
    }

    private string GetElevationSecretMessage()
    {
        if (selectedUser == null)
            return string.Empty;

        if (RequiresElevationForTarget(selectedUser))
            return "Target user has an equal or higher role. Provide the elevation secret to proceed.";

        if (SelectedRoleExceedsCurrent())
            return "Assigning a role higher than your own requires the elevation secret.";

        return "Provide the elevation secret to continue.";
    }

    private string GetChangeRoleButtonTitle(UserListItem user)
    {
        if (IsSelfUser(user))
            return "Modify your own role. The elevation secret is required only for promotions.";

        return RequiresElevationForTarget(user)
            ? "Requires elevation secret to modify this user."
            : "Change user role";
    }

    private List<Role> GetAvailableRoles()
    {
        return Enum.GetValues<Role>().ToList();
    }

    private void SyncFromUrl()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (uri.AbsolutePath != "/users")
                return;
            var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (queryParams.TryGetValue("search", out var searchValue))
                searchTerm = searchValue.ToString() ?? string.Empty;
            if (queryParams.TryGetValue("page", out var pageValue) && int.TryParse(pageValue, out var page) && page >= 1)
                currentPage = page;
        }
        catch { /* ignore URL parse errors */ }
    }

    private void UpdateUsersUrl()
    {
        try
        {
            var query = new Dictionary<string, string?>();
            if (selectedWorld.HasValue)
                query["world"] = selectedWorld.Value.ToString();
            if (!string.IsNullOrWhiteSpace(searchTerm))
                query["search"] = searchTerm;
            if (currentPage > 1)
                query["page"] = currentPage.ToString();
            var url = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/users", query);
            Navigation.NavigateTo(url);
        }
        catch { /* ignore */ }
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                return;
            }
            userList = await UserService.GetUsers(selectedWorld.Value, currentPage, pageSize, string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchUsers()
    {
        currentPage = 1;
        await LoadUsers();
        UpdateUsersUrl();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadUsers();
        UpdateUsersUrl();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsers();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= (userList?.TotalPages ?? 1))
        {
            currentPage = page;
            await LoadUsers();
            UpdateUsersUrl();
        }
    }

    private void ShowBanModal(UserListItem user)
    {
        selectedUser = user;
        banModel = new BanModel();
        showBanModal = true;
    }

    private void CloseBanModal()
    {
        showBanModal = false;
        selectedUser = null;
        banModel = new BanModel();
    }

    private void ShowUnbanModal(UserListItem user)
    {
        selectedUser = user;
        showUnbanModal = true;
    }

    private void CloseUnbanModal()
    {
        showUnbanModal = false;
        selectedUser = null;
    }

    private void ShowChangeRoleModal(UserListItem user)
    {
        selectedUser = user;
        roleModel = new RoleModel
        {
            NewRoleString = ((int)user.Role).ToString(),
            SecretKey = string.Empty
        };
        showChangeRoleModal = true;
    }

    private void CloseChangeRoleModal()
    {
        showChangeRoleModal = false;
        selectedUser = null;
        roleModel = new RoleModel();
    }

    private async Task HandleChangeRole()
    {
        if (selectedUser == null)
            return;

        var targetRole = (Role)selectedUser.Role;
        var isSelf = IsSelfUser(selectedUser);

        if (!selectedWorld.HasValue)
        {
            errorMessage = "World is not selected.";
            CloseChangeRoleModal();
            return;
        }
        if (await UserService.IsOnline(selectedWorld.Value, selectedUser.Name))
        {
            errorMessage = "Cannot change role while the user is online. Please try again after they log out.";
            CloseChangeRoleModal();
            return;
        }

        if (!int.TryParse(roleModel.NewRoleString, out var newRoleInt) || !Enum.IsDefined(typeof(Role), newRoleInt))
        {
            errorMessage = "Invalid role selected.";
            CloseChangeRoleModal();
            return;
        }

        var newRole = (Role)newRoleInt;

        var hasStandardPrivilege = (targetRole < currentUserRole || isSelf) && newRole <= currentUserRole;
        if (!hasStandardPrivilege)
        {
            var providedSecret = roleModel.SecretKey?.Trim();
            if (string.IsNullOrWhiteSpace(providedSecret))
            {
                errorMessage = "Elevation secret is required for this operation.";
                return;
            }

            if (!SecurityService.IsValidElevationSecret(providedSecret))
            {
                errorMessage = "Elevation secret is invalid.";
                return;
            }
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                CloseChangeRoleModal();
                return;
            }
            var character = await DbContext.Character.Get(selectedWorld.Value, selectedUser.Id);
            if (character == null)
            {
                errorMessage = "Character not found.";
                CloseChangeRoleModal();
                return;
            }

            var oldRole = character.Role;
            character.Role = newRole;
            character.UpdatedDate = DateTime.Now;
            DbContext.Character.Set(selectedWorld.Value, character);
            await DbContext.SaveChangesAsync();

            // Log role change event
            await LogService.WriteAsync("role_change", new
            {
                target_account_name = character.Name,
                target_uid = character.Id,
                old_role = oldRole.ToString(),
                new_role = newRole.ToString(),
                changer_uid = currentUserId,
                is_self = isSelf
            });

            if (isSelf)
            {
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    var authData = new AuthData
                    {
                        UserId = currentUserId,
                        UserName = character.Name,
                        Role = newRole.ToString(),
                        LoginWorld = loginWorld
                    };
                    await customProvider.MarkUserAsAuthenticated(authData);
                }
                currentUserRole = newRole;
            }

            successMessage = $"User {selectedUser.Name}'s role has been changed to {newRole} successfully.";
            CloseChangeRoleModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error changing role: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleBan()
    {
        if (selectedUser == null)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            uint? days = null;
            if (!string.IsNullOrWhiteSpace(banModel.Days) && uint.TryParse(banModel.Days, out var parsedDays))
            {
                days = parsedDays;
            }

            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                CloseBanModal();
                return;
            }
            var result = await BanService.Ban(selectedWorld.Value, selectedUser.Name, banModel.Reason, days);
            await DbContext.SaveChangesAsync();

            // Publish notification via RabbitMQ
            var response = new Response.Ban
            {
                Name = selectedUser.Name,
                Reason = banModel.Reason,
                ExpireDate = result.ExpireDate?.ToString("yyyy-MM-dd HH:mm:ss"),
                Error = (uint)result.Error
            };
            await RabbitMqService.PublishAsync(response, "amq.direct", $"fb.{selectedWorld.Value}.ban");

            successMessage = $"User {selectedUser.Name} has been banned successfully.";
            CloseBanModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error banning user: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleUnban()
    {
        if (selectedUser == null)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (!selectedWorld.HasValue)
            {
                errorMessage = "World is not selected.";
                CloseUnbanModal();
                return;
            }
            var result = await BanService.Unban(selectedWorld.Value, selectedUser.Name);
            await DbContext.SaveChangesAsync();

            // Publish notification via RabbitMQ
            var response = new Response.Unban
            {
                Name = selectedUser.Name,
                Error = (uint)result.Error
            };
            await RabbitMqService.PublishAsync(response, "amq.direct", $"fb.{selectedWorld.Value}.unban");

            successMessage = $"User {selectedUser.Name} has been unbanned successfully.";
            CloseUnbanModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error unbanning user: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private IEnumerable<UserListItem> FilteredUsers
    {
        get
        {
            if (userList?.Users == null)
                return Enumerable.Empty<UserListItem>();

            IEnumerable<UserListItem> query = userList.Users;

            if (statusFilter == "online")
                query = query.Where(u => !u.IsBanned && u.IsOnline);
            else if (statusFilter == "offline")
                query = query.Where(u => !u.IsBanned && !u.IsOnline);
            else if (statusFilter == "banned")
                query = query.Where(u => u.IsBanned);

            if (roleFilter == "user")
                query = query.Where(u => u.Role == (byte)Role.User);
            else if (roleFilter == "staff")
                query = query.Where(u => u.Role >= (byte)Role.Moderator);

            return query;
        }
    }

    private static string FormatRole(byte role) => ((Role)role) switch
    {
        Role.User => "일반 유저",
        Role.Moderator => "모더레이터",
        Role.Admin => "관리자",
        Role.Superadmin => "슈퍼관리자",
        Role.Owner => "오너",
        _ => role.ToString()
    };

    private class BanModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ban reason is required")]
        public string Reason { get; set; } = string.Empty;

        public string? Days { get; set; }
    }


    private class RoleModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Role is required")]
        public string NewRoleString { get; set; } = "0";

        public string SecretKey { get; set; } = string.Empty;
    }
