@page "/users"
@using AdminTool.Services
@using Http.Service
@using Http.Model
@using Fb.Model.EnumValue
@using Microsoft.AspNetCore.Authorization
@using Response = fb.protocol._internal.response
@inject UserService UserService
@inject BanService BanService
@inject DbContext DbContext
@inject RabbitMqService RabbitMqService
@attribute [Authorize(Roles = "Admin,Operator")]

<PageTitle>Users - Admin Tool</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>User Management</h2>
        </div>
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search by name..." @bind="searchTerm" @bind:event="oninput" @onkeypress="HandleKeyPress" />
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchUsers" disabled="@isLoading">
                    <span class="oi oi-magnifying-glass" aria-hidden="true"></span> Search
                </button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" disabled="@isLoading">
                    Clear
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (userList?.Users != null && userList.Users.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Level</th>
                        <th>Money</th>
                        <th>Ban Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in userList.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Name</td>
                            <td>@((Role)user.Role)</td>
                            <td>@user.Level</td>
                            <td>@user.Money.ToString("N0")</td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-danger">
                                        Banned
                                        @if (user.BanExpireDate.HasValue)
                                        {
                                            <span>(Until @user.BanExpireDate.Value.ToString("yyyy-MM-dd"))</span>
                                        }
                                        else
                                        {
                                            <span>(Permanent)</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>@user.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => ShowUnbanModal(user)" disabled="@isProcessing">
                                        Unban
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => ShowBanModal(user)" disabled="@isProcessing">
                                        Ban
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (userList.TotalPages > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="#" @onclick="() => ChangePage(currentPage - 1)" @onclick:preventDefault>Previous</a>
                    </li>
                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(userList.TotalPages, currentPage + 2); i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <a class="page-link" href="#" @onclick="() => ChangePage(pageNum)" @onclick:preventDefault>@pageNum</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= userList.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="#" @onclick="() => ChangePage(currentPage + 1)" @onclick:preventDefault>Next</a>
                    </li>
                </ul>
            </nav>
        }

        <div class="text-center text-muted">
            Showing @((currentPage - 1) * pageSize + 1) to @(Math.Min(currentPage * pageSize, userList.TotalCount)) of @userList.TotalCount users
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-info">
            No users found.
        </div>
    }
</div>

<!-- Ban Modal -->
@if (showBanModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ban User: @selectedUser?.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseBanModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@banModel" OnValidSubmit="@HandleBan">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="banReason" class="form-label">Reason</label>
                            <InputTextArea id="banReason" class="form-control" rows="3" @bind-Value="banModel.Reason" />
                            <ValidationMessage For="@(() => banModel.Reason)" />
                        </div>
                        <div class="mb-3">
                            <label for="banDays" class="form-label">Ban Duration</label>
                            <InputSelect id="banDays" class="form-select" @bind-Value="banModel.Days">
                                <option value="">Permanent</option>
                                <option value="7">7 Days</option>
                                <option value="15">15 Days</option>
                                <option value="30">30 Days</option>
                            </InputSelect>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseBanModal">Cancel</button>
                            <button type="submit" class="btn btn-danger" disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Ban User
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Unban Modal -->
@if (showUnbanModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Unban User: @selectedUser?.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseUnbanModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to unban this user?</p>
                    @if (selectedUser != null && !string.IsNullOrEmpty(selectedUser.BanReason))
                    {
                        <p><strong>Current ban reason:</strong> @selectedUser.BanReason</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUnbanModal">Cancel</button>
                    <button type="button" class="btn btn-success" @onclick="HandleUnban" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Unban User
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private UserListResult? userList;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private const int pageSize = 20;
    private bool isLoading = false;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;

    private bool showBanModal = false;
    private bool showUnbanModal = false;
    private UserListItem? selectedUser;
    private BanModel banModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            userList = await UserService.GetUsers(currentPage, pageSize, string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchUsers()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadUsers();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchUsers();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= (userList?.TotalPages ?? 1))
        {
            currentPage = page;
            await LoadUsers();
        }
    }

    private void ShowBanModal(UserListItem user)
    {
        selectedUser = user;
        banModel = new BanModel();
        showBanModal = true;
    }

    private void CloseBanModal()
    {
        showBanModal = false;
        selectedUser = null;
        banModel = new BanModel();
    }

    private void ShowUnbanModal(UserListItem user)
    {
        selectedUser = user;
        showUnbanModal = true;
    }

    private void CloseUnbanModal()
    {
        showUnbanModal = false;
        selectedUser = null;
    }

    private async Task HandleBan()
    {
        if (selectedUser == null)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            uint? days = null;
            if (!string.IsNullOrWhiteSpace(banModel.Days) && uint.TryParse(banModel.Days, out var parsedDays))
            {
                days = parsedDays;
            }

            var result = await BanService.BanUser(selectedUser.Name, banModel.Reason, days);
            await DbContext.SaveChangesAsync();

            // Publish notification via RabbitMQ
            var response = new Response.Ban
            {
                Name = selectedUser.Name,
                Reason = banModel.Reason,
                ExpireDate = result.ExpireDate?.ToString("yyyy-MM-dd HH:mm:ss"),
                Error = (uint)result.Error
            };
            RabbitMqService.Publish(response, "amq.direct", "fb.ban");

            successMessage = $"User {selectedUser.Name} has been banned successfully.";
            CloseBanModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error banning user: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleUnban()
    {
        if (selectedUser == null)
            return;

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await BanService.UnbanUser(selectedUser.Name);
            await DbContext.SaveChangesAsync();

            // Publish notification via RabbitMQ
            var response = new Response.Unban
            {
                Name = selectedUser.Name,
                Error = (uint)result.Error
            };
            RabbitMqService.Publish(response, "amq.direct", "fb.unban");

            successMessage = $"User {selectedUser.Name} has been unbanned successfully.";
            CloseUnbanModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error unbanning user: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class BanModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ban reason is required")]
        public string Reason { get; set; } = string.Empty;

        public string? Days { get; set; }
    }
}

