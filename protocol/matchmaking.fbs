namespace fb.protocol.matchmaking;

table TicketMember {
    world: uint;
    character_id: uint;
    mu: double;
    sigma: double;
}

table Ticket {
    ticket_id: ulong;
    members: [TicketMember];
}

table MatchTeam {
    tickets: [Ticket];
}

table TicketOutcome {
    ticket_id: ulong;
    outcome: ubyte;
    members: [TicketMember];
}
