namespace fb.protocol.marketplace;

table Item {
    owner: uint;
    model: uint;
    count: ushort;
    durability: uint?;
    custom_name: string?;
}

table Listing {
    id: string;
    seller_id: uint;
    item: Item;
    price: uint;
    listing_fee: uint;
    transaction_fee: uint;
    expire_date: string;
    created_date: string;
}

table SearchResult {
    listings: [Listing];
    total_count: uint;
    page: uint;
}

