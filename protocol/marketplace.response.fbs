include "marketplace.fbs";

namespace fb.protocol.marketplace.response;

table AllocateListingId {
    listing_id: string;
    error: uint;
}

table List {
    listing_id: string;
    error: uint;
}

table Cancel {
    error: uint;
}

table Purchase {
    item: fb.protocol.marketplace.Item;
    error: uint;
}

table Search {
    result: fb.protocol.marketplace.SearchResult;
    error: uint;
}

table GetListings {
    listings: [fb.protocol.marketplace.Listing];
    error: uint;
}

