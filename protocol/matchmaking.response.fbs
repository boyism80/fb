include "matchmaking.fbs";

namespace fb.protocol.matchmaking.response;

table Enqueue {
    ticket_id: ulong;
    error: uint;
}

table Dequeue {
    success: bool;
    error: uint;
}

table Confirm {
    error: uint;
    match_ready: bool;
}

table Decline {
    error: uint;
}

table Status {
    queued: bool;
    match_type: uint;
    ticket_id: ulong;
    pending_match_id: ulong;
    confirm_deadline: string;
    error: uint;
}
