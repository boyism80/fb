namespace fb.protocol.internal;

enum Service : byte {
    Gateway,
    Login,
    Game
}

enum GroupActionType : byte {
    Enter = 0,
    Leave = 1,
    Kick = 2
}

enum GroupDetailsAction : byte {
    Query = 0,
    Create = 1
}

table Position {
    x: ushort;
    y: ushort;
}

table Mimicry {
    gender: ubyte;
    state: ubyte?;
    hair: ushort;
    hair_color: ubyte?;
    weapon: ushort?;
    weapon_color: ubyte?;
    armor: ubyte?;
    armor_color: ubyte?;
    shield: ubyte?;
    shield_color: ubyte?;
    disguise: ushort?;
}

table Character {
    id: uint;
    name: string;
    pw: string;
    birth: uint?;
    role: ubyte;
    look: ushort;
    color: ushort;
    gender: ubyte;
    nation: ubyte;
    creature: ubyte;
    map: uint;
    position: Position;
    direction: ubyte;
    state: ubyte;
    class_type: ubyte;
    promotion: ubyte;
    level: ubyte;
    exp: ulong;
    money: ulong;
    deposited_money: ulong;
    mimicry: Mimicry?;
    hp: ulong;
    base_hp: ulong;
    additional_hp: ulong;
    mp: ulong;
    base_mp: ulong;
    additional_mp: ulong;
    weapon_color: ubyte?;
    helmet_color: ubyte?;
    armor_color: ubyte?;
    shield_color: ubyte?;
    ring_left_color: ubyte?;
    ring_right_color: ubyte?;
    aux_top_color: ubyte?;
    aux_bot_color: ubyte?;
    buffs: [Buff];
    title: string;
    created_date: string;
    updated_date: string;
    first_login_date: string?;
    super_hide: bool = false;
    speed: ubyte = 0;
}

table Marriage {
    spouse_id: uint?;
    spouse_name: string = "";
    remarriage_after: string = "";
    divorce_count: uint = 0;
}

table Item {
    user: uint;
    index: short;
    parts: short;
    stored: short;
    model: uint;
    count: ushort;
    durability: uint?;
    custom_name: string?;
    expire_time: string?;
}

table Spell {
    user: uint;
    slot: ubyte;
    model: uint;
    next: string;
}

table MatchmakingSkill {
    user: uint;
    match_type: uint;
    mu: double;
    sigma: double;
}

table Buff
{
    model: uint;
    time: uint;
}

table Option {
    uid: uint;
    whisper: bool;
    group: bool;
    roar: bool;
    news: bool;
    magic_effect: bool;
    weather_effect: bool;
    fixed_move: bool;
    trade: bool;
    fast_move: bool;
    effect_sound: bool;
    pk_protect: bool;
}

table ArticleSummary {
    id: uint;
    user: uint;
    user_name: string;
    title: string;
    created_date: string;
}

table Article {
    id: uint;
    user: uint;
    user_name: string;
    title: string;
    contents: string;
    created_date: string;
}

table MailSummary {
    id: ushort;
    user: uint;
    sender: string;
    read: bool;
    title: string;
    created_date: string;
}

table Mail {
    id: ushort;
    user: uint;
    sender: string;
    title: string;
    contents: string;
    read: bool;
    created_date: string;
    system_mail_id: uint?;
}

table MailWriteEntry {
    user: uint;
    mail: Mail;
    unread: ushort;
}

table Group {
    id: uint;
    master: string;
    members: [string];
}

table Achievement {
    user: uint;
    model: uint;
    text: string;
    icon: ubyte;
    color: ushort;
}

table Clan {
    id: uint;
    name: string;
    title: string?;
}

table ClanMember {
    uid: uint;
    name: string;
    role: uint;
}

table CharacterRef {
    uid: uint;
    name: string;
}

enum ClanActionType : byte {
    Join = 0,
    Leave = 1,
    Kick = 2,
    ChangeRole = 3,
    SetTitle = 4
}

enum ClanDetailsAction : byte {
    Query = 0,
    Create = 1
}

table Quest {
    uid: uint;
    qid: uint;
    step: uint;
    progress: uint;
    param: string;
    completed: bool;
}

table MarketplacePending {
    user: uint;
    pending_key: string;
    type: ubyte;
    purchase_id: string;
    listing_id: string;
    attachments: string;
    expected_purchase_count: ushort;
    expected_total_price: ulong;
    character_id: uint;
}

table SystemMail {
    id: uint;
    sender: uint;
    title: string;
    contents: string;
    expire_date: string?;
    created_date: string;
}

table StorageBox {
    user: uint;
    id: uint;
    system_storage_box_id: uint;
    title: string;
    message: string;
    attachments: string;
    received: bool;
    expired_date: string?;
}

table StorageWriteEntry {
    user: uint;
    box: StorageBox;
}

table SystemStorageBox {
    id: uint;
    title: string;
    message: string;
    attachments: string;
    expired_date: string?;
    external_ref: string?;
    created_date: string;
}

/// Full save payload for a single character (world is supplied by the request).
table SavePayload {
    character: Character;
    marriage: Marriage;
    items: [Item];
    spells: [Spell];
    matchmaking_skills: [MatchmakingSkill];
    achievements: [Achievement];
    quests: [Quest];
    marketplace_pendings: [MarketplacePending];
}