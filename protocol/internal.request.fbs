include "internal.fbs";

namespace fb.protocol.internal.request;

table Shutdown {
  
}

table Login {
  world: uint;
  uid: uint;
  name: string;
  host: ubyte;
  force: bool;
}


table Logout {
  world: uint;
  name: string;
}


table Transfer {
  world: uint;
  service: fb.protocol.internal.Service;
  id: ubyte;
  name: string?;
  force_shutdown: bool;
}


table Whisper {
  world: uint;
  from: string;
  to: string;
  message: string;
}


table KickOut {
  world: uint;
  uid: uint;
}

table Account {
  world: uint;
  uid: uint;
}


table ChangePw {
  world: uint;
  uid: uint;
  before: string;
  after: string;
  birthday: uint;
}


table InitCharacter {
  world: uint;
  uid: uint;
  name: string;
  pw: string;
  hp: ulong;
  mp: ulong;
  map: ushort;
  x: ushort;
  y: ushort;
  role: ubyte;
}

table Authenticate {
  world: uint;
  uid: uint;
  pw: string;
}


table Init {
  world: uint;
  uid: uint;
}


table MakeCharacter {
  world: uint;
  uid: uint;
  hair: ushort;
  gender: ubyte;
  nation: ubyte;
  creature: ubyte;
}


table ReserveName {
  world: uint;
  name: string;
}


table Save {
  world: uint;
  payload: fb.protocol.internal.SavePayload;
}

/// Bulk save: multiple characters in one request (same world).
table SaveBatch {
  world: uint;
  characters: [fb.protocol.internal.SavePayload];
}


table WriteArticle {
  world: uint;
  section: uint;
  user: uint;
  title: string;
  contents: string;
}


table DeleteArticle {
  world: uint;
  id: uint;
  section: uint;
  user: uint;
}

table WriteMail {
  world: uint;
  sender: uint;
  user: string;
  title: string;
  contents: string;
  host: uint;
}

/// Bulk mail write: same title/contents to multiple users by user id.
table WriteMails {
  world: uint;
  sender: uint;
  users: [uint];
  title: string;
  contents: string;
  host: uint;
}

/// Idempotent system mail delivery to multiple users (skips if already received).
table DeliverSystemMail {
  world: uint;
  system_mail_id: uint;
  sender: uint;
  users: [uint];
  title: string;
  contents: string;
  host: uint;
}

table DeleteMail {
  world: uint;
  user: uint;
  id: ushort;
}


table SetOption {
  world: uint;
  user: uint;
  type: ubyte;
  enabled: bool;
}

table CreateGroup {
  world: uint;
  host: uint;
  master: uint;
  member: string;
}

table EnterGroup {
  world: uint;
  host: uint;
  master: uint;
  member: string;
}

table BroadcastGroup {
  world: uint;
  host: uint;
  group: uint;
  message: string;
  type: ubyte;
}

table LeaveGroup {
  world: uint;
  host: uint;
  member: string;
}

table KickGroup {
  world: uint;
  host: uint;
  kicker: string;
  target: string;
}

table DestroyGroup {
  world: uint;
  host: uint;
  master: string;
}

table CreateClan {
  world: uint;
  host: uint;
  master: uint;
  name: string;
}

table DestroyClan {
  world: uint;
  host: uint;
  master: uint;
}

table JoinClan {
  world: uint;
  host: uint;
  inviter_uid: uint;
  invitee_name: string;
}

table LeaveClan {
  world: uint;
  host: uint;
  clan: uint;
  name: string;
}

table KickClan {
  world: uint;
  host: uint;
  clan: uint;
  kicker: string;
  target: string;
}

table SetClanTitle {
  world: uint;
  host: uint;
  changer: uint;
  title: string?;
}

table BroadcastClan {
  world: uint;
  host: uint;
  clan: uint;
  message: string;
  type: ubyte;
}

table ChangeClanRole {
  world: uint;
  host: uint;
  changer_uid: uint;
  target_name: string;
  clan: uint;
  new_role: uint;
}

table Broadcast {
  world: uint;
  host: uint;
  message: string;
  type: ubyte;
}

table UpdateFriends {
  world: uint;
  user: uint;
  names: [string];
}

table DeliverSystemStorage {
  world: uint;
  system_storage_box_id: uint;
  users: [uint];
  host: uint;
}

table WriteStorageBox {
  world: uint;
  user: uint;
  name: string?;
  title: string;
  message: string;
  attachments: string;
  expire_date: string?;
  external_ref: string?;
  host: uint;
}

table ClaimStorageBox {
  world: uint;
  user: uint;
  id: uint;
}

table UnclaimStorageBox {
  world: uint;
  user: uint;
  id: uint;
}

table WriteSystemStorageBox {
  world: uint;
  title: string;
  message: string;
  attachments: string;
  expire_date: string?;
  external_ref: string?;
}

table WriteSystemMail {
  world: uint;
  sender: uint;
  title: string;
  contents: string;
  expire_date: string?;
}

table Ban {
  world: uint;
  name: string;
  reason: string;
  days: uint?;
}

table Unban {
  world: uint;
  name: string;
}

table Heartbeat {
  world: uint;
  service: fb.protocol.internal.Service;
  id: ubyte;
  name: string;
  ip: string;
  port: ushort;
}

table SetExpMultiplier {
  world: uint;
  value: double;
}

table SetDropRateMultiplier {
  world: uint;
  value: double;
}

table SetDateTime {
  world: uint;
  datetime: string;
  reset: bool = false;
}