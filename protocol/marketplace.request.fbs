include "marketplace.fbs";

namespace fb.protocol.marketplace.request;

table AllocateListingId {
    character_id: uint;
}

table List {
    character_id: uint;
    listing_id: string;
    item: fb.protocol.marketplace.Item;
    price: uint;
    expire_hours: ushort;
}

table Cancel {
    character_id: uint;
    listing_id: string;
}

table Purchase {
    buyer_id: uint;
    listing_id: string;
}

table Search {
    item_name: string?;
    min_price: uint?;
    max_price: uint?;
    seller_id: uint?;
    sort_by: string?;
    page: uint;
}

table GetListings {
    listing_ids: [string];
}

