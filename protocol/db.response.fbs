include "db.fbs";

namespace fb.protocol.db.response;

table DeleteArticle {
  result: int;
}


table GetArticle {
  article: fb.protocol.db.Article;
  next: bool;
  success: bool;
}


table GetArticleList {
  summary_list: [fb.protocol.db.ArticleSummary];
}


table WriteArticle {
  success: bool;
}


table ChangePw {
  error_code: uint;
}


table GetUid {
  uid: uint;
  success: bool;
}


table InitCharacter {
  success: bool;
}


table Authenticate {
  map: uint;
  error_code: uint;
}


table Login {
  character: fb.protocol.db.Character;
  items: [fb.protocol.db.Item];
  spells: [fb.protocol.db.Spell];
  option: fb.protocol.db.Option;
  group: fb.protocol.db.Group;
}


table MakeCharacter {
  success: bool;
}


table ReserveName {
  uid: uint;
  success: bool;
}


table Save {
  success: bool;
}

table SetOption {
  success: bool;
}

table CreateGroup {
  group: fb.protocol.db.Group;
  host: ubyte;
  error: uint;
}


table EnterGroup {
  id: string;
  member: fb.protocol.db.GroupMember;
  host: ubyte;
  error: uint;
}

table LeaveGroup {
  id: string;
  member: fb.protocol.db.GroupMember;
  host: ubyte;
  error: uint;
}