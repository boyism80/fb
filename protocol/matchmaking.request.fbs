include "matchmaking.fbs";

namespace fb.protocol.matchmaking.request;

table Enqueue {
    match_type: uint;
    members: [fb.protocol.matchmaking.TicketMember];
}

table Dequeue {
    match_type: uint;
    ticket_id: ulong;
    world: uint;
    character_id: uint;
}

table Confirm {
    match_id: ulong;
    world: uint;
    character_id: uint;
}

table Decline {
    match_id: ulong;
    world: uint;
    character_id: uint;
}

table Status {
    world: uint;
    character_id: uint;
}
