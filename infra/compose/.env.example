# Client-facing IP or hostname (LAN IP for remote clients; 127.0.0.1 for same-machine only)
FB_HOST=127.0.0.1

# Build type for C++ / .NET images (Release or Debug)
BUILD_TYPE=Release

# Infrastructure
MYSQL_ROOT_PASSWORD=admin
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Application ports (host)
INTERNAL_PORT=3000
GATEWAY_PORT=3001
LOGIN_PORT=3002
GAME_PORT=3004
GAME_CROSS_PORT=3100
MARKETPLACE_PORT=3010
MATCHMAKING_PORT=3340
ADMIN_TOOL_PORT=3020

# Table publish (runtime JSON upload). Same credentials as GitHub NAS_ID / NAS_PW.
# Leave empty to disable the admin-tool "테이블" feature.
TABLE_PUBLISH_UPLOAD_BASE_URL=
TABLE_PUBLISH_DOWNLOAD_BASE_URL=
TABLE_PUBLISH_USERNAME=
TABLE_PUBLISH_PASSWORD=
SCRIPT_PUBLISH_UPLOAD_BASE_URL=
SCRIPT_PUBLISH_DOWNLOAD_BASE_URL=
SCRIPT_PUBLISH_USERNAME=
SCRIPT_PUBLISH_PASSWORD=

# Crash Discord webhook (Incoming Webhook URL). Leave empty to disable.
DISCORD_WEBHOOK_URL=
