FROM cshyeon/fb:base

COPY dependency/boost /app/dependency/boost
WORKDIR /app/dependency/boost
RUN ./bootstrap.sh --prefix=/usr/
RUN ./b2 --with-program_options
RUN ./b2 install
WORKDIR /
RUN rm -rf /app/boost

# fb.lib
WORKDIR /app
COPY include ./include
COPY lib ./lib
WORKDIR /app/lib/build
RUN cmake ..
RUN cmake --build . --config Release --parallel 4
RUN make install
WORKDIR /
RUN rm -rf /app