<Window x:Class="MapEditor.DoorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문 정의 편집기 (door.xlsx)" Width="820" Height="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <CheckBox DockPanel.Dock="Right" Content="이 맵에서 쓰는 문만" IsChecked="{Binding OnlyMapDoors}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Header}" Text="문 정의 (door)" />
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding DoorModelsView}" SelectedItem="{Binding SelectedDoorModel}" CanUserDeleteRows="False"
                  RowHeight="44" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="40" />
                <DataGridTextColumn Header="pairs (&amp; 구분)" Binding="{Binding PairsText, UpdateSourceTrigger=LostFocus}" Width="110" />
                <DataGridTemplateColumn Header="이 맵 사용" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource DoorUsage}">
                                        <Binding />
                                        <Binding Path="DataContext.Document.Doors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="닫힘" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource DoorStrip}">
                                        <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="DataContext.DoorTable" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding />
                                        <Binding Path="DataContext.DoorRevision" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="열림" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource DoorStrip}" ConverterParameter="open">
                                        <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="DataContext.DoorTable" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding />
                                        <Binding Path="DataContext.DoorRevision" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2">
            <Button Content="문 정의 추가" Command="{Binding AddDoorModelCommand}" />
            <Button Content="문 정의 삭제" Command="{Binding RemoveDoorModelCommand}" />
        </WrapPanel>

        <!-- Larger preview of the selected door model: the joined close and open shapes -->
        <Border Grid.Row="3" Background="{StaticResource InputBrush}" Margin="2" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="닫힘" Foreground="Gold" />
                    <Image Height="96" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource DoorStrip}">
                                <Binding Path="Assets" />
                                <Binding Path="DoorTable" />
                                <Binding Path="SelectedDoorModel" />
                                <Binding Path="DoorRevision" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="열림" Foreground="LimeGreen" />
                    <Image Height="96" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource DoorStrip}" ConverterParameter="open">
                                <Binding Path="Assets" />
                                <Binding Path="DoorTable" />
                                <Binding Path="SelectedDoorModel" />
                                <Binding Path="DoorRevision" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Style="{StaticResource Header}" Text="door_pair (칸별 열림/닫힘 오브젝트)" />
        <DataGrid Grid.Row="5" ItemsSource="{Binding DoorTable.Pairs}" SelectedItem="{Binding SelectedDoorPair}" CanUserDeleteRows="False" RowHeight="52">
            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="open" Binding="{Binding Open}" Width="60" />
                <DataGridTemplateColumn Header="열림" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ObjectThumbnail}">
                                        <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Open" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="close" Binding="{Binding Close}" Width="60" />
                <DataGridTemplateColumn Header="닫힘" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ObjectThumbnail}">
                                        <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Close" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="6">
            <Button Content="door_pair 추가" Command="{Binding AddDoorPairCommand}" />
            <Button Content="door_pair 삭제" Command="{Binding RemoveDoorPairCommand}" />
            <Button Content="door.xlsx 저장" Command="{Binding SaveDoorTableCommand}" />
            <TextBlock Text="● 저장 안 됨" Foreground="Orange" VerticalAlignment="Center" Margin="6 0"
                       Visibility="{Binding DoorTableDirty, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
    </Grid>
</Window>
