<Window x:Class="MapEditor.TemplateWarpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="템플릿 기준 워프 위치 분석" Width="980" Height="600" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 8"
                       Text="모든 맵에서 템플릿(건물) 위나 바로 옆(아래 2칸까지)에 있는 워프를 건물 기준 위치로 모읍니다. 같은 템플릿을 쓰는 곳 중 절반 이상이 같은 위치에 워프를 두는데 다른 위치에 둔 곳을 찾습니다. 열린 맵은 저장하지 않은 상태로 검사합니다." />
            <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                <Button x:Name="StartButton" Content="분석 시작" Click="OnStart" />
                <Button x:Name="CancelButton" Content="중지" Click="OnCancel" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="ProgressBar" Height="16" Minimum="0" Maximum="1" Margin="0 0 0 4" />
            <TextBlock x:Name="ProgressText" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 8" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0 8 0 0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="체크한 워프를 제안 위치로 이동 (열린 맵)" Command="{Binding MoveTemplateWarpsCommand}" />
                <Button Content="닫기" IsCancel="True" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SemiTextBrush}" Text="더블클릭: 그 맵을 열고 워프로 이동. 체크는 열린 맵의 항목만 가능." />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="170" Margin="0 8 0 0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding TemplatePlacesHeader}" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 4" />
            <ListBox ItemsSource="{Binding TemplatePlaces}" DisplayMemberPath="Label" VirtualizingPanel.IsVirtualizing="True"
                     PreviewMouseLeftButtonUp="OnPlaceClick" ToolTip="항목을 고르면 같은 템플릿이 쓰인 모든 곳을 보여 줌. 클릭: 그 맵을 열고 건물로 이동" />
        </DockPanel>

        <DataGrid x:Name="IssueGrid" ItemsSource="{Binding TemplateWarpIssues}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  SelectionMode="Single" MouseDoubleClick="OnDoubleClick" SelectionChanged="OnIssueSelected" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding InOpenMap}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="맵" Binding="{Binding MapLabel}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="X" Binding="{Binding X}" IsReadOnly="True" Width="40" />
                <DataGridTextColumn Header="Y" Binding="{Binding Y}" IsReadOnly="True" Width="40" />
                <DataGridTextColumn Header="종류" Binding="{Binding Kind}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="제안" Binding="{Binding SuggestLabel}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="템플릿" Binding="{Binding TemplateName}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="내용" Binding="{Binding Message}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="목적지" Binding="{Binding Dest}" IsReadOnly="True" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
