<Window x:Class="MapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="clr-namespace:MapEditor.Control"
        xmlns:converter="clr-namespace:MapEditor.Converter"
        xmlns:table="clr-namespace:MapEditor.Table"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding Document.Title, StringFormat=FB Map Editor - {0}, FallbackValue=FB Map Editor, TargetNullValue=FB Map Editor}"
        Width="1600" Height="950"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="64" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6 0 0 0" />
            <Setter Property="Foreground" Value="{StaticResource SemiTextBrush}" />
        </Style>
        <Style x:Key="NumberBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
        </Style>

        <!-- Property panel: one template per spawn type. Commands live on the window's view model. -->
        <DataTemplate DataType="{x:Type table:NpcSpawn}">
            <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="NPC 스폰" />
                <Image Stretch="None" HorizontalAlignment="Left" Margin="6 2" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </Image.LayoutTransform>
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource MonsterThumbnail}">
                            <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Info" />
                            <Binding Path="DirectionIndex" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="npc" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Npc}" />
                    <Button Content="찾기..." Command="{Binding DataContext.PickNpcCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6 0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="위치" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding X}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Y}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="방향" />
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="NpcDirection" Content="↑ TOP"
                                 IsChecked="{Binding Direction, Converter={StaticResource EnumBool}, ConverterParameter=TOP}" />
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="NpcDirection" Content="→ RIGHT"
                                 IsChecked="{Binding Direction, Converter={StaticResource EnumBool}, ConverterParameter=RIGHT}" />
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="NpcDirection" Content="↓ BOTTOM"
                                 IsChecked="{Binding Direction, Converter={StaticResource EnumBool}, ConverterParameter=BOTTOM}" />
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="NpcDirection" Content="← LEFT"
                                 IsChecked="{Binding Direction, Converter={StaticResource EnumBool}, ConverterParameter=LEFT}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type table:MobSpawn}">
            <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="몹 스폰" />
                <Image Stretch="None" HorizontalAlignment="Left" Margin="6 2" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </Image.LayoutTransform>
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource MonsterThumbnail}">
                            <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Info" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="mob" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Mob}" />
                    <Button Content="찾기..." Command="{Binding DataContext.PickMobCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6 0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="시작" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding BeginX}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding BeginY}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="끝" Width="24" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding EndX}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding EndY}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="수" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Count}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="리젠" Width="30" />
                    <TextBox Text="{Binding Rezen}" Width="80" ToolTip="TimeSpan (hh:mm:ss)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="조건" />
                    <TextBox Text="{Binding Condition}" Width="260" ToolTip="dsl" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type table:WarpEntry}">
            <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="워프" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="출발" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding X}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Y}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="목적지" />
                    <TextBox Text="{Binding Dest}" Width="260" ToolTip="dsl: map(id, x, y) 또는 world(...)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="맵 / 좌표" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding DestMap, TargetNullValue=''}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding DestX, TargetNullValue=''}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding DestY, TargetNullValue=''}" />
                    <Button Content="맵 찾기..." Command="{Binding DataContext.PickWarpMapCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="열기" Command="{Binding DataContext.OpenWarpDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="목적지 맵을 열고 목적지 칸으로 이동" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="맵 이름" />
                    <TextBlock Text="{Binding DestName}" VerticalAlignment="Center" Margin="4 0" Foreground="Cyan" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="조건" />
                    <TextBox Text="{Binding Condition}" Width="260" ToolTip="dsl" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Shortcuts are dispatched in MainWindow.xaml.cs from the user settings (설정 → 단축키) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Padding="4 2">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="선택한 맵 열기" Command="{Binding OpenMapCommand}" IsEnabled="{Binding CanOpen}" />
                <MenuItem Header="저장" InputGestureText="{Binding ShortcutMap[Save].Text}" Command="{Binding SaveCommand}" />
                <MenuItem Header="door.xlsx 저장" Command="{Binding SaveDoorTableCommand}" />
                <Separator />
                <MenuItem Header="리소스 버전">
                    <MenuItem Header="5.50" Command="{Binding VersionCommand}" CommandParameter="v550"
                              IsChecked="{Binding SelectedVersion.Version, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=v550}" />
                    <MenuItem Header="6.51" Command="{Binding VersionCommand}" CommandParameter="v651"
                              IsChecked="{Binding SelectedVersion.Version, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=v651}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="종료" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="실행 취소" InputGestureText="{Binding ShortcutMap[Undo].Text}" Command="{Binding UndoCommand}" />
                <MenuItem Header="다시 실행" InputGestureText="{Binding ShortcutMap[Redo].Text}" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="복사" InputGestureText="{Binding ShortcutMap[Copy].Text}" Command="{Binding CopyCommand}" />
                <MenuItem Header="붙여넣기" InputGestureText="{Binding ShortcutMap[Paste].Text}" Command="{Binding PasteCommand}" />
                <MenuItem Header="삭제 (선택한 스폰 + 현재 레이어)" InputGestureText="{Binding ShortcutMap[Delete].Text}" Command="{Binding DeleteSelectionCommand}" />
                <MenuItem Header="블록 토글" InputGestureText="{Binding ShortcutMap[ToggleBlock].Text}" Command="{Binding ToggleBlockSelectionCommand}" />
                <MenuItem Header="문 편집 (선택한 한 행)..." InputGestureText="{Binding ShortcutMap[EditDoor].Text}" Command="{Binding EditDoorCommand}" />
                <Separator />
                <MenuItem Header="전체 선택" InputGestureText="{Binding ShortcutMap[SelectAll].Text}" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="선택 해제" InputGestureText="{Binding ShortcutMap[ClearSelection].Text}" Command="{Binding ClearSelectionCommand}" />
                <Separator />
                <MenuItem Header="선택 이동 시 타일도 이동" IsCheckable="True" IsChecked="{Binding MoveTiles}" />
                <MenuItem Header="선택 이동 시 블록도 이동" IsCheckable="True" IsChecked="{Binding MoveBlocks}" />
            </MenuItem>
            <MenuItem Header="이동(_G)">
                <MenuItem Header="뒤로 (이전에 보던 위치)" InputGestureText="{Binding ShortcutMap[NavigateBack].Text}" Command="{Binding NavigateBackCommand}" IsEnabled="{Binding CanNavigateBack}" />
                <MenuItem Header="앞으로" InputGestureText="{Binding ShortcutMap[NavigateForward].Text}" Command="{Binding NavigateForwardCommand}" IsEnabled="{Binding CanNavigateForward}" />
                <Separator />
                <MenuItem Header="맵 검색" InputGestureText="{Binding ShortcutMap[FindMap].Text}" Click="OnFindMap" />
                <MenuItem Header="선택한 워프의 목적지 열기" InputGestureText="{Binding ShortcutMap[OpenWarpDestination].Text}" Command="{Binding OpenWarpDestinationCommand}" />
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="타일" IsCheckable="True" IsChecked="{Binding ShowTiles}" />
                <MenuItem Header="오브젝트" IsCheckable="True" IsChecked="{Binding ShowObjects}" />
                <MenuItem Header="블록 (.block)" IsCheckable="True" IsChecked="{Binding ShowBlocks}" />
                <MenuItem Header="유효 충돌 (막힌 칸 + 방향 충돌 테두리)" IsCheckable="True" IsChecked="{Binding ShowCollision}" InputGestureText="{Binding ShortcutMap[ToggleCollision].Text}" />
                <MenuItem Header="그리드" IsCheckable="True" IsChecked="{Binding ShowGrid}" InputGestureText="{Binding ShortcutMap[ToggleGrid].Text}" />
                <MenuItem Header="문" IsCheckable="True" IsChecked="{Binding ShowDoors}" />
                <MenuItem Header="NPC" IsCheckable="True" IsChecked="{Binding ShowNpcs}" />
                <MenuItem Header="NPC / 몹 그림" IsCheckable="True" IsChecked="{Binding ShowSprites}" InputGestureText="{Binding ShortcutMap[ToggleSprites].Text}" />
                <MenuItem Header="몹 스폰 영역" IsCheckable="True" IsChecked="{Binding ShowMobs}" />
                <MenuItem Header="워프" IsCheckable="True" IsChecked="{Binding ShowWarps}" />
                <MenuItem Header="5.50에 없는 타일/오브젝트를 검은색으로 (6.51 리소스일 때)" IsCheckable="True" IsChecked="{Binding ShowMissing550}" />
                <Separator />
                <MenuItem Header="미니맵" IsCheckable="True" IsChecked="{Binding ShowMinimap}" InputGestureText="{Binding ShortcutMap[ToggleMinimap].Text}" />
                <Separator />
                <MenuItem Header="확대 (Ctrl+휠)" InputGestureText="{Binding ShortcutMap[ZoomIn].Text}" Command="{Binding ZoomCommand}" CommandParameter="in" />
                <MenuItem Header="축소 (Ctrl+휠)" InputGestureText="{Binding ShortcutMap[ZoomOut].Text}" Command="{Binding ZoomCommand}" CommandParameter="out" />
                <MenuItem Header="100%" InputGestureText="{Binding ShortcutMap[ZoomReset].Text}" Command="{Binding ZoomCommand}" CommandParameter="reset" />
            </MenuItem>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="선택 / 이동" Command="{Binding ToolCommand}" CommandParameter="Select"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Select}" />
                <MenuItem Header="브러시" Command="{Binding ToolCommand}" CommandParameter="Brush"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Brush}" />
                <MenuItem Header="사각형 채우기" Command="{Binding ToolCommand}" CommandParameter="Rect"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Rect}" />
                <MenuItem Header="영역 채우기" Command="{Binding ToolCommand}" CommandParameter="Fill"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Fill}" />
                <MenuItem Header="지우개" Command="{Binding ToolCommand}" CommandParameter="Eraser"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Eraser}" />
                <MenuItem Header="스포이트" Command="{Binding ToolCommand}" CommandParameter="Eyedropper"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Eyedropper}" />
                <MenuItem Header="문 배치" Command="{Binding ToolCommand}" CommandParameter="Door"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Door}" />
                <MenuItem Header="몹 영역 그리기" Command="{Binding ToolCommand}" CommandParameter="Mob"
                          IsChecked="{Binding Tool, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Mob}" />
                <Separator />
                <MenuItem Header="편집 레이어">
                    <MenuItem Header="타일" Command="{Binding LayerCommand}" CommandParameter="Tile"
                              IsChecked="{Binding Layer, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Tile}" />
                    <MenuItem Header="오브젝트" Command="{Binding LayerCommand}" CommandParameter="Object"
                              IsChecked="{Binding Layer, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Object}" />
                    <MenuItem Header="블록" Command="{Binding LayerCommand}" CommandParameter="Block"
                              IsChecked="{Binding Layer, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Block}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="맵(_M)">
                <MenuItem Header="NPC 추가..." Command="{Binding AddSpawnCommand}" CommandParameter="npc" />
                <MenuItem Header="몹 스폰 추가 (맵 전체)..." Command="{Binding AddSpawnCommand}" CommandParameter="mob" />
                <MenuItem Header="워프 추가..." Command="{Binding AddSpawnCommand}" CommandParameter="warp" />
                <Separator />
                <MenuItem Header="문 편집 (선택한 한 행)..." InputGestureText="{Binding ShortcutMap[EditDoor].Text}" Command="{Binding EditDoorCommand}" />
                <MenuItem Header="문 정의 편집기 (door.xlsx)..." Click="OnDoorEditor" />
                <Separator />
                <MenuItem Header="문제 검사 창..." Click="OnIssues" />
                <Separator />
                <MenuItem Header="검증 실행" InputGestureText="{Binding ShortcutMap[Validate].Text}" Command="{Binding ValidateCommand}" />
                <MenuItem Header="현재 맵 워프 검사" InputGestureText="{Binding ShortcutMap[CheckWarps].Text}" Command="{Binding CheckWarpsCommand}" CommandParameter="map" />
                <MenuItem Header="전체 맵 워프 검사" InputGestureText="{Binding ShortcutMap[CheckAllWarps].Text}" Command="{Binding CheckWarpsCommand}" CommandParameter="all" />
            </MenuItem>
            <MenuItem Header="설정(_S)">
                <MenuItem Header="단축키..." InputGestureText="{Binding ShortcutMap[ShortcutEditor].Text}" Command="{Binding ShortcutEditorCommand}" />
            </MenuItem>
            <MenuItem Header="MCP">
                <MenuItem Header="{Binding McpStatus}" HeaderStringFormat="상태: {0}" IsEnabled="False" />
                <MenuItem Header="쓰기 허용" IsCheckable="True" IsChecked="{Binding McpAllowWrite}" />
                <MenuItem Header="호출 로그..." Click="OnMcp" />
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="조작 안내" Click="OnHelp" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="6 4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="리소스" VerticalAlignment="Center" Margin="2 0 6 0" Foreground="{StaticResource SemiTextBrush}" />
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Label" Width="130" Margin="0 0 10 0" />
                <Button Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Command="{Binding SaveCommand}"
                        ToolTip="{Binding ShortcutMap[Save].Text}" ToolTipService.ShowOnDisabled="True" />
                <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Command="{Binding UndoCommand}"
                        ToolTip="{Binding ShortcutMap[Undo].Text}" />
                <Button Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Command="{Binding RedoCommand}"
                        ToolTip="{Binding ShortcutMap[Redo].Text}" />
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Command="{Binding NavigateBackCommand}" IsEnabled="{Binding CanNavigateBack}"
                        ToolTip="{Binding ShortcutMap[NavigateBack].Text}" ToolTipService.ShowOnDisabled="True" />
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Command="{Binding NavigateForwardCommand}" IsEnabled="{Binding CanNavigateForward}"
                        ToolTip="{Binding ShortcutMap[NavigateForward].Text}" ToolTipService.ShowOnDisabled="True" />
                <Rectangle Width="1" Fill="{StaticResource ControlLightBrush}" Margin="8 2" />

                <RadioButton Style="{StaticResource ToolButton}" Content="선택 / 이동"
                             ToolTip="클릭: 선택, 선택한 것 끌기: 이동, 그 밖의 끌기: 영역 선택, Alt+끌기: 그 자리의 것을 바로 집어 이동 (키 큰 오브젝트는 그림으로), Ctrl+클릭: 추가/빼기, Shift·Ctrl+끌기: 영역 추가, Ctrl+Shift+끌기: 영역 제외, 더블클릭: 같은 값 전체"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Select}" />
                <ToggleButton Style="{StaticResource ToggleTool}" Content="+타일" IsChecked="{Binding MoveTiles}" ToolTip="선택을 옮길 때 타일도 함께 이동" />
                <ToggleButton Style="{StaticResource ToggleTool}" Content="+블록" IsChecked="{Binding MoveBlocks}" ToolTip="선택을 옮길 때 블록도 함께 이동" />
                <RadioButton Style="{StaticResource ToolButton}" Content="브러시"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Brush}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="사각형 채우기"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Rect}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="영역 채우기"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Fill}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="지우개"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Eraser}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="스포이트"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Eyedropper}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="문"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Door}" />
                <RadioButton Style="{StaticResource ToolButton}" Content="몹 영역" ToolTip="드래그: 선택한 몹 스폰의 영역 지정 (선택이 없으면 새 몹 스폰)"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumBool}, ConverterParameter=Mob}" />
                <Rectangle Width="1" Fill="{StaticResource ControlLightBrush}" Margin="8 2" />

                <TextBlock Text="편집 레이어" VerticalAlignment="Center" Margin="2 0 6 0" Foreground="{StaticResource SemiTextBrush}" />
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Layer" Content="타일"
                             IsChecked="{Binding Layer, Converter={StaticResource EnumBool}, ConverterParameter=Tile}" />
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Layer" Content="오브젝트"
                             IsChecked="{Binding Layer, Converter={StaticResource EnumBool}, ConverterParameter=Object}" />
                <RadioButton Style="{StaticResource ToolButton}" GroupName="Layer" Content="블록"
                             IsChecked="{Binding Layer, Converter={StaticResource EnumBool}, ConverterParameter=Block}" />
                <Rectangle Width="1" Fill="{StaticResource ControlLightBrush}" Margin="8 2" />

                <Button Content="－" Command="{Binding ZoomCommand}" CommandParameter="out" />
                <Button Content="100%" Command="{Binding ZoomCommand}" CommandParameter="reset" />
                <Button Content="＋" Command="{Binding ZoomCommand}" CommandParameter="in" />
                <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="6 0" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Left: map list + layers -->
            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Header}" Text="맵 목록" />
                <TextBox Grid.Row="1" x:Name="MapQueryBox" Text="{Binding MapQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="ID 또는 이름 검색 (Enter: 첫 맵 열기, ↓: 목록으로)"
                         PreviewKeyDown="OnMapQueryKeyDown" />
                <ListBox Grid.Row="2" x:Name="MapList" ItemsSource="{Binding MapView}" SelectedItem="{Binding SelectedMap}"
                         DisplayMemberPath="Label" VirtualizingPanel.IsVirtualizing="True" Margin="2"
                         MouseDoubleClick="OnMapDoubleClick" />
                <Button Grid.Row="3" Content="열기" Command="{Binding OpenMapCommand}" IsEnabled="{Binding CanOpen}" />
                <StackPanel Grid.Row="4" Margin="0 4 0 8">
                    <TextBlock Style="{StaticResource Header}" Text="표시" />
                    <UniformGrid Columns="2" Margin="4 0">
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="타일" IsChecked="{Binding ShowTiles}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="오브젝트" IsChecked="{Binding ShowObjects}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="블록" IsChecked="{Binding ShowBlocks}" ToolTip=".block 파일의 막힌 칸" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="유효 충돌" IsChecked="{Binding ShowCollision}"
                                      ToolTip="주황 칸: 타일 0 또는 사방이 막힌 오브젝트. 주황 선: 그 변으로 드나들 수 없음 (오브젝트 SObj 방향 충돌)" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="그리드" IsChecked="{Binding ShowGrid}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="문" IsChecked="{Binding ShowDoors}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="NPC" IsChecked="{Binding ShowNpcs}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="NPC·몹 그림" IsChecked="{Binding ShowSprites}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="몹 영역" IsChecked="{Binding ShowMobs}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="워프" IsChecked="{Binding ShowWarps}" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="5.50 없음 검게" IsChecked="{Binding ShowMissing550}"
                                      ToolTip="6.51 리소스로 볼 때 5.50 클라이언트에 없는 타일/오브젝트 id를 검은색으로 표시" />
                        <ToggleButton Style="{StaticResource ToggleTool}" Content="미니맵" IsChecked="{Binding ShowMinimap}" />
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Center: map -->
            <Grid Grid.Column="2">
                <ScrollViewer CanContentScroll="True"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <control:MapCanvas x:Name="MapView" Editor="{Binding}" />
                </ScrollViewer>

                <!-- Minimap over the bottom-right corner, clear of the scroll bars -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 24 24" Padding="4"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlLightBrush}" BorderThickness="1"
                        Visibility="{Binding MinimapVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="미니맵" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 3" />
                        <control:MiniMap Editor="{Binding}" Canvas="{Binding ElementName=MapView}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <!-- Right: properties of what is selected, then the palette and the map's spawns and doors -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlLightBrush}" BorderThickness="0 0 0 1"
                        Padding="0 0 0 4">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedEntity}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ContentControl Content="{Binding SelectedEntity}" />
                        <WrapPanel Margin="4 2">
                            <Button Content="화면 이동" Command="{Binding FocusEntityCommand}" />
                            <Button Content="삭제" Command="{Binding DeleteEntityCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Selection summary and actions; hidden when nothing is selected -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlLightBrush}" BorderThickness="0 0 0 1"
                        Padding="0 0 0 4" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="선택" />
                        <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Margin="6 0 6 2" />
                        <WrapPanel Margin="4 0">
                            <Button Content="삭제" Command="{Binding DeleteSelectionCommand}" ToolTip="{Binding ShortcutMap[Delete].Text}" />
                            <Button Content="블록 토글" Command="{Binding ToggleBlockSelectionCommand}" ToolTip="{Binding ShortcutMap[ToggleBlock].Text}" />
                            <Button Content="복사" Command="{Binding CopyCommand}" ToolTip="{Binding ShortcutMap[Copy].Text}" />
                            <Button Content="붙여넣기" Command="{Binding PasteCommand}" ToolTip="{Binding ShortcutMap[Paste].Text}" />
                            <Button Content="해제" Command="{Binding ClearSelectionCommand}" ToolTip="{Binding ShortcutMap[ClearSelection].Text}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="2">
                    <TabItem Header="팔레트">
                        <TabControl>
                            <TabItem Header="타일">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4 2">
                                        <TextBlock Text="타일 id" VerticalAlignment="Center" Margin="2 0 6 0" Foreground="{StaticResource SemiTextBrush}" />
                                        <TextBox Text="{Binding SelectedTile, UpdateSourceTrigger=LostFocus}" Width="80" ToolTip="id를 입력하고 Enter 또는 포커스 이동: 그 타일을 고르고 팔레트를 그 위치로 스크롤" KeyDown="OnIdBoxKeyDown" />
                                    </StackPanel>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <control:PaletteView Editor="{Binding}" Kind="Tile" />
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="오브젝트">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4 2">
                                        <TextBlock Text="오브젝트 id" VerticalAlignment="Center" Margin="2 0 6 0" Foreground="{StaticResource SemiTextBrush}" />
                                        <TextBox Text="{Binding SelectedObject, UpdateSourceTrigger=LostFocus}" Width="80" ToolTip="id를 입력하고 Enter 또는 포커스 이동: 그 오브젝트를 고르고 팔레트를 그 위치로 스크롤" KeyDown="OnIdBoxKeyDown" />
                                    </StackPanel>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <control:PaletteView Editor="{Binding}" Kind="Object" />
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                    <TabItem Header="맵 데이터">
                        <TabControl>
                            <TabItem Header="문">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0.6*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource Header}" Text="이 맵의 문 (더블클릭: 이동)" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Document.Doors}" SelectedItem="{Binding SelectedMapDoor}"
                                             DisplayMemberPath="Label" MouseDoubleClick="OnDoorDoubleClick" />
                                    <WrapPanel Grid.Row="2">
                                        <Button Content="열림/닫힘 전환" Command="{Binding ToggleDoorCommand}" />
                                        <Button Content="문 삭제" Command="{Binding DeleteDoorCommand}" />
                                    </WrapPanel>

                                    <DockPanel Grid.Row="3">
                                        <CheckBox DockPanel.Dock="Right" Content="이 맵에서 쓰는 문만" IsChecked="{Binding OnlyMapDoors}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Header}" Text="배치할 문 (문 도구로 클릭)" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="4" ItemsSource="{Binding DoorModelsView}" SelectedItem="{Binding SelectedDoorModel}" CanUserDeleteRows="False"
                                              IsReadOnly="True" RowHeight="40" VirtualizingPanel.IsVirtualizing="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="id" Binding="{Binding Id}" Width="40" />
                                            <DataGridTemplateColumn Header="이 맵 사용" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource DoorUsage}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Document.Doors" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="닫힘" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource DoorStrip}">
                                                                    <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding Path="DataContext.DoorTable" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding />
                                                                    <Binding Path="DataContext.DoorRevision" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="열림" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource DoorStrip}" ConverterParameter="open">
                                                                    <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding Path="DataContext.DoorTable" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding />
                                                                    <Binding Path="DataContext.DoorRevision" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Grid.Row="5">
                                        <CheckBox Content="열린 상태로 배치" IsChecked="{Binding PlaceDoorOpened}" VerticalAlignment="Center" />
                                        <Button Content="선택한 칸으로 문 편집..." Command="{Binding EditDoorCommand}"
                                                ToolTip="한 행에서 가로로 이어진 칸을 선택하고 각 칸의 열림/닫힘 짝을 고른다 (Ctrl+D)" />
                                        <Button Content="문 정의 편집기..." Click="OnDoorEditor" ToolTip="door / door_pair 표 편집, door.xlsx 저장" />
                                        <TextBlock Text="● door.xlsx 저장 안 됨" Foreground="Orange" VerticalAlignment="Center" Margin="6 0"
                                                   Visibility="{Binding DoorTableDirty, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Style="{StaticResource Header}" Text="선택한 문이 이 맵에서 쓰이는 좌표 (클릭: 이동)" />
                                        <ListBox ItemsSource="{Binding SelectedDoorUsages}" DisplayMemberPath="Label"
                                                 MaxHeight="90" Margin="2" PreviewMouseLeftButtonUp="OnDoorUsageClick" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="NPC">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom">
                                        <Button Content="추가..." Command="{Binding AddSpawnCommand}" CommandParameter="npc" />
                                        <Button Content="삭제" Command="{Binding RemoveSpawnCommand}" CommandParameter="npc" />
                                        <TextBlock Text="맵에서 끌어 이동, 우클릭으로 방향/삭제" Foreground="{StaticResource SemiTextBrush}" VerticalAlignment="Center" Margin="6 0" />
                                    </WrapPanel>
                                    <DataGrid ItemsSource="{Binding Document.Npcs}" SelectedItem="{Binding SelectedNpc}" CanUserDeleteRows="False"
                                              MouseDoubleClick="OnNpcDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="npc" Binding="{Binding Npc}" Width="50" />
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="x" Binding="{Binding X}" Width="40" />
                                            <DataGridTextColumn Header="y" Binding="{Binding Y}" Width="40" />
                                            <DataGridComboBoxColumn Header="방향" SelectedItemBinding="{Binding Direction}" Width="80">
                                                <DataGridComboBoxColumn.ItemsSource>
                                                    <x:Array Type="{x:Type sys:String}">
                                                        <sys:String>TOP</sys:String>
                                                        <sys:String>RIGHT</sys:String>
                                                        <sys:String>BOTTOM</sys:String>
                                                        <sys:String>LEFT</sys:String>
                                                    </x:Array>
                                                </DataGridComboBoxColumn.ItemsSource>
                                            </DataGridComboBoxColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="몹">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom">
                                        <Button Content="추가..." Command="{Binding AddSpawnCommand}" CommandParameter="mob" />
                                        <Button Content="삭제" Command="{Binding RemoveSpawnCommand}" CommandParameter="mob" />
                                        <TextBlock Text="맵에서 우클릭 드래그로 영역 지정 추가" Foreground="{StaticResource SemiTextBrush}" VerticalAlignment="Center" Margin="6 0" />
                                    </WrapPanel>
                                    <DataGrid ItemsSource="{Binding Document.Mobs}" SelectedItem="{Binding SelectedMob}" CanUserDeleteRows="False"
                                              MouseDoubleClick="OnMobDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="mob" Binding="{Binding Mob}" Width="50" />
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="x0" Binding="{Binding BeginX}" Width="34" />
                                            <DataGridTextColumn Header="y0" Binding="{Binding BeginY}" Width="34" />
                                            <DataGridTextColumn Header="x1" Binding="{Binding EndX}" Width="34" />
                                            <DataGridTextColumn Header="y1" Binding="{Binding EndY}" Width="34" />
                                            <DataGridTextColumn Header="수" Binding="{Binding Count}" Width="34" />
                                            <DataGridTextColumn Header="리젠" Binding="{Binding Rezen}" Width="64" />
                                            <DataGridTextColumn Header="조건" Binding="{Binding Condition}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="워프">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Bottom">
                                        <Button Content="추가..." Command="{Binding AddSpawnCommand}" CommandParameter="warp" />
                                        <Button Content="삭제" Command="{Binding RemoveSpawnCommand}" CommandParameter="warp" />
                                        <TextBlock Text="맵에서 끌어 이동, 우클릭으로 추가/목적지 열기" Foreground="{StaticResource SemiTextBrush}" VerticalAlignment="Center" Margin="6 0" />
                                    </WrapPanel>
                                    <DataGrid ItemsSource="{Binding Document.Warps}" SelectedItem="{Binding SelectedWarp}" CanUserDeleteRows="False"
                                              MouseDoubleClick="OnWarpDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="x" Binding="{Binding X}" Width="40" />
                                            <DataGridTextColumn Header="y" Binding="{Binding Y}" Width="40" />
                                            <DataGridTextColumn Header="목적지 (dsl)" Binding="{Binding Dest}" Width="*" />
                                            <DataGridTextColumn Header="목적지 맵 이름" Binding="{Binding DestName}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="조건" Binding="{Binding Condition}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="8 3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding HoverText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource SemiTextBrush}" Margin="12 0" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                <TextBlock Grid.Column="2" Text="{Binding McpStatus, StringFormat=MCP {0}}" Foreground="{StaticResource SemiTextBrush}" />
            </Grid>
        </Border>

        <!-- Loading popup: covers the window so nothing is edited while data is being read -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#99000000"
              Visibility="{Binding LoadingVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ControlLightBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16 12" MinWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding LoadingTitle}" FontWeight="Bold" FontSize="14" Margin="0 0 0 8" />
                    <ProgressBar Height="6" Minimum="0" Maximum="{Binding LoadingTotal}" Value="{Binding LoadingDone, Mode=OneWay}"
                                 Foreground="{StaticResource HighlightBrush}" Background="{StaticResource InputBrush}" BorderThickness="0" />
                    <ItemsControl ItemsSource="{Binding LoadingSteps}" Margin="0 8 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" Margin="16 0 0 0" Foreground="{StaticResource SemiTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
