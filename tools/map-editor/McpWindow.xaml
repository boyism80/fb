<Window x:Class="MapEditor.McpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP" Width="560" Height="460" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Header}" Text="상태" />
            <TextBox Text="{Binding McpStatus, Mode=OneWay}" IsReadOnly="True" />
            <CheckBox Content="MCP 쓰기 허용 (set_cells, fill_rect, door, undo, save)" IsChecked="{Binding McpAllowWrite}" />
            <TextBlock Style="{StaticResource Header}" Text="호출 로그" />
        </StackPanel>
        <ListBox ItemsSource="{Binding McpLog}" />
    </DockPanel>
</Window>
