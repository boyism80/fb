<Application x:Class="MapEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:MapEditor.Converter"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:EnumBoolConverter x:Key="EnumBool" />
            <converter:MoveOptionConverter x:Key="MoveOption" />
            <converter:MoveOptionBrushConverter x:Key="MoveOptionBrush" />
            <converter:ObjectThumbnailConverter x:Key="ObjectThumbnail" />
            <converter:MonsterThumbnailConverter x:Key="MonsterThumbnail" />
            <converter:DoorStripConverter x:Key="DoorStrip" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converter:DoorUsageConverter x:Key="DoorUsage" />
            <converter:TemplateThumbnailConverter x:Key="TemplateThumbnail" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
