<Window x:Class="MapEditor.CopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="복사할 것 선택" SizeToContent="WidthAndHeight" MinWidth="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <StackPanel Margin="10">
        <TextBlock Text="선택 영역에 여러 종류가 있습니다. 복사할 것을 고르세요." Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 6" />
        <ItemsControl x:Name="Options">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}" Margin="2 3" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
            <Button Content="모두 복사" IsDefault="True" Click="OnAll" />
            <Button Content="체크한 것만 복사" Click="OnChecked" />
            <Button Content="취소" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
