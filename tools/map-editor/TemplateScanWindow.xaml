<Window x:Class="MapEditor.TemplateScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="템플릿 자동 스캔" Width="760" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MainTextBrush}"
        FontFamily="Malgun Gothic" FontSize="12">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 8"
                       Text="모든 맵에서 서로 붙어 있는 오브젝트 묶음(건물 등)을 찾아, 같은 모양이 여러 번 나오면 템플릿 후보로 보여줍니다. 이미 등록된 템플릿과 같은 모양은 건너뜁니다. 열린 맵은 저장하지 않은 상태로 검사합니다." />
            <WrapPanel Margin="0 0 0 6">
                <TextBlock Text="오브젝트 칸 수" VerticalAlignment="Center" Margin="0 0 6 0" />
                <TextBox x:Name="MinCellsBox" Width="50" Text="10" />
                <TextBlock Text=" ~ " VerticalAlignment="Center" />
                <TextBox x:Name="MaxCellsBox" Width="50" Text="300" />
                <TextBlock Text="최소 등장 횟수" VerticalAlignment="Center" Margin="16 0 6 0" />
                <TextBox x:Name="MinCountBox" Width="50" Text="3" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                <Button x:Name="StartButton" Content="스캔 시작" Click="OnStart" />
                <Button x:Name="CancelButton" Content="중지" Click="OnCancel" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="ProgressBar" Height="16" Minimum="0" Maximum="1" Margin="0 0 0 4" />
            <TextBlock x:Name="ProgressText" Foreground="{StaticResource SemiTextBrush}" Margin="0 0 0 8" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0 8 0 0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RegisterButton" Content="체크한 후보 등록" Click="OnRegister" IsEnabled="False" />
                <Button Content="닫기" IsCancel="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="모두 체크" Click="OnCheckAll" />
                <Button Content="모두 해제" Click="OnUncheckAll" />
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="Results" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Checked}" VerticalAlignment="Center" Margin="0 0 8 0" />
                        <Border DockPanel.Dock="Left" Width="96" Height="72" Background="{StaticResource InputBrush}" Margin="0 0 8 0">
                            <Image Stretch="Uniform" StretchDirection="DownOnly">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource TemplateThumbnail}">
                                        <Binding Path="DataContext.Assets" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Template" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBox Text="{Binding Template.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Template.SizeLabel}" Foreground="{StaticResource SemiTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
