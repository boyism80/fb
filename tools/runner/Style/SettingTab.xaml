<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behavior="clr-namespace:Runner.Behavior">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Color.xaml" />
        <ResourceDictionary Source="Font.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SettingLabel"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{StaticResource SemiTextBrush}" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeRegular}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,6" />
    </Style>

    <Style x:Key="SettingGroupHeader"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{StaticResource SemiTextBrush}" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Margin"
                Value="8,14,8,4" />
    </Style>

    <Style x:Key="SettingPanel"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="{StaticResource PanelBackgroundLightBrush}" />
        <Setter Property="BorderBrush"
                Value="#303947" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="16" />
        <Setter Property="Margin"
                Value="0,0,0,12" />
    </Style>

    <Style x:Key="SettingSubPanel"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="#252526" />
        <Setter Property="BorderBrush"
                Value="#303947" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="10" />
    </Style>

    <Style x:Key="SettingPanelTitle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{StaticResource MainTextBrush}" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeRegular}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="SettingSubPanelTitle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SettingPanelTitle}">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight"
                Value="Normal" />
    </Style>

    <Style x:Key="SettingFieldCaption"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="{StaticResource SemiTextBrush}" />
        <Setter Property="FontSize"
                Value="10" />
        <Setter Property="Margin"
                Value="0,2,0,0" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="SettingNavListBox"
           TargetType="{x:Type ListBox}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <Style x:Key="SettingNavListBoxItem"
           TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="Foreground"
                Value="{StaticResource MainTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource PanelBackgroundLightBrush}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource HighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource ControlLightBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingAddButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding"
                Value="10,4" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="#42454e" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeSmall}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#323235" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingDataGridRow"
           TargetType="{x:Type DataGridRow}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource MainTextBrush}" />
        <Setter Property="MinHeight"
                Value="28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#323235" />
            </Trigger>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="#094771" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingDataGridColumnHeader"
           TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background"
                Value="#2d2d30" />
        <Setter Property="Foreground"
                Value="{StaticResource SemiTextBrush}" />
        <Setter Property="BorderBrush"
                Value="#303947" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="8,6" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeSmall}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
    </Style>

    <Style x:Key="SettingDataGridCell"
           TargetType="{x:Type DataGridCell}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="4,2" />
        <Setter Property="Foreground"
                Value="{StaticResource MainTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Foreground"
                        Value="{StaticResource MainTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingDataGrid"
           TargetType="{x:Type DataGrid}">
        <Setter Property="Foreground"
                Value="{StaticResource MainTextBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="SelectionMode"
                Value="Extended" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="RowHeaderWidth"
                Value="0" />
        <Setter Property="AutoGenerateColumns"
                Value="False" />
        <Setter Property="GridLinesVisibility"
                Value="None" />
        <Setter Property="HeadersVisibility"
                Value="Column" />
        <Setter Property="RowStyle"
                Value="{StaticResource SettingDataGridRow}" />
        <Setter Property="ColumnHeaderStyle"
                Value="{StaticResource SettingDataGridColumnHeader}" />
        <Setter Property="CellStyle"
                Value="{StaticResource SettingDataGridCell}" />
        <Setter Property="behavior:DataGridScrollBehavior.IsEnabled"
                Value="True" />
    </Style>
</ResourceDictionary>
