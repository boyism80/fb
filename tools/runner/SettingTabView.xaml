<UserControl x:Class="Runner.SettingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:Runner.Converter"
             xmlns:vm="clr-namespace:Runner.ViewModel">
    <UserControl.Resources>
        <converter:SettingSectionVisibilityConverter x:Key="SettingSectionVisibility" />
    </UserControl.Resources>

    <Grid Margin="0,10,0,0"
          IsEnabled="{Binding IsEnableSettingTab}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 Style="{StaticResource SettingNavListBox}"
                 ItemContainerStyle="{StaticResource SettingNavListBoxItem}"
                 ItemsSource="{Binding SettingNavView}"
                 SelectedValuePath="Section"
                 SelectedValue="{Binding SelectedSettingSection}">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource SettingGroupHeader}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SettingNavItem}">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource FontSizeRegular}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1"
                Width="1"
                Margin="0,0,12,0"
                Background="#303947" />

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,20">
            <Grid MaxWidth="960">
                <!-- Directory -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Directory}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Directory"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="0"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding ExternalIP}"
                                         Tag="127.0.0.1"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="위치"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="1"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding WorkingDirectory}"
                                         Tag="Enter your 'fb' path"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <Button Content="찾기"
                                        Style="{StaticResource SettingAddButton}"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="8,4,0,4"
                                        VerticalAlignment="Center"
                                        Command="{Binding FindWorkingDirectory}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Infrastructure -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Infrastructure}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="MySQL"
                                           Style="{StaticResource SettingPanelTitle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="추가"
                                            Style="{StaticResource SettingAddButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding NewMySQL}" />
                                    <Button Content="제거"
                                            Style="{StaticResource SettingAddButton}"
                                            Command="{Binding DeleteMySQL}"
                                            CommandParameter="{Binding SelectedItem, ElementName=MySqlGrid}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="MySqlGrid"
                                      Style="{StaticResource SettingDataGrid}"
                                      ItemsSource="{Binding MySQL}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="제거"
                                                  Command="{Binding DeleteMySQL}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="NAME">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox IsReadOnly="True"
                                                         Text="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="IP">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding IP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="127.0.0.1" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PORT">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="3306"
                                                         Width="72" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ID">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="fb" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PWD">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PW, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="admin" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Redis"
                                           Style="{StaticResource SettingPanelTitle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="추가"
                                            Style="{StaticResource SettingAddButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding NewRedis}" />
                                    <Button Content="제거"
                                            Style="{StaticResource SettingAddButton}"
                                            Command="{Binding DeleteRedis}"
                                            CommandParameter="{Binding SelectedItem, ElementName=RedisGrid}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="RedisGrid"
                                      Style="{StaticResource SettingDataGrid}"
                                      ItemsSource="{Binding Redis}"
                                      IsReadOnly="True">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="제거"
                                                  Command="{Binding DeleteRedis}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="IP">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding IP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="127.0.0.1" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PORT">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Tag="6379"
                                                         Width="72" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="RabbitMQ"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="0"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding RabbitMq.IP}"
                                         Tag="127.0.0.1"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="포트"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="1"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding RabbitMq.Port}"
                                         Tag="5672"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="ID"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="2"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding RabbitMq.ID}"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="암호"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="3"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding RabbitMq.PW}"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Gateway -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Gateway}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Gateway"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="포트"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="0"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding Gateway.Port}"
                                         Tag="3001"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="클라이언트 버전"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="1"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding Gateway.ClientVersion}"
                                         Tag="550"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4" />
                                <TextBlock Text="클라이언트 국가"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="2"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding Gateway.ClientNation}"
                                         Tag="215"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Login -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Login}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Login Servers"
                                           Style="{StaticResource SettingPanelTitle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="추가"
                                            Style="{StaticResource SettingAddButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding NewLogin}" />
                                    <Button Content="제거"
                                            Style="{StaticResource SettingAddButton}"
                                            Command="{Binding DeleteLogin}"
                                            CommandParameter="{Binding SelectedItem, ElementName=LoginServersGrid}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="LoginServersGrid"
                                      Style="{StaticResource SettingDataGrid}"
                                      ItemsSource="{Binding Login}"
                                      IsReadOnly="True">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="제거"
                                                  Command="{Binding DeleteLogin}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name"
                                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PORT"
                                                            Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Width="72" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Desc"
                                                            Width="3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Character Defaults"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="이용약관"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Margin="0,10,0,0" />
                                <TextBox Text="{Binding Agreement}"
                                         Tag="Enter your agreement message."
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,6" />

                                <TextBlock Text="시작맵"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="1"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding InitMap}"
                                         Tag="Enter initial map id"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,6" />

                                <TextBlock Text="시작위치"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Margin="0,10,0,0" />
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource SettingSubPanel}"
                                        Margin="0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="좌표 목록"
                                                       Style="{StaticResource SettingSubPanelTitle}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Content="추가"
                                                        Style="{StaticResource SettingAddButton}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding NewInitPoint}" />
                                                <Button Content="제거"
                                                        Style="{StaticResource SettingAddButton}"
                                                        Command="{Binding DeleteInitPoint}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=InitPointsGrid}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataGrid x:Name="InitPointsGrid"
                                                  Style="{StaticResource SettingDataGrid}"
                                                  ItemsSource="{Binding InitPoints}"
                                                  IsReadOnly="True"
                                                  MaxHeight="108"
                                                  Width="176"
                                                  HorizontalAlignment="Left">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="제거"
                                                              Command="{Binding DeleteInitPoint}"
                                                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="X"
                                                                        Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                     Width="64"
                                                                     HorizontalAlignment="Left" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Y"
                                                                        Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                     Width="64"
                                                                     HorizontalAlignment="Left" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="체력"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="3"
                                           Grid.Column="0" />
                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,6">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBox Text="{Binding BaseHP}"
                                                 Width="72"
                                                 HorizontalAlignment="Left" />
                                        <TextBlock Text="기본"
                                                   Style="{StaticResource SettingFieldCaption}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBox Text="{Binding AdditionalHP}"
                                                 Width="72"
                                                 HorizontalAlignment="Left" />
                                        <TextBlock Text="추가"
                                                   Style="{StaticResource SettingFieldCaption}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="마력"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="4"
                                           Grid.Column="0" />
                                <StackPanel Grid.Row="4"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,6">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBox Text="{Binding BaseMP}"
                                                 Width="72"
                                                 HorizontalAlignment="Left" />
                                        <TextBlock Text="기본"
                                                   Style="{StaticResource SettingFieldCaption}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBox Text="{Binding AdditionalMP}"
                                                 Width="72"
                                                 HorizontalAlignment="Left" />
                                        <TextBlock Text="추가"
                                                   Style="{StaticResource SettingFieldCaption}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="영문 아이디"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="5"
                                           Grid.Column="0" />
                                <CheckBox Content="허용"
                                          Grid.Row="5"
                                          Grid.Column="1"
                                          Foreground="{StaticResource MainTextBrush}"
                                          Margin="0,8"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AllowForeignName}" />

                                <TextBlock Text="관리자 권한"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="6"
                                           Grid.Column="0" />
                                <CheckBox Content="활성화"
                                          Grid.Row="6"
                                          Grid.Column="1"
                                          Foreground="{StaticResource MainTextBrush}"
                                          Margin="0,8"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding AdminMode}" />

                                <TextBlock Text="이름 길이"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="7"
                                           Grid.Column="0" />
                                <StackPanel Grid.Row="7"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,6">
                                    <TextBox Text="{Binding MinIdLength}"
                                             Width="72" />
                                    <TextBlock Text="—"
                                               Foreground="{StaticResource SemiTextBrush}"
                                               Margin="8,0"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding MaxIdLength}"
                                             Width="72" />
                                </StackPanel>

                                <TextBlock Text="암호 길이"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Row="8"
                                           Grid.Column="0" />
                                <StackPanel Grid.Row="8"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,6">
                                    <TextBox Text="{Binding MinPwLength}"
                                             Width="72" />
                                    <TextBlock Text="—"
                                               Foreground="{StaticResource SemiTextBrush}"
                                               Margin="8,0"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding MaxPwLength}"
                                             Width="72" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Game -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Game}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Game"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="서버 저장 주기"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding SaveInterval, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Tag="600"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Game Servers"
                                           Style="{StaticResource SettingPanelTitle}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="추가"
                                            Style="{StaticResource SettingAddButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding NewGame}" />
                                    <Button Content="제거"
                                            Style="{StaticResource SettingAddButton}"
                                            Command="{Binding DeleteGame}"
                                            CommandParameter="{Binding SelectedItem, ElementName=GameServersGrid}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="GameServersGrid"
                                      Style="{StaticResource SettingDataGrid}"
                                      ItemsSource="{Binding Game}"
                                      IsReadOnly="True">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="제거"
                                                  Command="{Binding DeleteGame}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="ID">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Width="72" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PORT">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Width="72" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Internal -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Internal}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Internal"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="포트"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding InternalPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Tag="3000"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Marketplace -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=Marketplace}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Marketplace"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="포트"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding MarketplacePort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Tag="3010"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Admin Tool -->
                <StackPanel Visibility="{Binding SelectedSettingSection, Converter={StaticResource SettingSectionVisibility}, ConverterParameter=AdminTool}">
                    <Border Style="{StaticResource SettingPanel}">
                        <StackPanel>
                            <TextBlock Text="Admin Tool"
                                       Style="{StaticResource SettingPanelTitle}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="포트"
                                           Style="{StaticResource SettingLabel}"
                                           Grid.Column="0" />
                                <TextBox Text="{Binding AdminToolPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Tag="30210"
                                         Width="72"
                                         HorizontalAlignment="Left"
                                         Grid.Column="1"
                                         Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
